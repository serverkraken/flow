# Dev config for flow-server. Source before running the server:
#   set -a; . deploy/dev/flow.env; set +a; ./bin/flow-server
# Pairs with deploy/dev/compose.yml + dex.yaml. NOT for production.
DATABASE_URL=postgres://flow:flow@localhost:5432/flow?sslmode=disable
FLOW_OIDC_ISSUER=http://localhost:5556/dex
FLOW_OIDC_CLIENT_ID=flow-dev
FLOW_OIDC_CLIENT_SECRET=flow-dev-secret
FLOW_PUBLIC_BASE_URL=http://localhost:8080
FLOW_SESSION_SECRET=dev-session-secret-0123456789abcd
# Dex (unlike Authentik) emits no `preferred_username`, so flow's Username is
# empty and the allowlist must match the `sub`. This value is the deterministic
# Dex sub for the static user (base64 of userID `msoent-dev` + connector `local`);
# it only changes if you edit `userID` in dex.yaml. Re-check with `make dev-token`.
FLOW_ALLOWED_SUBS=Cgptc29lbnQtZGV2EgVsb2NhbA
FLOW_LISTEN_ADDR=:8080
# FLOW_DEV=1 makes session cookies non-Secure so login works over http://localhost.
FLOW_DEV=1
