package webui

import (
	"strconv"

	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

// HeutePage is the full Zeit page on the AppShell.
templ HeutePage(vm HeuteVM) {
	@components.Base("heute", heuteBody(vm))
}

// heuteBody mounts the Zeit-Hub with NO sub-tab-strip (subnav = nil) — L4
// Task 3 retires the Heute/Woche/Historie pill strip from this surface.
templ heuteBody(vm HeuteVM) {
	@components.AppShell("zeit", nil, nil, heuteOuter(vm))
}

// heuteOuter is the SSE-swap container: it reloads the inner HeuteFragment on
// every event that can change a Zeit row (session/dayoff/settings — Gemini-
// Fund #4: node.created replaces the dead project.created so a Quick-Create
// node from the Nachbuchen picker live-updates the picker's option list).
templ heuteOuter(vm HeuteVM) {
	<div id="content"
		hx-get="/ui/worktime"
		hx-trigger="sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted, sse:node.created, sse:dayoff.changed, sse:settings.changed"
		hx-swap="innerHTML">
		@HeuteFragment(vm)
	</div>
}

// HeuteFragment is the inner content re-rendered live and after every
// mutation: the Lesesaal Tages-Ledger (Mockup Z.845–892) — pagehead,
// "Heute" ledger, vertical "Diese Woche" Wochenskala, and the "Werkzeuge"
// menu. No Saldo-Kacheln, no Burndown-Banner, no sub-tab-strip.
templ HeuteFragment(vm HeuteVM) {
	if vm.Err != "" {
		<p class="alert-err" role="alert">{ vm.Err }</p>
	}
	<div class="narrow">
		<div class="pagehead">
			<span class="eyebrow">{ components.T(ctx, "zeit.eyebrow") }</span>
			<h1>{ vm.DateTitle }</h1>
			<p class="sub">{ vm.AllTimeSub }</p>
		</div>
		@heuteTodaySection(vm)
		@heuteWeekSection(vm)
		@heuteToolsSection(vm)
	</div>
}

// heuteTodaySection is "Heute" (Mockup Z.856–867): the day's ledger rows plus
// the Nachbuchen affordance, which opens the shared add SessionDialog (no
// server round-trip, data-dialog-open — Bestand).
templ heuteTodaySection(vm HeuteVM) {
	<div class="sect">
		<div class="sect-h">
			<span class="eyebrow">{ components.T(ctx, "zeit.today") }</span>
			<button type="button" class="more" data-dialog-open="nachbuchen-dialog">
				{ components.T(ctx, "zeit.nachbuchen") } ›
			</button>
		</div>
		if len(vm.Ledger) == 0 && vm.Running == nil {
			<p class="text-sm text-faint">{ components.T(ctx, "zeit.emptyToday") }</p>
		} else {
			for _, lr := range vm.Ledger {
				@heuteLedgerRow(vm.DayParam, lr)
			}
		}
	</div>
	@components.SessionDialog(components.SessionDialogVM{
		DialogID: "nachbuchen-dialog", Mode: "add",
		Action: "/ui/worktime/add", Target: "#content",
		Date: vm.DayParam, Nodes: heutePickerNodes(vm.Nodes),
	})
}

// heuteLedgerRow is one Lesesaal ledger .row (Mockup Z.858–866): the Von–Bis
// mono .led-when, the node/title + the session's free-text Note (falling
// back to its tags when there is no note — Review Fix 2), and the duration
// in the Mockup's "6:10" clock format (DurationShort, Review Fix 1 — NOT
// SessionRowVM.Duration's "6h 10m", which stays untouched for Woche/
// Historie). A running session shows the LIVE chip + a ticking clock instead
// of a static duration — it is ANZEIGE-ONLY (no stop control here, Spec §10
// / l4-global-constraints.md — stop lives on the Topbar-Pill / Cockpit-instr-
// Band). Edit/delete for a completed session live as small controls under
// the duration (.right .k), mirroring cockpitBuchungActions' established
// convention rather than wrapping the whole row in a <button> (which would
// nest interactive elements once delete sits beside it).
templ heuteLedgerRow(dayParam string, lr HeuteLedgerRow) {
	<div class="row">
		<span class="led-when">
			if lr.Row.Running {
				{ zeitRunningStartLabel(lr.Row.TimeRange) + " – " + components.T(ctx, "heute.running") }
			} else {
				{ lr.Row.TimeRange }
			}
		</span>
		<div class="grow">
			<div class="t">{ lr.Row.Title }</div>
			if lr.Note != "" {
				<div class="s">{ lr.Note }</div>
			} else if sub := zeitLedgerSub(lr.Row.Tags); sub != "" {
				<div class="s">{ sub }</div>
			}
		</div>
		if lr.Row.Running {
			<span class="livechip">{ components.T(ctx, "cockpit.pulse.live") }</span>
		}
		<div class="right">
			if lr.Row.Running {
				<div class="v" data-timer data-timer-fmt="clock" data-base={ strconv.FormatInt(lr.BaseSeconds, 10) } role="timer">{ fmtClockHMS(lr.BaseSeconds) }</div>
			} else {
				<div class="v">{ lr.DurationShort }</div>
				<div class="k">
					<button type="button" class="targetlink" data-dialog-open={ lr.Edit.DialogID }>{ components.T(ctx, "common.edit") }</button>
					<button type="button" aria-label={ components.T(ctx, "common.delete") }
						data-dialog-open={ "delete-" + lr.Row.ID }
						class="ml-1 text-faint hover:text-red">✗</button>
				</div>
			}
		</div>
	</div>
	if !lr.Row.Running {
		@components.SessionDialog(lr.Edit)
		@components.ConfirmDialog(components.ConfirmSpec{
			ID: "delete-" + lr.Row.ID,
			ConfirmAttrs: templ.Attributes{
				"hx-post":   "/ui/worktime/delete",
				"hx-target": "#content",
				"hx-swap":   "innerHTML",
				"hx-vals":   heuteDeleteVals(dayParam, lr.Row.ID),
				"type":      "button",
			},
		})
	}
}

// heuteWeekSection is "Diese Woche" (Mockup Z.869–880): the vertical 7-day
// Wochenskala, replacing the old Mo–Fr pace strip. The .sect-h .note carries
// the Soll/bisher/Kurs line (Mockup Z.870); the .weekbar role="img"
// aria-label is the A11y-mandatory summary (Spec §13 — not optional).
templ heuteWeekSection(vm HeuteVM) {
	<div class="sect">
		<div class="sect-h">
			<span class="eyebrow">{ components.T(ctx, "zeit.thisWeek") }</span>
			<span class="note">{ vm.WeekGoalLine }</span>
		</div>
		<div class="weekbar" role="img" aria-label={ components.T(ctx, "zeit.weekAria") }>
			for _, d := range vm.WeekDays {
				<div class={ "day", templ.KV("has", d.Has), templ.KV("today", d.Today) }>
					<div class="bar"><i style={ zeitDayBarStyle(d) }></i></div>
					<div class="d">{ d.Label }</div>
					<div class="v">{ d.ValueStr }</div>
				</div>
			}
		</div>
	</div>
}

// heuteToolsSection is "Werkzeuge" (Mockup Z.882–888, extended 3→4 rows with
// Historie — Offene Entsch. #6): plain Lesesaal .row links, no destination
// logic lives here (the routes themselves get their own L4 rebuild tasks).
templ heuteToolsSection(vm HeuteVM) {
	<div class="sect">
		<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "zeit.tools") }</span></div>
		for _, tool := range vm.Tools {
			<a class="row" href={ templ.SafeURL(tool.Href) }>
				<div class="grow">
					<div class="t">{ components.T(ctx, tool.TitleKey) }</div>
					<div class="s">{ components.T(ctx, tool.DescKey) }</div>
				</div>
				<div class="right"><div class="v">›</div></div>
			</a>
		}
	</div>
}
