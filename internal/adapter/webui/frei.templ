package webui

import "github.com/serverkraken/flow/internal/adapter/webui/components"

// FreiPage is the full Frei page on the Lesesaal AppShell. Frei is a
// standalone Avatar-Menu utility — it has no worktime sub-tab strip; the
// "‹ Zeit" spine back-link (FreiFragment) provides the wayfinding instead.
templ FreiPage(vm FreiVM) {
	@components.Base("frei", freiBody(vm))
}

templ freiBody(vm FreiVM) {
	@components.AppShellFlush("frei", "live", freiOuter(vm))
}

// freiOuter is the SSE-swap container: it reloads FreiFragment on any day-off
// or settings mutation (Bundesland changes recompute holidays).
templ freiOuter(vm FreiVM) {
	<div id="content"
		class="flex flex-1 flex-col"
		hx-get="/ui/dayoffs"
		hx-trigger="sse:dayoff.changed, sse:settings.changed"
		hx-swap="innerHTML">
		@FreiFragment(vm)
	</div>
}

// FreiFragment is the Lesesaal Frei page (Werkzeuge-Destination, L4 Task 6):
// the "‹ Zeit" spine, the pagehead, the add-panel, the year list of .row
// entries, and the settings panel (Bundesland + ICS feed). No glass/Card/
// shadow-soft/font-display chrome — Kristall is fully retired from this page.
templ FreiFragment(vm FreiVM) {
	// Dreispalter: die Abwesenheiten des Jahres stehen im Kasten — eine
	// Liste, aus der man wählt (Katalog 3.13). Eintragen und Einstellungen
	// bleiben im Lesesaal.
	<div class="k3-cols grid flex-1 lg:grid-cols-[372px_minmax(0,1fr)]">
		<div class="k3-panel flex flex-col border-b border-hairp bg-panel lg:border-b-0 lg:border-r">
			<div class="px-6 pb-2.5 pt-6">
				<span class="eyebrow">{ components.T(ctx, "frei.eyebrow") }</span>
			</div>
			@freiListSection(vm)
		</div>
		<div class="min-w-0 bg-canvas px-6 py-7 lg:px-14">
			@components.PanelToggle("frei.eyebrow", "mb-4")
			<div class="spine">
				<div class="up">
					<a href="/zeit">{ components.T(ctx, "zeit.back") }</a>
				</div>
			</div>
			<div class="pagehead">
				<span class="eyebrow">{ components.T(ctx, "frei.eyebrow") }</span>
				<h1>{ components.T(ctx, "frei.title") }</h1>
			</div>
			if vm.Err != "" {
				<p class="alert-err" role="alert">{ vm.Err }</p>
			}
			@freiAddSection(vm)
			@freiSettingsSection(vm)
		</div>
	</div>
}

// freiAddSection captures a new day-off (von–bis, kind, optional label,
// skip-weekends) in a plain .panel form row — replaces the retired
// freiAddCard glass article. The Von/Bis pair stacks to one column below sm
// (375px mobile requirement), matching nodes.templ's established form grid.
templ freiAddSection(vm FreiVM) {
	<div class="sect">
		<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "frei.addTitle") }</span></div>
		<section class="panel p-5">
			<form hx-post="/ui/dayoffs/add" hx-target="#content" hx-swap="innerHTML" class="space-y-4">
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					<label class="block">
						<span class="eyebrow">{ components.T(ctx, "frei.from") }</span>
						<input type="date" name="from" required class="field mt-1"/>
					</label>
					<label class="block">
						<span class="eyebrow">{ components.T(ctx, "frei.to") }</span>
						<input type="date" name="to" required class="field mt-1"/>
					</label>
				</div>
				<label class="block">
					<span class="eyebrow">{ components.T(ctx, "frei.kind") }</span>
					<select name="kind" class="field mt-1">
						for _, k := range freiKinds() {
							<option value={ string(k.Value) }>{ k.Label }</option>
						}
					</select>
				</label>
				<label class="block">
					<span class="eyebrow">{ components.T(ctx, "frei.label") }</span>
					<input name="label" class="field mt-1"/>
				</label>
				<label class="flex items-center gap-2 text-[.86rem] text-body">
					<input type="checkbox" name="skipWeekends" value="true" checked/> { components.T(ctx, "frei.skipWeekends") }
				</label>
				<div class="flex justify-end">
					<button type="submit" class="btn btn-pri">
						<span aria-hidden="true">✚</span> { components.T(ctx, "frei.addButton") }
					</button>
				</div>
			</form>
		</section>
	</div>
}

// freiListSection lists own day-offs + computed holidays for the year as
// hairline .rows, replacing the retired freiListCard glass article.
templ freiListSection(vm FreiVM) {
	<div class="sect">
		<div class="sect-h justify-between">
			<span class="eyebrow">{ vm.BundeslandName } · { vm.Year }</span>
			<span class="text-[.8rem] text-muted">{ components.Tn(ctx, "list.entries", len(vm.Rows)) }</span>
		</div>
		if !vm.HasOwn {
			<p class="text-sm text-faint mt-4">{ components.T(ctx, "frei.empty") }</p>
		}
		if len(vm.Rows) > 0 {
			<ul>
				for _, row := range vm.Rows {
					@freiRow(row)
				}
			</ul>
		}
	</div>
}

// freiRow is one Lesesaal .row: Datum (.led-when) · Kind-.typechip/.tc-*-Ton
// (.t) · optionales Label (.s) · Löschen-Button mit ConfirmDialog (.right).
// Own entries carry the delete control; holidays are read-only (dimmed, no
// delete) — same rule as the retired card version.
templ freiRow(row FreiRowVM) {
	<li class={ "row", templ.KV("opacity-60", row.IsHoliday) }>
		<span class="led-when">{ row.DateLabel }</span>
		<div class="grow">
			<div class="t"><span class={ "typechip", wocheDayOffTypeChip(row.Hue) }>{ row.KindLabel }</span></div>
			if row.Label != "" {
				<div class="s">{ row.Label }</div>
			}
		</div>
		if !row.IsHoliday {
			<div class="right">
				<button type="button" aria-label={ components.T(ctx, "common.delete") }
					data-dialog-open={ "frei-del-" + row.Day }
					class="grid place-items-center h-8 w-8 rounded-lg text-faint hover:text-red hover:bg-red/10 transition-colors">
					<span aria-hidden="true">✗</span>
				</button>
			</div>
			@components.ConfirmDialog(components.ConfirmSpec{
				ID: "frei-del-" + row.Day,
				ConfirmAttrs: templ.Attributes{
					"hx-post":   "/ui/dayoffs/delete",
					"hx-target": "#content",
					"hx-swap":   "innerHTML",
					"hx-vals":   freiDeleteVals(row.Day),
					"type":      "button",
				},
			})
		}
	</li>
}

// freiSettingsSection holds the Bundesland select (.krow) + the ICS feed
// (copy + regenerate), replacing the retired freiSettingsCard glass article.
templ freiSettingsSection(vm FreiVM) {
	<div class="sect">
		<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "frei.settings") }</span></div>
		<section class="panel p-5">
			<div class="krow">
				<span class="n">{ components.T(ctx, "frei.bundesland") }</span>
				<select name="bundesland"
					hx-post="/ui/dayoffs/bundesland" hx-target="#content" hx-swap="innerHTML" hx-trigger="change"
					class="field w-auto min-w-50">
					for _, o := range vm.BundeslandOptions {
						if o.Code == vm.BundeslandCode {
							<option value={ o.Code } selected>{ o.Name }</option>
						} else {
							<option value={ o.Code }>{ o.Name }</option>
						}
					}
				</select>
			</div>
			<div class="mt-4">
				<span class="eyebrow">{ components.T(ctx, "frei.icsFeed") }</span>
				<p class="mt-1 text-[.82rem] text-muted">{ components.T(ctx, "frei.icsHint") }</p>
				<div class="mt-2 flex items-center gap-2">
					<code class="flex-1 min-w-0 truncate rounded-lg bg-sunken px-3 py-2 text-[.78rem] font-mono text-body">{ vm.IcsURL }</code>
					<button type="button" data-copy={ vm.IcsURL } data-copied-label={ components.T(ctx, "frei.copied") }
						class="btn btn-q shrink-0">
						{ components.T(ctx, "frei.copy") }
					</button>
				</div>
				<button type="button" data-dialog-open="frei-regen"
					class="mt-3 text-[.8rem] text-muted underline hover:text-red transition-colors">
					{ components.T(ctx, "frei.regenToken") }
				</button>
				@components.ConfirmDialog(components.ConfirmSpec{
					ID:              "frei-regen",
					BodyKey:         "frei.regenBody",
					ConfirmLabelKey: "frei.regenToken",
					ConfirmAttrs: templ.Attributes{
						"hx-post":   "/ui/dayoffs/regen-token",
						"hx-target": "#content",
						"hx-swap":   "innerHTML",
						"type":      "button",
					},
				})
			</div>
			<script src={ AssetURL("js/clipboard.js") } defer></script>
		</section>
	</div>
}
