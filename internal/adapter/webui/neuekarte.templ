package webui

import "github.com/serverkraken/flow/internal/adapter/webui/components"

// NeueKarteForm ist das Formular im ⌘N-Dialog: Wohin (vorausgewählt), was
// für eine Karte (Typ mit Erklärung), Titel — und der Pfad als Vorschau,
// den niemand tippen muss. „Anlegen & schreiben" legt an und öffnet den
// Editor.
templ NeueKarteForm(vm NeueKarteVM) {
	<form method="post" action="/wissen/schnell" hx-boost="false" data-neue-karte-form data-date={ vm.Date }>
		if vm.Err != "" {
			<p class="alert-err mb-4" role="alert">{ vm.Err }</p>
		}
		<label class="block">
			<span class="mb-1 block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "neuekarte.where") }</span>
			<select name="node" class="field" data-nk-node>
				<option value="" selected?={ vm.NodeID == "" }>{ components.T(ctx, "neuekarte.noNode") }</option>
				for _, o := range vm.Nodes {
					<option value={ o.Value } selected?={ o.Value == vm.NodeID }>{ o.Label }</option>
				}
			</select>
			if vm.NodeID != "" {
				<span class="mt-1 block text-[11px] text-faint">{ components.T(ctx, "neuekarte.preselected") }</span>
			}
		</label>
		<fieldset class="mt-4">
			<legend class="mb-1 block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "neuekarte.what") }</legend>
			<div class="grid border-l border-t border-line2 sm:grid-cols-2">
				for _, t := range vm.Types {
					<label class="flex cursor-pointer items-baseline gap-2.5 border-b border-r border-line2 bg-surface px-3 py-2 has-[:checked]:bg-accent-wash">
						<input type="radio" name="type" value={ t.Value } checked?={ t.Value == vm.Type } data-nk-type data-pattern={ t.Pattern } class="accent-accent"/>
						<span class="min-w-0">
							<span class="block text-[13px] font-semibold text-ink">{ t.Label }</span>
							<span class="block text-[11px] leading-[1.4] text-muted">{ t.Desc }</span>
						</span>
					</label>
				}
			</div>
		</fieldset>
		<label class="mt-4 block" data-nk-title-field>
			<span class="mb-1 block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "wissen.title.field") }</span>
			<input type="text" name="title" class="field" autocomplete="off" autofocus data-nk-title/>
		</label>
		<div class="mt-3 text-[12px] text-muted">
			<span>{ components.T(ctx, "neuekarte.storedAs") }</span>
			<code class="ml-1 font-mono text-[12px] text-ink" data-nk-preview>{ DerivedPath("project", "", parseDate(vm.Date)) }</code>
			<button type="button" class="ml-2 text-accent hover:underline" data-nk-adjust>{ components.T(ctx, "neuekarte.adjust") }</button>
		</div>
		<label class="mt-2 hidden" data-nk-path-field>
			<span class="mb-1 block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "wissen.path") }</span>
			<input type="text" name="path" class="field font-mono" autocomplete="off" data-nk-path/>
		</label>
		<p class="mt-3 text-[11px] leading-[1.5] text-faint">{ components.T(ctx, "neuekarte.pathHint") }</p>
		<div class="mt-5 flex items-center justify-end gap-3">
			<button type="button" class="btn btn-q" data-dialog-close>{ components.T(ctx, "common.cancel") }</button>
			<button type="submit" class="btn btn-pri">{ components.T(ctx, "neuekarte.create") } <kbd class="ml-1 font-mono text-[11px] opacity-70">↵</kbd></button>
		</div>
	</form>
}
