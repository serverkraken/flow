package webui

import (
	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

// NodeView is the full cockpit page (Mockup v2.4, Spec §5/§9 "Rückgrat ersetzt
// den Baum"): a flat single-scroll layout — no tabs. Three independent SSE
// fragments (head/main/rail) wrap CockpitHead (T4), CockpitMain (T6), and
// CockpitRailBlocks (T5).
templ NodeView(d NodeCockpit) {
	@components.Base("projekte", nodeCockpitShell(d))
}

templ nodeCockpitShell(d NodeCockpit) {
	@components.AppShell("projekte", nodeBreadcrumb(d), nil, cockpitBody(d))
}

templ nodeBreadcrumb(d NodeCockpit) {
	@components.Breadcrumb(nodeCrumbs(d))
}

// cockpitBody wires the three fragments per the brief's SSE-per-mutation
// table: #cockpit-head (spine, full width — reloads only on node.updated/
// node.moved), then the .cock grid holding #cockpit-main (content column —
// reloads on every session/document/node/activity mutation) and #cockpit-rail
// (Meta-Spalte aside — reloads on session + node.updated/moved). The shared
// add-mode session dialog mounts once here (opened client-side via
// data-dialog-open, no server round-trip needed); the edit-mode dialog is
// mounted inside CockpitMain instead (cockpit_main.templ) so it also
// reappears after a #cockpit-main-only AJAX swap (the ?edit={sid} round-trip).
templ cockpitBody(d NodeCockpit) {
	<div
		id="cockpit-head"
		hx-get={ "/nodes/" + d.N.ID + "/head" }
		hx-trigger="sse:node.updated, sse:node.moved"
		hx-swap="innerHTML"
	>
		@CockpitHead(d)
	</div>
	<div class="cock">
		<div
			id="cockpit-main"
			class="min-w-0"
			hx-get={ cockpitMainReloadURL(d) }
			hx-trigger="sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted, sse:document.created, sse:document.updated, sse:document.deleted, sse:node.created, sse:node.updated, sse:node.moved, sse:node.deleted, sse:activity.logged"
			hx-swap="innerHTML"
		>
			@CockpitMain(d)
		</div>
		<aside
			class="rail"
			id="cockpit-rail"
			hx-get={ "/nodes/" + d.N.ID + "/rail" }
			hx-trigger="sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted, sse:node.updated, sse:node.moved"
			hx-swap="innerHTML"
		>
			@CockpitRailBlocks(d)
		</aside>
	</div>
	@components.SessionDialog(sessionDialogAddVM(d))
	<script src={ AssetURL("js/clipboard.js") } defer></script>
}
