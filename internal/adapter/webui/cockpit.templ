package webui

import (
	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

// nodeBreadcrumb ist alles, was von der flachen Cockpit-SEITE übrig ist. Die
// Seite selbst (NodeView/cockpitBody) ist mit der Umlegung auf den
// Register-Einstieg verschwunden; ihre Bausteine leben auf eigenen Flächen
// weiter (?tab=wissen|worktime|struktur|kontext, /nodes/{id}/artifacts). Die
// Krume brauchen sie alle.
templ nodeBreadcrumb(d NodeCockpit) {
	@components.Breadcrumb(nodeCrumbs(d))
}

