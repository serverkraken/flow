package webui

import (
	"github.com/serverkraken/flow/internal/adapter/webui/components"
	"github.com/serverkraken/flow/internal/domain"
)

// NodesPage is the full-page tree view for GET /nodes.
templ NodesPage(d NodesPageData) {
	@components.Base("projekte", nodesBody(d))
}

templ nodesBody(d NodesPageData) {
	@components.AppShell("projekte", nil, nil, nodesOuter(d))
}

// nodesOuter wraps the fragment in an SSE-reactive container so node.* events
// auto-refresh the tree without a full page reload.
templ nodesOuter(d NodesPageData) {
	<div
		id="content"
		hx-get={ "/ui/nodes/list?status=" + d.Status }
		hx-trigger="sse:node.created, sse:node.updated, sse:node.moved, sse:node.deleted"
		hx-swap="innerHTML"
	>
		@NodesFragment(d)
	</div>
}

// NodesFragment is the SSE-swappable inner tree — served at both
// GET /ui/nodes/list and GET /ui/nodes/tree. The Projekte page renders the
// node tree as content (Mockup Z.442–570): an engagement header (double
// rule), vorhaben sub-heads, and repo rows with a large short name plus the
// full mono path underneath — glyph-free throughout (Spec §7 Farb-Gesetz:
// kind stays a neutral .typechip, color lives only in the avatar).
templ NodesFragment(d NodesPageData) {
	<div class="pagehead flex items-end gap-5 flex-wrap">
		<div class="flex-1">
			<span class="eyebrow">{ components.T(ctx, "nav.projects") }</span>
			<h1>{ components.T(ctx, "nodes.title") }</h1>
			<p class="sub">{ ProjectsSummary(ctx, d.VM) }</p>
		</div>
		<a href="/nodes/new" class="btn btn-q">{ components.T(ctx, "nodes.new") }</a>
	</div>
	<div class="mb-4 flex flex-wrap gap-2 text-sm">
		<a href="/nodes" class={ nodeFilterChip(d.Status == "") }>{ components.T(ctx, "nodes.filterActive") }</a>
		<a href="/nodes?status=archived" class={ nodeFilterChip(d.Status == "archived") }>{ components.T(ctx, "nodes.filterArchived") }</a>
		<a href="/nodes?status=all" class={ nodeFilterChip(d.Status == "all") }>{ components.T(ctx, "nodes.filterAll") }</a>
	</div>
	if len(d.VM.Engagements) == 0 && d.Status == "" {
		@nodesFirstStart()
	} else if len(d.VM.Engagements) == 0 {
		@components.EmptyState("", "nodes.empty", "nodes.emptyHint")
	} else {
		for _, es := range d.VM.Engagements {
			@engagementSection(es)
		}
	}
}

// engagementSection renders one .eng block: the double-ruled header, each
// vorhaben's group (rows indented .lvl2 under it), then any repos parented
// directly on the engagement — as a "Direkt am Engagement" group when vorhaben
// groups exist alongside them, or as plain top-level rows when they're the
// engagement's only children (Mockup's "Privat" section has no vh head at all).
templ engagementSection(es EngagementSection) {
	<section class="eng">
		<a class="eng-h" href={ templ.SafeURL("/nodes/" + es.N.ID) }>
			@components.Avatar(es.Initials, es.Tone, "av-36")
			<h2>{ ShortName(es.N.Name) }</h2>
			<span class="typechip">{ components.T(ctx, "node.kind."+string(es.N.Kind)) }</span>
			<div class="right"><div class="v">{ es.HoursStr }</div><div class="k">{ es.RateNote }</div></div>
		</a>
		if len(es.Groups) > 0 {
			for _, g := range es.Groups {
				@vorhabenHead(g)
				for _, row := range g.Rows {
					@projRow(row, true)
				}
			}
			if len(es.DirectRepos) > 0 {
				<div class="vh">
					<span class="t">{ components.T(ctx, "nodes.group.direct") }</span>
					<span class="c">{ repoCountNote(len(es.DirectRepos)) }</span>
				</div>
				for _, row := range es.DirectRepos {
					@projRow(row, true)
				}
			}
		} else {
			for _, row := range es.DirectRepos {
				@projRow(row, false)
			}
		}
	</section>
}

// vorhabenHead renders one .vh sub-head: short name, neutral "vorhaben"
// typechip, and the group's repo/sub-vorhaben count note. The head links to
// the vorhaben's cockpit — group-head vorhaben have no .projrow of their own,
// so without the link they'd be unreachable from the Projekte page.
templ vorhabenHead(g VorhabenGroup) {
	<a class="vh" href={ templ.SafeURL("/nodes/" + g.N.ID) }>
		<span class="t">{ g.Short }</span>
		<span class="typechip">{ components.T(ctx, "node.kind.vorhaben") }</span>
		<span class="c">{ g.CountNote }</span>
	</a>
}

// projRow renders one repo (or nested-vorhaben) line: avatar, short name +
// full mono path (word-break:break-all via .path — Spec §11 Eindämmung), and
// the right-aligned doc-count/hours + status note. indented adds .lvl2 when
// the row sits under a .vh head (vs. a bare top-level row).
templ projRow(row ProjRow, indented bool) {
	<a class={ "projrow", templ.KV("lvl2", indented) } href={ templ.SafeURL("/nodes/" + row.ID) }>
		@components.Avatar(row.Initials, row.Tone, "av-28")
		<div class="grow">
			if row.IsVorhaben {
				<div class="t">
					{ row.Short }
					<span class="dim font-normal">· { components.T(ctx, "node.kind."+row.KindLabel) }</span>
				</div>
				<div class="s">{ projRowUnderNote(ctx, row.Full) }</div>
			} else {
				<div class="t">{ row.Short }</div>
				if row.Desc != "" {
					<div class="s truncate" title={ row.Desc }>{ row.Desc }</div>
				}
				<div class="path">{ row.Full }</div>
			}
		</div>
		<div class="right">
			<div class="v">{ row.RightV }</div>
			<div class="k">{ components.T(ctx, row.RightK) }</div>
		</div>
	</a>
}

// nodeKindBadge renders the kind pill (glyph + i18n label, kind-toned).
templ nodeKindBadge(kind domain.NodeKind) {
	{{ k := NodeKindStyle(kind) }}
	<span class={ "inline-flex shrink-0 items-center gap-1.5 border px-2 py-0.5 text-[11px] font-medium", kindToneClass(k.Tone) }>
		<span aria-hidden="true">{ k.Glyph }</span> { components.T(ctx, k.LabelKey) }
	</span>
}

// NodeForm renders the create (editing==nil) or edit form for a node.
templ NodeForm(d NodeFormData, editing *domain.Node) {
	@components.Base("projekte", nodeFormBody(d, editing))
}

templ nodeFormBody(d NodeFormData, editing *domain.Node) {
	@components.AppShell("projekte", nil, nil, nodeFormInner(d, editing))
}

templ nodeFormInner(d NodeFormData, editing *domain.Node) {
	<div class="mx-auto w-full max-w-[640px]">
		<div class="pagehead">
			<span class="eyebrow">{ components.T(ctx, "node.register") }</span>
			<h1>
				if editing != nil {
					{ components.T(ctx, "node.edit.title") }
				} else {
					{ components.T(ctx, "node.create.title") }
				}
			</h1>
		</div>
		if d.Error != "" {
			<p class="alert-err mb-4" role="alert">{ d.Error }</p>
		}
		<form method="post" action={ nodeFormAction(editing) } enctype="multipart/form-data" hx-boost="false" class="space-y-8 text-[13px]" data-node-form data-editing?={ editing != nil }>
			// ── Art und Ort ──
			<section>
				@nodeFormKopf("node.sect.art", "")
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						<label class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint" for="node-kind">{ components.T(ctx, "node.kind") }</label>
						<select name="kind" id="node-kind" class="field mt-1"
							data-desc-engagement={ components.T(ctx, "node.kind.engagement.desc") }
							data-desc-vorhaben={ components.T(ctx, "node.kind.vorhaben.desc") }
							data-desc-repo={ components.T(ctx, "node.kind.repo.desc") }>
							@nodeKindOption("engagement", "node.kind.engagement", d.Vals.Kind)
							@nodeKindOption("vorhaben", "node.kind.vorhaben", d.Vals.Kind)
							@nodeKindOption("repo", "node.kind.repo", d.Vals.Kind)
						</select>
						<p class="mt-1 text-[11px] leading-[1.4] text-muted" data-kind-desc></p>
					</div>
					<div data-parent-field>
						<label class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint" for="node-parent">{ components.T(ctx, "node.parent") }</label>
						if editing != nil {
							<select name="parentId" id="node-parent" class="field mt-1 cursor-not-allowed opacity-50" disabled>
								<option value="">{ components.T(ctx, "node.parentRoot") }</option>
								for _, p := range d.Parents {
									if d.Vals.ParentID == p.ID {
										<option value={ p.ID } data-parent-kind={ string(p.Kind) } selected>{ nodeParentLabel(p) }</option>
									} else {
										<option value={ p.ID } data-parent-kind={ string(p.Kind) }>{ nodeParentLabel(p) }</option>
									}
								}
							</select>
							<p class="mt-1 text-[11px] text-faint">{ components.T(ctx, "node.parentEditHint") }</p>
							@nodeMoveForm(d, editing)
						} else {
							<select name="parentId" id="node-parent" class="field mt-1">
								<option value="">{ components.T(ctx, "node.parentRoot") }</option>
								for _, p := range d.Parents {
									if d.Vals.ParentID == p.ID {
										<option value={ p.ID } data-parent-kind={ string(p.Kind) } selected>{ nodeParentLabel(p) }</option>
									} else {
										<option value={ p.ID } data-parent-kind={ string(p.Kind) }>{ nodeParentLabel(p) }</option>
									}
								}
							</select>
						}
					</div>
				</div>
			</section>
			// ── Name und Kürzel ──
			<section>
				@nodeFormKopf("node.sect.name", "")
				<label class="block">
					<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.name") }</span>
					<input name="name" value={ d.Vals.Name } required class="field mt-1" autocomplete="off" data-node-name/>
				</label>
				<p class="mt-2 text-[12px] text-muted">
					{ components.T(ctx, "node.slug") }
					<code class="ml-1 font-mono text-[12px] text-ink" data-slug-preview>{ d.Vals.Slug }</code>
					if editing == nil {
						<span class="ml-1 text-faint">· { components.T(ctx, "node.slug.auto") }</span>
						<button type="button" class="ml-2 text-accent hover:underline" data-slug-adjust>{ components.T(ctx, "neuekarte.adjust") }</button>
					}
				</p>
				<label class={ "mt-2 block", templ.KV("hidden", editing == nil && d.Vals.Slug == "") } data-slug-field>
					<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.slug") }</span>
					<input name="slug" value={ d.Vals.Slug } class="field mt-1 font-mono" autocomplete="off" data-node-slug/>
				</label>
				<label class="mt-4 block">
					<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.description") } <span class="font-normal normal-case tracking-normal">· { components.T(ctx, "common.optional") }</span></span>
					<textarea name="description" rows="3" class="field mt-1 font-mono">{ d.Vals.Description }</textarea>
				</label>
			</section>
			// ── Monogramm und Farbe ──
			<section>
				@nodeFormKopf("node.sect.mono", "node.sect.mono.hint")
				<div class="flex flex-wrap items-center gap-5">
					<div class="flex items-center gap-3">
						<span class="grid h-11 w-11 place-items-center bg-sunken font-mono text-[15px] font-bold text-oncolor" data-mono-preview style={ "background-color:" + orDefault(ColorHex(d.Vals.Color), "rgb(var(--meta))") }>{ Initials(d.Vals.Name) }</span>
						<span class="text-[11px] text-faint">{ components.T(ctx, "node.mono.preview") }</span>
					</div>
					<div class="flex flex-wrap gap-2" data-color-swatches>
						@nodeColorRadio("", d.Vals.Color)
						for _, name := range domain.NodeColors {
							@nodeColorRadio(name, d.Vals.Color)
						}
					</div>
				</div>
				<div class="mt-4">
					<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.banner") } <span class="font-normal normal-case tracking-normal">· { components.T(ctx, "common.optional") }</span></span>
					if editing != nil && editing.BannerRef != "" {
						<div class="mb-2 mt-1 flex items-center gap-3">
							<img src={ "/nodes/" + editing.ID + "/banner?v=" + editing.BannerRef } alt="" class="h-[38px] w-full max-w-[240px] object-cover"/>
							<label class="flex items-center gap-2 text-[12.5px]">
								<input type="checkbox" name="bannerRemove" value="1"/> { components.T(ctx, "node.banner.remove") }
							</label>
						</div>
					}
					<input type="file" name="banner" accept="image/png,image/jpeg,image/webp" class="field mt-1"/>
					<p class="mt-1 text-[11px] text-faint">{ components.T(ctx, "node.banner.hint") }</p>
				</div>
			</section>
			// ── Abrechnung und Umfang ──
			<section>
				@nodeFormKopf("node.sect.bill", "node.sect.bill.hint")
				<div class="grid gap-4 sm:grid-cols-2">
					<label class="block">
						<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.counts.label") }</span>
						<select name="countsMode" class="field mt-1">
							@nodeCountsOption("inherit", "node.counts.inherit", d.Vals.CountsMode)
							@nodeCountsOption("work", "node.counts.work", d.Vals.CountsMode)
							@nodeCountsOption("privat", "node.counts.privat", d.Vals.CountsMode)
						</select>
					</label>
					<div id="node-rate" class="flex flex-wrap items-end gap-3">
						<label class="block">
							<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.rate") }</span>
							<input name="rateAmount" value={ d.Vals.RateAmount } placeholder="95.00" class="field mt-1 w-32 font-mono tnum"/>
						</label>
						<label class="block">
							<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.rateCurrency") }</span>
							<input name="rateCurrency" value={ orDefault(d.Vals.RateCurrency, "EUR") } class="field mt-1 w-20 font-mono"/>
						</label>
						<span class="pb-2.5 text-[11px] text-faint">{ components.T(ctx, "node.rateHint") }</span>
					</div>
				</div>
				<p class="mt-2 text-[11px] leading-[1.5] text-faint">{ components.T(ctx, "node.rate.note") }</p>
			</section>
			// ── Repo, Tags, Status ──
			<section>
				@nodeFormKopf("node.sect.more", "")
				<div class="grid gap-4 sm:grid-cols-2">
					<label class="block sm:col-span-2" data-upstream-field>
						<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.upstream") }</span>
						<input name="upstreamGit" value={ d.Vals.UpstreamGit } placeholder="git@github.com:org/repo.git" class="field mt-1 font-mono"/>
					</label>
					<label class="block">
						<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "wissen.tags") }</span>
						<input name="tags" value={ d.Vals.TagsCSV } placeholder="tag1 tag2" class="field mt-1 font-mono"/>
					</label>
					<label class="block">
						<span class="block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "node.status") }</span>
						<select name="status" class="field mt-1">
							@nodeStatusOption("active", "node.status.active", d.Vals.Status)
							@nodeStatusOption("paused", "node.status.paused", d.Vals.Status)
							@nodeStatusOption("archived", "node.status.archived", d.Vals.Status)
						</select>
					</label>
				</div>
			</section>
			// ── Beim Anlegen ──
			if editing == nil {
				<section>
					@nodeFormKopf("node.sect.onCreate", "")
					<label class="flex items-baseline gap-2.5 border-b border-line py-2.5">
						<input type="checkbox" name="createReadme" value="1" checked class="accent-accent"/>
						<span><span class="block text-[13px] font-semibold text-ink">{ components.T(ctx, "node.onCreate.readme") }</span><span class="block text-[11px] text-muted">{ components.T(ctx, "node.onCreate.readme.sub") }</span></span>
					</label>
					<label class="flex items-baseline gap-2.5 border-b border-line py-2.5">
						<input type="checkbox" name="startTimer" value="1" class="accent-accent"/>
						<span><span class="block text-[13px] font-semibold text-ink">{ components.T(ctx, "node.onCreate.timer") }</span><span class="block text-[11px] text-muted">{ components.T(ctx, "node.onCreate.timer.sub") }</span></span>
					</label>
				</section>
			}
			<div class="flex flex-wrap items-center justify-between gap-3 border-t border-line2 pt-5">
				<span class="text-[12px] text-muted" data-path-preview-line>
					if editing == nil {
						{ components.T(ctx, "node.createdAs") } <b class="font-semibold text-ink" data-path-preview></b>
					}
				</span>
				<span class="flex items-center gap-3">
					<a href="/nodes" class="btn btn-q">{ components.T(ctx, "common.cancel") }</a>
					if editing != nil {
						@components.Button(components.BtnPrimary, components.T(ctx, "common.save"), "", templ.Attributes{"type": "submit"})
					} else {
						@components.Button(components.BtnPrimary, components.T(ctx, "node.create.submit"), "", templ.Attributes{"type": "submit"})
					}
				</span>
			</div>
		</form>
		if editing != nil {
			<form id="node-move-form" method="post" action={ templ.SafeURL("/nodes/" + editing.ID + "/move") } hx-boost="false"></form>
			<form method="post" action={ templ.SafeURL("/nodes/" + editing.ID + "/delete") } hx-boost="false" class="mt-6 border-t border-line2 pt-5">
				@components.Button(components.BtnDanger, components.T(ctx, "common.delete"), "", templ.Attributes{"type": "submit"})
			</form>
		}
	</div>
	<script src={ AssetURL("js/nodeform.js") } defer></script>
}

// nodeFormKopf ist der Abschnittskopf des Register-Formulars.
templ nodeFormKopf(titleKey, hintKey string) {
	<div class="mb-3 border-b border-line2 pb-2">
		<h2 class="font-display text-[15px] font-[750] tracking-[-.01em] text-ink">{ components.T(ctx, titleKey) }</h2>
		if hintKey != "" {
			<p class="mt-0.5 text-[11.5px] text-muted">{ components.T(ctx, hintKey) }</p>
		}
	</div>
}

// nodeMoveForm renders the reparent controls on the edit page (Task 7: moved
// here from the cockpit page's old cockpitMoveForm — the cockpit no longer has
// a Struktur tab to host it). It sits INSIDE the main edit <form>, so it must
// not open its own <form> (nested forms are invalid HTML; the browser drops
// the inner tag and the stray </form> closes the edit form early, orphaning
// every control below — logo upload, Speichern). The controls bind via the
// form attribute to the empty #node-move-form element rendered AFTER the edit
// form, which posts to POST /nodes/{id}/move (full-page redirect, no htmx
// swap). Only called from the editing!=nil branch of the Parent field.
templ nodeMoveForm(d NodeFormData, editing *domain.Node) {
	<div class="mt-2">
		<label class="block text-muted">{ components.T(ctx, "node.moveTitle") }</label>
		<div class="flex flex-wrap items-end gap-2">
			<select name="parentId" form="node-move-form" class="field">
				<option value="">{ components.T(ctx, "node.parentRoot") }</option>
				for _, p := range d.MoveTargets {
					if editing.ParentID != nil && *editing.ParentID == p.ID {
						<option value={ p.ID } selected>{ nodeParentLabel(p) }</option>
					} else {
						<option value={ p.ID }>{ nodeParentLabel(p) }</option>
					}
				}
			</select>
			@components.Button(components.BtnSecondary, components.T(ctx, "node.move"), "→", templ.Attributes{"type": "submit", "form": "node-move-form"})
		</div>
	</div>
}

templ nodeKindOption(val, labelKey, current string) {
	if val == current || (current == "" && val == "engagement") {
		<option value={ val } selected>{ components.T(ctx, labelKey) }</option>
	} else {
		<option value={ val }>{ components.T(ctx, labelKey) }</option>
	}
}

templ nodeStatusOption(val, labelKey, current string) {
	if val == current || (current == "" && val == "active") {
		<option value={ val } selected>{ components.T(ctx, labelKey) }</option>
	} else {
		<option value={ val }>{ components.T(ctx, labelKey) }</option>
	}
}

// nodeCountsOption renders one Work/Privat tri-state option; an empty current
// value defaults to "inherit" (nil override).
templ nodeCountsOption(val, labelKey, current string) {
	if val == current || (current == "" && val == "inherit") {
		<option value={ val } selected>{ components.T(ctx, labelKey) }</option>
	} else {
		<option value={ val }>{ components.T(ctx, labelKey) }</option>
	}
}

templ nodeColorRadio(name, current string) {
	<label class="cursor-pointer">
		if name == current {
			<input type="radio" name="color" value={ name } checked class="peer sr-only"/>
		} else {
			<input type="radio" name="color" value={ name } class="peer sr-only"/>
		}
		if name == "" {
			<span class="inline-flex h-6 w-6 items-center justify-center border border-line text-xs text-faint peer-checked:outline peer-checked:outline-2 peer-checked:outline-offset-1 peer-checked:outline-ink">∅</span>
		} else {
			<span class="inline-block h-6 w-6 peer-checked:outline peer-checked:outline-2 peer-checked:outline-offset-1 peer-checked:outline-ink" style={ "background-color:" + ColorHex(name) } data-swatch={ ColorHex(name) }></span>
		}
	</label>
}



// nodesFirstStart ist der leere Kasten (Screen 29): alles in flow hängt an
// einem Register, also zuerst ein Engagement — und danach die Reihenfolge,
// die die Uhr nicht ins Leere rechnen lässt.
templ nodesFirstStart() {
	<section class="mx-auto max-w-[560px] py-10" data-first-start>
		<span class="eyebrow">{ components.T(ctx, "nodes.first.eyebrow") }</span>
		<h2 class="mt-1 font-display text-[26px] font-[750] tracking-[-.02em] text-ink">{ components.T(ctx, "nodes.first.title") }</h2>
		<p class="mt-3 text-[15px] leading-[1.6] text-body">{ components.T(ctx, "nodes.first.body") }</p>
		<p class="mt-2 text-[12.5px] text-faint">{ components.T(ctx, "nodes.first.none") }</p>
		<a href="/nodes/new?kind=engagement" class="btn btn-pri mt-5 inline-flex">{ components.T(ctx, "nodes.first.cta") }</a>
		<div class="mt-8 border-b border-line2 pb-2 text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "nodes.first.then") }</div>
		@nodesFirstStep("01", "nodes.first.step1", "nodes.first.step1.sub", "/nodes/new?kind=vorhaben")
		@nodesFirstStep("02", "nodes.first.step2", "nodes.first.step2.sub", "/einstellungen#sollzeiten")
		@nodesFirstStep("03", "nodes.first.step3", "nodes.first.step3.sub", "/nodes/new?kind=repo")
	</section>
}

templ nodesFirstStep(num, titleKey, subKey, href string) {
	<a href={ templ.SafeURL(href) } class="flex items-baseline gap-3 border-b border-line py-2.5 hover:bg-accent-wash">
		<span class="num w-6 shrink-0 text-[11px] text-meta">{ num }</span>
		<span class="min-w-0"><span class="block text-[14px] font-[650] text-ink">{ components.T(ctx, titleKey) }</span><span class="block text-[11.5px] text-muted">{ components.T(ctx, subKey) }</span></span>
	</a>
}
