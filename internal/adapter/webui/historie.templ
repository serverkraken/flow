package webui

import "github.com/serverkraken/flow/internal/adapter/webui/components"

// HistoriePage is the full Historie page on the Lesesaal AppShell.
templ HistoriePage(vm HistorieVM) {
	@components.Base("historie", historieCalBody(vm))
}

// historieCalBody mounts Historie with NO sub-tab-strip (subnav = nil,
// matching the Zeit-Hub/Woche pattern) — the Heute/Woche/Historie pill strip
// is replaced by the "‹ Zeit" spine back-link (HistorieCalendarFragment). This
// was the last caller of worktimeSubnav; its DEFINITION is now retired
// (heute.templ).
templ historieCalBody(vm HistorieVM) {
	@components.AppShell("zeit", nil, nil, historieCalOuter(vm))
}

// historieCalOuter is the SSE-swap container: it reloads the calendar
// fragment on any worktime/dayoff/node mutation, preserving the displayed
// week via FragmentURL. project.created (dead event) is replaced by the real
// node.created, and dayoff.changed is added so a Frei-entry lands live in the
// calendar's day-off badges (Berater-Fund #8).
templ historieCalOuter(vm HistorieVM) {
	<div id="content"
		hx-get={ vm.FragmentURL }
		hx-trigger="sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted, sse:node.created, sse:dayoff.changed"
		hx-swap="innerHTML">
		@HistorieCalendarFragment(vm)
	</div>
	<script src={ AssetURL("js/historie-select.js") } defer></script>
}

// HistorieCalendarFragment is the inner calendar content (week or month): the
// "‹ Zeit" spine, the pagehead, the Kalender/Liste + Woche/Monat toggles, the
// hairline time-grid (week) or hairline day-cell grid (month), and the
// selection bar + single-edit dialog. No glass/Card/shadow-soft/font-display
// chrome — Kristall is fully retired from this page.
templ HistorieCalendarFragment(vm HistorieVM) {
	<div class="narrow">
		<div class="spine">
			<div class="up">
				<a href="/zeit">{ components.T(ctx, "zeit.back") }</a>
			</div>
		</div>
		<div class="pagehead">
			<span class="eyebrow">{ components.T(ctx, "historie.eyebrow") }</span>
			<h1>{ components.T(ctx, "historie.title") }</h1>
		</div>
		if vm.Err != "" {
			<p class="alert-err" role="alert">{ vm.Err }</p>
		}
		@historieToolbar(vm)
		if vm.CalView == "month" {
			@historieMonth(vm)
		} else {
			@historieWeek(vm)
			@historieAgenda(vm)
		}
		@HistorieSelectionBarC(vm.Nodes, "cal")
		@historieEditDialog(vm.Nodes)
	</div>
}

// historieToolbar is the view toggle (Kalender|Liste), Woche|Monat, the
// week/month-nav stepper, the "Auswählen" toggle, and the unassigned banner —
// plain Lesesaal .seg/.btn/.led-when controls, replacing the Kristall glass
// pill stepper + bg-ink button.
templ historieToolbar(vm HistorieVM) {
	<div class="sect-h" style="flex-wrap:wrap;row-gap:10px">
		<div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px">
			@historieSeg([]components.SegOption{
				{Key: "cal", LabelKey: "historie.calendar", Href: vm.CalWeekURL},
				{Key: "list", LabelKey: "historie.list", Href: vm.ListHref},
			}, "cal")
			@historieSeg([]components.SegOption{
				{Key: "week", LabelKey: "historie.week", Href: vm.CalWeekURL},
				{Key: "month", LabelKey: "historie.month", Href: vm.CalMonthURL},
			}, vm.CalView)
			<button type="button" class="btn btn-q btn-s" aria-label={ components.T(ctx, "woche.prev") }
				hx-get={ vm.PrevHref } hx-target="#content" hx-swap="innerHTML">
				<span aria-hidden="true">‹</span>
			</button>
			<span class="led-when">{ vm.RangeLabel }</span>
			if vm.NextHref != "" {
				<button type="button" class="btn btn-q btn-s" aria-label={ components.T(ctx, "woche.next") }
					hx-get={ vm.NextHref } hx-target="#content" hx-swap="innerHTML">
					<span aria-hidden="true">›</span>
				</button>
			} else {
				<span class="text-faint" aria-hidden="true">›</span>
			}
			if vm.ThisHref != "" {
				<button type="button" class="btn btn-q btn-s"
					hx-get={ vm.ThisHref } hx-target="#content" hx-swap="innerHTML">
					{ components.T(ctx, "historie.thisWeek") }
				</button>
			}
		</div>
		<button type="button" data-select-toggle
			data-label-select={ components.T(ctx, "historie.select") }
			data-label-done={ components.T(ctx, "historie.selectDone") }
			class="btn btn-q btn-s ml-auto">
			<span aria-hidden="true">▎</span> { components.T(ctx, "historie.select") }
		</button>
	</div>
	if vm.UnassignedCount > 0 {
		<div class="rounded-xl border border-orange/30 bg-orange/10 px-3.5 py-2.5"
			style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin-top:10px">
			<span class="text-orange" style="display:inline-flex;align-items:center;gap:6px;font-size:.86rem;font-weight:600">
				<span aria-hidden="true">○</span> { components.Tn(ctx, "historie.unassignedBanner", vm.UnassignedCount) }
			</span>
			<button type="button" data-select-unassigned class="btn btn-q btn-s text-orange" style="margin-left:auto">
				<span aria-hidden="true">▎</span> { components.T(ctx, "historie.selectAllUnassigned") }
			</button>
		</div>
	}
}

// historieSeg is a bare Lesesaal `.seg` segmented toggle (Kalender|Liste,
// Woche|Monat) — replaces components.SegToggle (whose option markup baked in
// Kristall shadow-soft/rounded-[9px]/text-blue) with the `.seg` primitive
// alone: its own `[aria-pressed="true"]` CSS (tailwind.css:335-337) already
// supplies the active surface/color/shadow. SegToggle has zero other callers
// after this task (verified via rg), so nothing downstream depends on it
// keeping its Kristall chrome — this local twin simply avoids touching the
// shared components package for a Historie-only rebuild.
templ historieSeg(options []components.SegOption, active string) {
	<div class="seg inline-flex" role="group">
		for _, o := range options {
			if o.Key == active {
				<a href={ templ.SafeURL(o.Href) } aria-pressed="true" class="px-3.5 py-1.5 text-[.85rem] font-semibold">{ components.T(ctx, o.LabelKey) }</a>
			} else {
				<a href={ templ.SafeURL(o.Href) } aria-pressed="false" class="px-3.5 py-1.5 text-[.85rem] font-medium text-muted hover:text-ink">{ components.T(ctx, o.LabelKey) }</a>
			}
		}
	</div>
}

// historieWeek is the desktop time-grid (md+; mobile uses the agenda). The
// grid mechanism itself (.grid-lines/.wtblock/.now-line, Task-1-era tokens)
// is unchanged Bestand — only the outer card chrome (was rounded-3xl glass
// shadow-soft) is retired for a hairline frame that scrolls in its own frame
// on medium viewports (no page-level H-pan).
templ historieWeek(vm HistorieVM) {
	<section class="hidden md:block" aria-label={ components.T(ctx, "historie.calendar") }>
		<div class="rounded-xl border border-line2 overflow-hidden">
			<div class="overflow-x-auto scroll-thin">
				<div class="narrow-min">
					<div class="grid grid-cols-[56px_repeat(7,minmax(0,1fr))] border-b border-line2">
						<div class="border-r border-line2"></div>
						for _, d := range vm.Days {
							@historieDayHead(d)
						}
					</div>
					<div class="relative">
						<div class="grid grid-cols-[56px_repeat(7,minmax(0,1fr))]">
							@historieTimeAxis(vm)
							for _, d := range vm.Days {
								@historieDayColumn(vm, d)
							}
						</div>
					</div>
				</div>
			</div>
		</div>
		@historieLegend()
	</section>
}

// historieDayHead is one clickable day-header (carries data-day-select for bulk
// "Tag wählen" in select-mode). The day-off badge is now a semantic
// .typechip/tc-* tone (Farb-Gesetz §7), reusing wocheDayOffTypeChip's hue
// mapping instead of the retired per-hue bg/text wash.
templ historieDayHead(d HistorieDayVM) {
	<div class={ historieDayHeadClass(d) }>
		<span class={ historieDayLabelClass(d) }>
			{ d.Label }
			if d.IsToday {
				<span class="rounded bg-cyan/15 px-1 py-px text-[.56rem] tracking-normal">{ components.T(ctx, "historie.today") }</span>
			}
		</span>
		<span class="mt-0.5 flex items-center gap-1.5">
			<span class={ historieDayNumClass(d) }>{ d.DayNum }</span>
			if d.Dur != "" {
				<span class={ historieDayDurClass(d) }>{ d.Dur }</span>
			}
		</span>
		if d.DayOff {
			<span class={ "typechip", wocheDayOffTypeChip(d.DayOffHue) } title={ d.DayOffLabel }>
				<span aria-hidden="true">○</span> { d.DayOffLabel }
			</span>
		}
		<button type="button" data-day-select={ d.Key } class="day-chk hidden mt-1 items-center gap-1 text-[.66rem] font-semibold text-blue">
			<span aria-hidden="true">▢</span> { components.T(ctx, "historie.selectDay") }
		</button>
	</div>
}

// historieTimeAxis is the left hour-label column.
templ historieTimeAxis(vm HistorieVM) {
	<div class="relative border-r border-line2 select-none" style={ "height:" + itoaPx(vm.GridHeightPx) }>
		for _, h := range vm.HourLabels {
			<span class="absolute right-2 text-[.66rem] font-mono tnum text-faint" style={ "top:" + itoaPx(h.TopPx) }>{ h.Label }</span>
		}
	</div>
}

// historieDayColumn is one day's grid-lines column with positioned blocks + the
// now-line for today.
templ historieDayColumn(vm HistorieVM, d HistorieDayVM) {
	<div class={ historieColumnClass(d) } data-day-col={ d.Key } style={ "height:" + itoaPx(vm.GridHeightPx) }>
		if d.NowLineTopPx >= 0 {
			<div class="now-line" style={ "top:" + itoaPx(d.NowLineTopPx) } aria-hidden="true"></div>
		}
		for _, b := range d.Blocks {
			@historieBlock(d.Key, d.DateKey, b)
		}
	</div>
}

// historieBlock wraps SessionBlock with the selection data-attrs (day bucket,
// unassigned flag) and the single-edit opener.
templ historieBlock(dayKey, dateKey string, b components.SessionBlockVM) {
	<div class="contents"
		data-block-wrap
		data-day={ dayKey }
		data-date={ dateKey }
		data-edit-id={ b.ID }
		data-edit-from={ historieClockStart(b.TimeRange) }
		data-edit-to={ b.EditTo }
		data-edit-tag={ b.EditTag }
		data-edit-note={ b.EditNote }
		data-edit-project={ b.EditNodeID }
		data-unassigned={ historieUnFlag(b.Unassigned) }>
		@components.SessionBlock(b)
	</div>
}

// historieAgendaRow wraps a mobile agenda SessionRow with the SAME edit-data +
// selection attrs as historieBlock, so tapping a row on mobile opens the
// single-edit dialog (and select-mode works) — parity with the desktop blocks.
templ historieAgendaRow(dayKey, dateKey string, b components.SessionBlockVM, row components.SessionRowVM) {
	<div class="contents"
		data-block-wrap
		data-day={ dayKey }
		data-date={ dateKey }
		data-edit-id={ b.ID }
		data-edit-from={ historieClockStart(b.TimeRange) }
		data-edit-to={ b.EditTo }
		data-edit-tag={ b.EditTag }
		data-edit-note={ b.EditNote }
		data-edit-project={ b.EditNodeID }
		data-unassigned={ historieUnFlag(b.Unassigned) }>
		@historieSessionRow(row)
	</div>
}

// historieAgenda is the mobile day-grouped agenda list (≤md): plain .sect
// groups of .row session rows, replacing the Kristall space-y card list.
templ historieAgenda(vm HistorieVM) {
	<section class="md:hidden" aria-label="Agenda">
		for _, d := range vm.Days {
			if len(d.Rows) > 0 {
				<div class="sect" data-day-group={ d.Key }>
					<div class="sect-h">
						<span class={ historieAgendaHeadClass(d) }>
							{ d.Label } <span class="text-muted font-normal tnum">{ d.DateLabel }</span>
							if d.IsToday {
								{ " · " + components.T(ctx, "historie.today") }
							}
						</span>
						if d.Dur != "" {
							<span class="note font-mono tnum">{ d.Dur }</span>
						}
					</div>
					<ul>
						for j, row := range d.Rows {
							if j < len(d.Blocks) {
								@historieAgendaRow(d.Key, d.DateKey, d.Blocks[j], row)
							} else {
								@historieSessionRow(row)
							}
						}
					</ul>
				</div>
			}
		}
	</section>
}

// historieMonth is the month view: a continuous hairline day-cell grid
// (Haarlinien-Tageszellen), replacing the Kristall rounded-3xl glass card +
// isolated rounded-xl border cells.
templ historieMonth(vm HistorieVM) {
	<section class="panel p-4 sm:p-6" aria-label={ components.T(ctx, "historie.month") }>
		<div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px" class="mb-4">
			<h2 class="text-lg font-semibold">{ vm.MonthLabel }</h2>
			<div class="flex items-center gap-2 text-[.72rem] text-muted">
				<span class="inline-flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-sm bg-blue"></span> { components.T(ctx, "historie.withProject") }</span>
				<span class="inline-flex items-center gap-1.5"><span class="text-orange" aria-hidden="true">○</span> { components.T(ctx, "historie.unassigned") }</span>
			</div>
		</div>
		<div class="grid grid-cols-7 border-t border-l border-line2">
			for _, wd := range []string{"Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"} {
				<div class="text-center eyebrow py-1 border-r border-b border-line2">{ wd }</div>
			}
			for _, c := range vm.MonthCells {
				@historieMonthCell(c)
			}
		</div>
		<div class="krow" style="margin-top:8px">
			<span class="n">{ components.T(ctx, "historie.monthTotal") }</span>
			<span class="v">{ vm.MonthTotal }</span>
		</div>
		if vm.MonthUnassigned > 0 {
			<p class="text-orange" style="font-size:.86rem;font-weight:600;margin-top:4px">
				<span aria-hidden="true">○</span> { components.Tn(ctx, "historie.unassignedBanner", vm.MonthUnassigned) }
			</p>
		}
	</section>
}

// historieMonthCell is one day cell (padding, or day with mini-bars + flag) —
// a hairline grid cell (border-r/border-b only, no card radius/shadow).
templ historieMonthCell(c HistorieMonthCellVM) {
	if c.Empty {
		<div class="h-[92px] border-r border-b border-transparent"></div>
	} else {
		<a href={ templ.SafeURL(c.WeekHref) } class={ historieMonthCellClass(c) }>
			<div class="flex items-start justify-between">
				<span class={ historieMonthNumClass(c) }>{ c.DayNum }</span>
				if c.HasUnassigned {
					<span class="text-orange text-[.66rem]" aria-label={ components.T(ctx, "historie.unassigned") }>○</span>
				} else if c.Hours != "" {
					<span class="text-accent text-[.6rem]" aria-hidden="true">●</span>
				}
			</div>
			<div class="mt-auto" style="display:flex;flex-direction:column;gap:3px">
				for _, b := range c.Bars {
					<span class={ historieMonthBarClass(b) } style={ "width:" + itoa(b.WidthPct) + "%" }></span>
				}
			</div>
			if c.Hours != "" {
				<div class="mt-1 text-right"><span class={ historieMonthHoursClass(c) }>{ c.Hours }</span></div>
			}
		</a>
	}
}

// historieLegend is the unassigned/running swatch legend under the week grid.
templ historieLegend() {
	<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[.78rem] text-muted">
		<span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-sm border border-dashed border-faint bg-sunken"></span> <span class="text-orange">○</span> { components.T(ctx, "historie.unassigned") }</span>
		<span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-sm bg-cyan"></span> { components.T(ctx, "heute.running") }</span>
	</div>
}

// ── List view ────────────────────────────────────────────────────────────────

// HistorieListPage is the full Historie list page on the AppShell.
templ HistorieListPage(vm HistorieListVM) {
	@components.Base("historie", historieListBody(vm))
}

templ historieListBody(vm HistorieListVM) {
	@components.AppShell("zeit", nil, nil, historieListOuter(vm))
}

templ historieListOuter(vm HistorieListVM) {
	<div id="content"
		hx-get="/ui/historie/list"
		hx-trigger="sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted, sse:node.created, sse:dayoff.changed"
		hx-swap="innerHTML">
		@HistorieListFragment(vm)
	</div>
	<script src={ AssetURL("js/historie-select.js") } defer></script>
}

// HistorieListFragment is the paginated flat list inner content: the "‹ Zeit"
// spine + pagehead, the Kalender/Liste toggle, and the .row session list.
templ HistorieListFragment(vm HistorieListVM) {
	<div class="narrow">
		<div class="spine">
			<div class="up">
				<a href="/zeit">{ components.T(ctx, "zeit.back") }</a>
			</div>
		</div>
		<div class="pagehead">
			<span class="eyebrow">{ components.T(ctx, "historie.eyebrow") }</span>
			<h1>{ components.T(ctx, "historie.title") }</h1>
		</div>
		if vm.Err != "" {
			<p class="alert-err" role="alert">{ vm.Err }</p>
		}
		<div class="sect-h" style="flex-wrap:wrap;row-gap:10px">
			@historieSeg([]components.SegOption{
				{Key: "cal", LabelKey: "historie.calendar", Href: "/historie?view=cal&cal=week"},
				{Key: "list", LabelKey: "historie.list", Href: "/historie?view=list"},
			}, "list")
			<button type="button" data-select-toggle
				data-label-select={ components.T(ctx, "historie.select") }
				data-label-done={ components.T(ctx, "historie.selectDone") }
				class="btn btn-q btn-s ml-auto">
				<span aria-hidden="true">▎</span> { components.T(ctx, "historie.select") }
			</button>
		</div>
		if vm.Empty {
			<p class="text-sm text-faint" style="margin-top:16px">{ components.T(ctx, "historie.empty") }</p>
		} else {
			<ul>
				for _, row := range vm.Rows {
					@historieSessionRow(row)
				}
			</ul>
			@components.Pagination(vm.Page)
		}
		@HistorieSelectionBarC(vm.Nodes, "list")
		@historieEditDialog(vm.Nodes)
	</div>
}

// historieSessionRow is one Lesesaal .row session row (calendar agenda + flat
// list): .led-when (Von–Bis) · .grow (Title · Tags/Note fallback) · .right .v
// (Dauer). Replaces components.SessionRow (Kristall: rounded-2xl card chrome
// + a per-project glyph tile — Farb-Gesetz §7 keeps project color out of
// anything but the avatar, and this row carries none). The checkbox keeps its
// exact .chk/.row-chk classes and the <li data-session-id> + literal
// "border-dashed" marker on unassigned rows, both load-bearing for
// historie-select.js (idForRow/li[data-session-id] unassigned-select scan).
templ historieSessionRow(row components.SessionRowVM) {
	<li class={ "row", templ.KV("border-dashed border-faint", row.Unassigned) } data-session-id={ row.ID }>
		<input type="checkbox" class={ "chk row-chk", templ.KV("hidden", !row.Selectable) }
			aria-label={ row.Title + " " + row.TimeRange }/>
		<span class="led-when">{ row.TimeRange }</span>
		<div class="grow">
			<div class={ "t", templ.KV("text-muted", row.Unassigned) }>{ row.Title }</div>
			if sub := zeitLedgerSub(row.Tags); sub != "" {
				<div class="s">{ sub }</div>
			}
		</div>
		<div class="right"><div class="v">{ row.Duration }</div></div>
	</li>
}

// ── Shared: selection bar + single-edit dialog ───────────────────────────────

// historieActionBar is the Lesesaal .panel/.btn sticky bulk-action bar,
// replacing components.SelectionActionBar (Kristall: rounded-3xl glass
// shadow-lift). SelectionActionBar has zero other callers after this task
// (verified via rg), so nothing downstream depends on its chrome. All
// data-attrs / the hidden ids/projectId/newProject fields / the ConfirmDialog
// wiring are unchanged so historie-select.js keeps driving it untouched.
templ historieActionBar(vm components.SelectionBarVM) {
	<div id="actionBar" class="hidden fixed inset-x-0 bottom-0 md:bottom-5 z-50 px-3 md:pl-[260px] md:pr-6">
		<div class="mx-auto md:mx-0 max-w-[1100px] panel p-3 sm:p-3.5">
			<form id={ vm.Picker.FormID } method="post" class="contents">
				<input type="hidden" name="ids" data-bulk-ids value=""/>
				<input type="hidden" name="projectId" data-bulk-project-id value=""/>
				<input type="hidden" name="newProject" data-bulk-new-project value=""/>
			</form>
			<div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
				<span class="inline-flex items-center gap-2 rounded-xl bg-blue/10 px-3 py-2 text-[.9rem] font-semibold text-blue">
					<span aria-hidden="true">▎</span><span data-sel-count>0</span> { components.T(ctx, "historie.selectedCount") }
				</span>
				<div class="flex-1"></div>
				<div class="relative">
					<button type="button" data-assign-toggle data-assign-url={ vm.AssignURL } class="btn btn-pri btn-s">
						{ components.T(ctx, "historie.assignProject") } <span class="text-[.7rem] opacity-80" aria-hidden="true">▴</span>
					</button>
					<div data-assign-panel class="hidden absolute bottom-[calc(100%+8px)] right-0">
						@components.ProjectFuzzyPicker(vm.Picker)
					</div>
				</div>
				<button type="button" data-bulk-delete data-dialog-open="bulkDeleteConfirm" class="btn btn-q btn-s text-red">
					<span aria-hidden="true">✗</span> <span class="hidden sm:inline">{ components.T(ctx, "historie.delete") }</span>
				</button>
				<button type="button" data-bulk-cancel class="btn btn-q btn-s">{ components.T(ctx, "historie.cancel") }</button>
			</div>
		</div>
	</div>
	@components.ConfirmDialog(components.ConfirmSpec{
		ID:              "bulkDeleteConfirm",
		BodyKey:         "historie.confirmDelete",
		ConfirmLabelKey: "historie.delete",
		ConfirmAttrs: templ.Attributes{
			"type":                     "button",
			"data-bulk-delete-confirm": true,
			"data-delete-url":          vm.DeleteURL,
			"data-form-id":             vm.Picker.FormID,
		},
	})
}

// HistorieSelectionBarC wires the bulk action bar with the reassign/delete URLs
// for the active view; the selection JS fills its hidden ids field.
templ HistorieSelectionBarC(projects []components.NodePickerItem, view string) {
	@historieActionBar(HistorieSelectionBar(components.NodePickerVM{
		ID:     "historiePicker",
		Nodes:  projects,
		FormID: "historieBulkForm",
	}, view))
}

// historieEditDialog reuses /ui/worktime/edit but with hx-swap="none": the
// Historie #content already subscribes to sse:session.updated, so the fragment
// reloads itself — we must NOT inject the Heute fragment here.
templ historieEditDialog(projects []components.NodePickerItem) {
	@components.Dialog("editSession", "sessions.edit", historieEditForm(projects), false)
	// Single-session delete: the confirm posts /ui/worktime/delete, pulling the
	// sessionId/date from the edit form via hx-include; hx-swap="none" so the
	// SSE session.deleted reload (not the Heute fragment) refreshes the calendar.
	@components.ConfirmDialog(components.ConfirmSpec{
		ID:              "deleteSessionConfirm",
		ConfirmLabelKey: "historie.delete",
		ConfirmAttrs: templ.Attributes{
			"hx-post":           "/ui/worktime/delete",
			"hx-include":        "[data-edit-form]",
			"hx-swap":           "none",
			"type":              "button",
			"data-dialog-close": true,
		},
	})
}

templ historieEditForm(projects []components.NodePickerItem) {
	<form hx-post="/ui/worktime/edit" hx-swap="none" data-edit-form class="space-y-4">
		<input type="hidden" name="sessionId" data-edit-field-id value=""/>
		<input type="hidden" name="date" data-edit-field-date value=""/>
		<label class="block">
			<span class="eyebrow">{ components.T(ctx, "sessions.project") }</span>
			<select name="node" data-edit-field-project class="field mt-1">
				<option value="">{ components.T(ctx, "historie.unassigned") }</option>
				for _, p := range projects {
					<option value={ p.ID }>{ p.Name }</option>
				}
			</select>
		</label>
		<div class="grid grid-cols-2 gap-3">
			<label class="block">
				<span class="eyebrow">{ components.T(ctx, "sessions.start") }</span>
				<input type="time" name="from" data-edit-field-from class="field mt-1 font-mono tnum"/>
			</label>
			<label class="block">
				<span class="eyebrow">{ components.T(ctx, "sessions.stop") }</span>
				<input type="time" name="to" data-edit-field-to class="field mt-1 font-mono tnum"/>
			</label>
		</div>
		<label class="block">
			<span class="eyebrow">{ components.T(ctx, "sessions.tag") }</span>
			<input name="tag" data-edit-field-tag class="field mt-1"/>
		</label>
		<label class="block">
			<span class="eyebrow">{ components.T(ctx, "sessions.note") }</span>
			<textarea name="note" data-edit-field-note rows="2" class="field mt-1 resize-none"></textarea>
		</label>
		<div class="flex items-center justify-between gap-2">
			<button type="button" data-dialog-open="deleteSessionConfirm" class="btn btn-q btn-s text-red">{ components.T(ctx, "historie.delete") }</button>
			<div class="flex items-center gap-2">
				<button type="button" data-dialog-close class="btn btn-q btn-s">{ components.T(ctx, "common.cancel") }</button>
				@components.Button(components.BtnPrimary, components.T(ctx, "sessions.save"), "", templ.Attributes{"type": "submit", "data-dialog-close": true})
			</div>
		</div>
	</form>
}
