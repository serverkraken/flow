package components

// BrandMark renders the faceted hexagon SVG logo. sizeClass is applied to the
// <svg> element (e.g. "h-9 w-9"). idSuffix must be unique per page instance
// (e.g. "d" for desktop, "m" for mobile) to avoid duplicate gradient ids.
templ BrandMark(sizeClass string, idSuffix string) {
	<svg viewBox="0 0 34 34" aria-hidden="true" class={ sizeClass }>
		<defs>
			<linearGradient id={ "brandgrad-" + idSuffix } x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="rgb(var(--grad-a))"></stop>
				<stop offset="1" stop-color="rgb(var(--grad-b))"></stop>
			</linearGradient>
		</defs>
		<polygon points="17,2 31,9.5 31,24.5 17,32 3,24.5 3,9.5" fill={ "url(#brandgrad-" + idSuffix + ")" } opacity=".92"></polygon>
		<path d="M17,2 L17,32 M3,9.5 L31,24.5 M31,9.5 L3,24.5" stroke="rgb(var(--canvas))" stroke-width="1" opacity=".4"></path>
	</svg>
}

// AppShell is the responsive page chrome: desktop sidebar (md+), mobile top
// bar, mobile bottom-tab, and a main column with optional breadcrumb + subnav
// slots above the content. Any slot component may be nil.
templ AppShell(active string, breadcrumb, subnav, content templ.Component) {
	// ── Desktop sidebar (md+) ──
	<aside class="hidden md:flex md:flex-col fixed inset-y-0 left-0 w-[248px] bg-surface/80 backdrop-blur-xl border-r border-line z-40">
		<div class="px-6 pt-7 pb-6 flex items-center justify-between">
			<a href="/" class="inline-flex items-center gap-2.5" aria-label={ T(ctx, "app.name") }>
				@BrandMark("h-9 w-9", "d")
				<span class="font-display text-[1.45rem] font-semibold tracking-tight">{ T(ctx, "app.name") }</span>
			</a>
			@ThemeToggle()
		</div>
		@SiteNav(active)
		<div class="px-3 pb-5">
			<form action="/auth/logout" method="post" hx-boost="false">
				<button class="w-full text-left flex items-center gap-3 rounded-xl px-3.5 py-2 text-[.85rem] text-muted hover:bg-sunken hover:text-ink transition-colors">
					<span class="w-5 text-center text-faint" aria-hidden="true">›</span> { T(ctx, "nav.logout") }
				</button>
			</form>
		</div>
	</aside>
	// ── Mobile top bar ──
	<header class="md:hidden sticky top-0 z-40 bg-canvas/85 backdrop-blur-xl border-b border-line">
		<div class="flex items-center justify-between px-4 h-14">
			<a href="/" class="inline-flex items-center gap-2" aria-label={ T(ctx, "app.name") }>
				@BrandMark("h-7 w-7", "m")
				<span class="font-display text-xl font-semibold tracking-tight">{ T(ctx, "app.name") }</span>
			</a>
			@ThemeToggle()
		</div>
	</header>
	// ── Main column ──
	<main class="md:pl-[248px] pb-28 md:pb-12">
		<div class="mx-auto w-full max-w-[1340px] px-4 sm:px-6 lg:px-10 pt-6 md:pt-9">
			if breadcrumb != nil {
				@breadcrumb
			}
			if subnav != nil {
				@subnav
			}
			@content
		</div>
	</main>
	// ── Mobile bottom-tab ──
	<nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-surface/90 backdrop-blur-xl border-t border-line" aria-label={ T(ctx, "nav.primary") }>
		<ul class="grid grid-cols-4">
			for _, l := range PrimaryNav() {
				<li>
					if l.Key == active {
						<a href={ templ.SafeURL(l.Href) } aria-current="page" class="flex flex-col items-center gap-0.5 py-2.5 text-blue">
							<span class="text-[1.1rem] leading-none" aria-hidden="true">{ l.Glyph }</span>
							<span class="text-[.66rem] font-medium">{ T(ctx, l.LabelKey) }</span>
						</a>
					} else {
						<a href={ templ.SafeURL(l.Href) } class="flex flex-col items-center gap-0.5 py-2.5 text-muted hover:text-ink transition-colors">
							<span class="text-[1.1rem] leading-none" aria-hidden="true">{ l.Glyph }</span>
							<span class="text-[.66rem] font-medium">{ T(ctx, l.LabelKey) }</span>
						</a>
					}
				</li>
			}
			// 4th cell: "More" — opens the utility drawer
			<li>
				<button type="button" data-dialog-open="more-menu"
					class="w-full flex flex-col items-center gap-0.5 py-2.5 text-muted hover:text-ink transition-colors">
					<span class="text-[1.1rem] leading-none" aria-hidden="true">≡</span>
					<span class="text-[.66rem] font-medium">{ T(ctx, "nav.more") }</span>
				</button>
			</li>
		</ul>
	</nav>
	// ── Mobile "More" utility drawer (bottom-sheet, mobile-only) ──
	<dialog id="more-menu" aria-modal="true" aria-label={ T(ctx, "nav.more") }
		class="fixed inset-x-0 bottom-0 m-0 w-full rounded-t-3xl border-t border-line bg-surface text-ink p-0 shadow-lift backdrop:bg-ink/40">
		<div class="flex items-center justify-between px-5 pt-4 pb-3 border-b border-line2">
			<span class="font-display text-base font-semibold">{ T(ctx, "nav.more") }</span>
			<button type="button" data-dialog-close aria-label={ T(ctx, "common.close") }
				class="flex items-center justify-center w-8 h-8 rounded-full text-muted hover:text-ink hover:bg-sunken transition-colors text-[.9rem]">✕</button>
		</div>
		<div class="py-2">
			for _, l := range SecondaryNav() {
				<a href={ templ.SafeURL(l.Href) } data-dialog-close
					class="flex items-center gap-3 px-5 py-3 text-[.95rem] font-medium text-body hover:bg-sunken hover:text-ink transition-colors">
					<span class="w-5 text-center text-faint" aria-hidden="true">{ l.Glyph }</span>
					{ T(ctx, l.LabelKey) }
				</a>
			}
		</div>
	</dialog>
	<script src="/static/js/dialog.js" defer></script>
}
