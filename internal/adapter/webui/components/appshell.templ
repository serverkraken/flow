package components

// BrandMark: schlichte Lesesaal-Wortbild-Raute in Akzent (Gradient tot, Spec §15).
templ BrandMark(sizeClass string) {
	<svg viewBox="0 0 24 24" aria-hidden="true" class={ sizeClass }>
		<g fill="none" stroke="rgb(var(--accent))" stroke-width="1.6" stroke-linejoin="round">
			<path d="M12 3l7 4v10l-7 4-7-4V7z"></path>
			<path d="M12 3v18M5 7l7 4 7-4" opacity=".5"></path>
		</g>
	</svg>
}

// AppShell ist die Lesesaal-Topbar-Shell (Spec §5): Wortmarke · drei Bereiche ·
// Suche (⌘K) · Timer-Pill · Avatar-Menü. Kein Seitenbaum, keine Bottom-Tabs.
// Signatur bleibt stabil — Seiten-Caller sind unberührt.
// areaStripeClass bildet den Bereich auf seinen Ton ab. Die Klassen stehen
// ausgeschrieben da (nicht zusammengesetzt), damit der Tailwind-Scanner sie
// findet — dieselbe Konvention wie überall sonst im Repo.
func areaStripeClass(active string) string {
	switch AreaFor(active) {
	case "docs":
		return "bg-blue"
	case "zeit":
		return "bg-live"
	case "projekte":
		return "bg-amber"
	default:
		return "bg-accent"
	}
}

// AppShell ist die Karteikasten-Hülle: links die 264px-Schiene, rechts die
// Arbeitsfläche. Die Topbar ist entfallen — laut Konzept 02 ist die Schiene
// das GANZE Navigationsmodell, es gibt keine zweite Hierarchie.
//
// Die Signatur bleibt unverändert, damit keine der aufrufenden Seiten
// angefasst werden muss; der Umbau bleibt dadurch auf diese eine Datei
// beschränkt.
// stripeClass wählt den Ton des Ebenenstreifens: eine ausdrücklich
// übergebene Ebenenfarbe (Engagement/Vorhaben/Repo, oder ein Bereichston)
// schlägt die Ableitung aus dem active-Schlüssel. Die Klassen stehen
// ausgeschrieben da, damit der Tailwind-Scanner sie findet.
func stripeClass(active, ebeneColor string) string {
	switch ebeneColor {
	case "amber":
		return "bg-amber"
	case "violet":
		return "bg-violet"
	case "steel":
		return "bg-steel"
	case "blue":
		return "bg-blue"
	case "live":
		return "bg-live"
	case "green":
		return "bg-green"
	case "accent":
		return "bg-accent"
	}
	return areaStripeClass(active)
}

// AppShell ist die gepolsterte Fassung: der Inhalt sitzt in einer zentrierten
// Spalte mit Rand. AppShellFlush daneben ist die randlose — für die
// Dreispalter-Flächen des Karteikastens, die ihr eigenes Raster mitbringen
// und bündig an der Schiene beginnen (264px · 372px Kasten · 1fr Lesesaal).
templ AppShell(active string, breadcrumb, subnav, content templ.Component) {
	@appShellHull(active, "", false, breadcrumb, subnav, content)
}

// AppShellFlush ist die randlose Fassung für die Dreispalter-Screens: die
// Seite bringt ihr eigenes k3-cols-Raster mit, und die 372px-Kasten-Spalte
// beginnt direkt an der Schiene — so steht es im Mockup-Canvas. ebeneColor
// färbt den 3px-Streifen über der Fläche ("" = nach Bereich).
templ AppShellFlush(active string, ebeneColor string, content templ.Component) {
	@appShellHull(active, ebeneColor, true, nil, nil, content)
}

templ appShellHull(active string, ebeneColor string, flush bool, breadcrumb, subnav, content templ.Component) {
	<div class="md:grid md:min-h-screen md:grid-cols-[264px_minmax(0,1fr)]">
		<aside id="app-rail" class="hidden md:flex md:flex-col md:sticky md:top-0 md:h-screen overflow-hidden bg-panel border-r border-hairp">
			<div class="flex items-center px-6 pt-6">
				<a href="/" class="inline-flex items-center gap-2.5" aria-label={ T(ctx, "app.name") }>
					@BrandMark("h-5 w-5")
					<span class="font-display text-[19px] font-bold tracking-tight">{ T(ctx, "app.name") }<span class="text-accent">.</span></span>
				</a>
				<button type="button" data-dialog-open="user-menu" aria-label={ T(ctx, "nav.menu") } class="ml-auto shrink-0">
					<span class="ava ava-me av-28" style="width:26px;height:26px;border-radius:0" aria-hidden="true">{ T(ctx, "app.userInitials") }</span>
				</button>
			</div>
			<div
				id="timer-pill"
				class="px-5 pt-4"
				hx-get="/ui/timer"
				hx-trigger="load, sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted"
				hx-swap="innerHTML"
			></div>
			<button type="button" data-palette-open class="mx-6 mt-4 flex w-[calc(100%-3rem)] items-center gap-2 border-b border-ink pb-2 text-left text-[.8rem] text-faint hover:text-muted">
				<span class="flex-1">{ T(ctx, "palette.hint") }</span>
				<kbd class="font-mono text-[.68rem]">⌘K</kbd>
			</button>
			<nav class="min-h-0 flex-1 overflow-y-auto pb-3" aria-label={ T(ctx, "nav.primary") }>
				<div hx-get={ "/ui/nav/tree?active=" + active } hx-trigger="load" hx-swap="innerHTML"></div>
			</nav>
			<div class="border-t border-line2 px-6 pb-5 pt-2.5">
				for _, l := range UtilityNav() {
					<a href={ templ.SafeURL(l.Href) } class="block py-[5px] text-[13px] font-medium text-body2 hover:text-ink">{ T(ctx, l.LabelKey) }</a>
				}
				<form action="/auth/logout" method="post" hx-boost="false">
					<button class="w-full py-[5px] text-left text-[13px] font-medium text-muted hover:text-ink">{ T(ctx, "nav.logout") }</button>
				</form>
			</div>
		</aside>
		<div class="flex min-w-0 flex-col bg-canvas">
			// Ebenenstreifen: 3px, erst rechts der Schiene — die bleibt neutral.
			<div class={ "hidden md:block h-[3px] shrink-0", stripeClass(active, ebeneColor) } aria-hidden="true"></div>
			// Mobil bleibt eine schmale Kopfzeile: die Schiene ist unter 768px
			// ausgeblendet, und ohne sie käme man sonst nirgendwo hin.
			<header class="sticky top-0 z-40 border-b border-hair bg-paper/90 backdrop-blur-sm md:hidden">
				<div class="flex h-[54px] items-center gap-3 px-4">
					<a href="/" class="inline-flex items-center gap-2" aria-label={ T(ctx, "app.name") }>
						@BrandMark("h-5 w-5")
						<span class="font-display text-[17px] font-bold tracking-tight">{ T(ctx, "app.name") }<span class="text-accent">.</span></span>
					</a>
					<div class="flex-1"></div>
					<button type="button" data-palette-open aria-label={ T(ctx, "palette.open") } class="text-[17px] text-muted">⌕</button>
					<button type="button" data-dialog-open="mobile-nav" aria-label={ T(ctx, "nav.primary") } class="font-mono text-[16px] leading-none text-ink">☰</button>
				</div>
			</header>
			<main class="flex flex-1 flex-col pb-16 md:pb-0">
				if flush {
					// Bündig: die Seite bringt ihr eigenes Raster mit, die
					// Kasten-Spalte beginnt ohne Polster an der Schiene.
					@content
				} else {
					<div class="mx-auto w-full max-w-[1140px] px-4 pt-6 sm:px-7 md:pt-8">
						if breadcrumb != nil {
							@breadcrumb
						}
						if subnav != nil {
							@subnav
						}
						@content
					</div>
				}
			</main>
		</div>
	</div>
	// Avatar-Menü: Werkzeuge + Abmelden (ersetzt Sidebar-Sekundärnav + More-Drawer)
	<dialog id="user-menu" aria-modal="true" aria-labelledby="user-menu-title"
		class="fixed m-0 mt-[64px] ml-auto mr-4 w-[240px] rounded-[14px] border border-hair2 bg-surface text-ink p-0 shadow-lift backdrop:bg-ink/20">
		<div class="px-4 pt-3 pb-2 border-b border-hair">
			<span id="user-menu-title" class="eyebrow">{ T(ctx, "nav.menu") }</span>
		</div>
		<div class="py-1.5">
			for _, l := range UtilityNav() {
				<a href={ templ.SafeURL(l.Href) } data-dialog-close class="block px-4 py-2.5 text-[14px] font-medium text-body hover:bg-wash hover:text-ink">{ T(ctx, l.LabelKey) }</a>
			}
			<form action="/auth/logout" method="post" hx-boost="false" class="border-t border-hair mt-1.5 pt-1.5">
				<button class="w-full text-left px-4 py-2.5 text-[14px] font-medium text-meta hover:bg-wash hover:text-ink">{ T(ctx, "nav.logout") }</button>
			</form>
		</div>
	</dialog>
	// Mobile-Nav (Burger-Fix 2026-07-05): die drei Bereiche unter 620px, wenn sie
	// nicht mehr in die Topbar-Zeile passen (Mockup-Lücke bei 375px).
	<dialog id="mobile-nav" aria-modal="true" aria-labelledby="mobile-nav-title"
		class="fixed m-0 mt-[54px] ml-4 mr-auto w-[240px] rounded-[14px] border border-hair2 bg-surface text-ink p-0 shadow-lift backdrop:bg-ink/20">
		<div class="px-4 pt-3 pb-2 border-b border-hair">
			<span id="mobile-nav-title" class="eyebrow">{ T(ctx, "nav.primary") }</span>
		</div>
		<div class="py-1.5">
			for _, l := range PrimaryNav() {
				if l.Key == AreaFor(active) {
					<a aria-current="page" href={ templ.SafeURL(l.Href) } data-dialog-close class="block px-4 py-2.5 text-[14px] font-medium text-ink bg-wash">{ T(ctx, l.LabelKey) }</a>
				} else {
					<a href={ templ.SafeURL(l.Href) } data-dialog-close class="block px-4 py-2.5 text-[14px] font-medium text-body hover:bg-wash hover:text-ink">{ T(ctx, l.LabelKey) }</a>
				}
			}
		</div>
	</dialog>
	@PaletteDialog()
	<script src={ AssetURL("js/dialog.js") } defer></script>
	// railnav.js statt Inline-Skript im Fragment: htmx läuft hier mit
	// allowScriptTags = false, ein Skript im nachgeladenen Baum würde nie
	// ausgeführt (und die Schiene klappte lautlos nicht auf).
	<script src={ AssetURL("js/railnav.js") } defer></script>
}
