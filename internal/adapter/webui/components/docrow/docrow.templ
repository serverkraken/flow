// Package docrow is the ONE shared list row (TOKENS.md Katalog 3.10): a
// type marker, a linked title with an origin/meta line, and a right-hand
// date column — the building block ~20 screens reuse instead of rolling
// their own list markup. Deliberately has no i18n dependency: callers
// compose already-localized strings (Title/Meta/Date) before building a Row.
package docrow

import "github.com/serverkraken/flow/internal/adapter/webui/components"

// Row is one list row. TypeColor is a Karteikasten card-type tone name
// (purple|teal|blue|red|accent|live|green — TOKENS.md Kartentypen); "" draws
// no marker and falls back to the ocher accent for the Auswahlkante. Date is
// pre-formatted (internal/timefmt.Staffel) — docrow only lays it out. Preview
// is an optional clamped body-text snippet (a few lines) below Meta — most
// screens leave it empty; a document list that shows content previews sets it.
type Row struct {
	Href, Title, TypeGlyph, TypeColor, Meta, Date, Preview string
	Selected                                               bool
}

// typeMarkerClass colors the row's type marker glyph, spelled out per case (not
// string-concatenated) so the Tailwind scanner finds every literal it needs —
// mirrors cockpitAccent/heuteTileClass/crumbLevel. The row's wash and
// Auswahlkante are NOT here: those come from the stylesheet's Tint-Hover rules
// via data-tint, so hover and selection stay one rule across every screen.
func typeMarkerClass(color string) string {
	switch color {
	case "purple":
		return "text-purple"
	case "teal":
		return "text-teal"
	case "cyan":
		return "text-cyan"
	case "blue":
		return "text-blue"
	case "red":
		return "text-red"
	case "live":
		return "text-live"
	case "green":
		return "text-green"
	case "violet":
		return "text-violet"
	case "steel":
		return "text-steel"
	case "amber":
		return "text-amber"
	default:
		return "text-accent"
	}
}

// rowClass carries only layout and the transparent Auswahlkante — the wash and
// the kante's color come from the stylesheet via data-tint (hover) and
// data-tint-on (selected), so both states stay one rule for every screen.
func rowClass() string {
	return "flex items-start gap-3 border-l-[3px] border-transparent px-4 py-[11px] border-b border-line last:border-b-0"
}

// Item renders one row. The title links to Href when set; an unset Href
// renders plain text (a non-interactive summary row) rather than a dead
// empty-href anchor.
templ Item(r Row) {
	<div class={ rowClass() } data-tint={ components.Tint(r.TypeColor) } data-tint-on?={ r.Selected }>
		if r.TypeGlyph != "" {
			<span class={ "shrink-0 text-[12.5px]", typeMarkerClass(r.TypeColor) } aria-hidden="true">{ r.TypeGlyph }</span>
		}
		<span class="min-w-0 flex-1">
			if r.Href != "" {
				<a href={ templ.SafeURL(r.Href) } class="block truncate text-[13.5px] font-semibold text-ink hover:underline">{ r.Title }</a>
			} else {
				<span class="block truncate text-[13.5px] font-semibold text-ink">{ r.Title }</span>
			}
			if r.Meta != "" {
				<span class="mt-0.5 block truncate text-[11px] text-faint">{ r.Meta }</span>
			}
			if r.Preview != "" {
				<span class="preview-clamp mt-1.5 block whitespace-pre-line text-[12px] leading-relaxed text-muted">{ r.Preview }</span>
			}
		</span>
		<span class="tnum shrink-0 text-right text-[11px] text-muted" aria-hidden="true">{ r.Date }</span>
	</div>
}
