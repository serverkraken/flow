package components

// onTrackPill maps the on-track flag onto its pill chrome + glyph.
func onTrackPillClass(onTrack bool) string {
	if onTrack {
		return "bg-green/10 text-green"
	}
	return "bg-orange/10 text-orange"
}

func onTrackGlyph(onTrack bool) string {
	if onTrack {
		return "▲"
	}
	return "▼"
}

func onTrackKey(onTrack bool) string {
	if onTrack {
		return "kennzahlen.ontrack"
	}
	return "kennzahlen.behind"
}

func balanceHue(pos bool) string {
	if pos {
		return "green"
	}
	return "orange"
}

// KennzahlenPanel renders the week summary metrics (ported from
// studio-worktime-week.html KENNZAHLEN panel): Schnitt/Ziele/Saldo tiles, the
// pace-dot strip, and an "auf Kurs" / "Rückstand" status pill.
templ KennzahlenPanel(vm KennzahlenVM) {
	<article class="rounded-3xl glass shadow-soft p-6">
		<div class="flex items-center justify-between mb-4">
			<h2 class="font-display text-lg font-semibold">{ T(ctx, "kennzahlen.title") }</h2>
			<span class={ "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[.72rem] font-semibold", onTrackPillClass(vm.OnTrack) }>
				<span aria-hidden="true">{ onTrackGlyph(vm.OnTrack) }</span> { T(ctx, onTrackKey(vm.OnTrack)) }
			</span>
		</div>
		<div class="grid grid-cols-2 gap-3">
			@StatTile("kennzahlen.avg", vm.AvgPerDay, "ink")
			@StatTile("kennzahlen.goals", itoa(vm.GoalsHit)+" / "+itoa(vm.GoalsTotal), "green")
			<div class="col-span-2">
				@StatTile("kennzahlen.balance", vm.Balance, balanceHue(vm.BalancePos))
			</div>
		</div>
		<div class="mt-5 flex items-center justify-center rounded-2xl bg-sunken/60 px-4 py-3">
			@PaceDots(vm.Dots)
		</div>
	</article>
}
