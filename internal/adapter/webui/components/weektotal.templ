package components

// WeekTotalBanner renders the WOCHE GESAMT signature banner: the big mono total
// over its target plus a variant-colored ProgressBar (ported from
// studio-worktime-week.html WOCHE GESAMT banner).
templ WeekTotalBanner(vm WeekTotalVM) {
	<article class="relative overflow-hidden rounded-3xl glass shadow-lift p-6 sm:p-7">
		<div class="flex items-center justify-between gap-3">
			<p class="eyebrow uppercase text-[.7rem] font-semibold text-muted">{ T(ctx, "week.total") }</p>
		</div>
		<div class="mt-3">
			<div class="font-mono font-medium tnum text-ink leading-none text-[2.7rem] sm:text-[3rem]">{ vm.Total }</div>
			<p class="mt-1.5 text-[.9rem] text-muted">
				{ T(ctx, "week.target") } <span class="font-mono tnum text-body font-medium">{ vm.Target }</span> · { T(ctx, "week.weekdays") }
			</p>
		</div>
		<div class="mt-5">
			@ProgressBar(vm.Pct, vm.Variant)
		</div>
	</article>
}
