package components

type Backlink struct {
	ID    string
	Type  string
	Path  string
	Title string
}

templ Backlinks(items []Backlink) {
	<aside class="rounded-2xl glass p-4 shadow-soft">
		<h2 class="mb-3 font-display text-base font-semibold text-ink">{ T(ctx, "wissen.backlinks") }</h2>
		if len(items) == 0 {
			<p class="text-[.84rem] text-muted">{ T(ctx, "wissen.backlinks.empty") }</p>
		} else {
			<ul class="divide-y divide-line2">
				for _, item := range items {
					<li class="py-2 first:pt-0 last:pb-0">
						<a href={ templ.SafeURL("/wissen/" + item.ID) } class="group block">
							<span class="block truncate text-[.88rem] font-medium text-ink group-hover:text-blue">{ item.Title }</span>
							if item.Path != "" {
								<span class="mt-0.5 block truncate font-mono text-[.74rem] text-muted">{ item.Path }</span>
							}
							<span class="mt-1 inline-block rounded-full bg-sunken px-2 py-0.5 font-mono text-[.68rem] uppercase text-faint">{ item.Type }</span>
						</a>
					</li>
				}
			</ul>
		}
	</aside>
}
