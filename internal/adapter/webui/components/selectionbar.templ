package components

// SelectionActionBar renders the sticky bulk-selection action bar (ported from
// studio-worktime-calendar.html:993-1050). It carries the selection count, the
// embedded project fuzzy-picker behind an "assign" toggle, a danger delete that
// opens a Slice-0 ConfirmDialog (no native popups), and a cancel. The hidden
// form posts the comma-joined ids (filled by the selection JS) to AssignURL or
// DeleteURL.
templ SelectionActionBar(vm SelectionBarVM) {
	<div id="actionBar" class="hidden fixed inset-x-0 bottom-0 md:bottom-5 z-50 px-3 md:pl-[260px] md:pr-6">
		<div class="mx-auto md:mx-0 max-w-[1100px] rounded-t-3xl md:rounded-3xl glass-strong shadow-lift p-3 sm:p-3.5">
			<form id={ vm.Picker.FormID } method="post" class="contents">
				<input type="hidden" name="ids" data-bulk-ids value=""/>
				<input type="hidden" name="projectId" data-bulk-project-id value=""/>
				<input type="hidden" name="newProject" data-bulk-new-project value=""/>
			</form>
			<div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
				<span class="inline-flex items-center gap-2 rounded-xl bg-blue/10 px-3 py-2 text-[.9rem] font-semibold text-blue">
					<span aria-hidden="true">▎</span><span data-sel-count>0</span> { T(ctx, "historie.selectedCount") }
				</span>
				<div class="flex-1"></div>
				<div class="relative">
					<button type="button" data-assign-toggle data-assign-url={ vm.AssignURL }
						class="inline-flex items-center gap-2 rounded-xl bg-blue px-4 py-2.5 text-[.9rem] font-semibold text-oncolor shadow-soft hover:bg-blue/90 active:scale-[.99] transition">
						<span aria-hidden="true">◆</span> { T(ctx, "historie.assignProject") } <span class="text-[.7rem] opacity-80" aria-hidden="true">▴</span>
					</button>
					<div data-assign-panel class="hidden absolute bottom-[calc(100%+8px)] right-0">
						@ProjectFuzzyPicker(vm.Picker)
					</div>
				</div>
				<button type="button" data-bulk-delete data-dialog-open="bulkDeleteConfirm"
					class="inline-flex items-center gap-1.5 rounded-xl border border-red/40 bg-surface px-3.5 py-2.5 text-[.88rem] font-semibold text-red hover:bg-red/10 transition-colors">
					<span aria-hidden="true">✗</span> <span class="hidden sm:inline">{ T(ctx, "historie.delete") }</span>
				</button>
				<button type="button" data-bulk-cancel
					class="rounded-xl px-3 py-2.5 text-[.88rem] font-medium text-muted hover:text-ink transition-colors">{ T(ctx, "historie.cancel") }</button>
			</div>
		</div>
	</div>
	@ConfirmDialog(ConfirmSpec{
		ID:              "bulkDeleteConfirm",
		BodyKey:         "historie.confirmDelete",
		ConfirmLabelKey: "historie.delete",
		ConfirmAttrs: templ.Attributes{
			"type":                    "button",
			"data-bulk-delete-confirm": true,
			"data-delete-url":         vm.DeleteURL,
			"data-form-id":            vm.Picker.FormID,
		},
	})
}
