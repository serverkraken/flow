package components

// NavItem is one navigation destination. LabelKey is an i18n key resolved at
// render time; Glyph is a sense-bearing inline Unicode mark (aria-hidden).
type NavItem struct {
	Key, Href, LabelKey, Glyph string
}

// PrimaryNav is the locked top-level set (spec §16): Home · Wissen · Projekte.
func PrimaryNav() []NavItem {
	return []NavItem{
		{"home", "/", "nav.home", "⌂"},
		{"docs", "/wissen", "nav.wissen", "◆"},
		{"projekte", "/nodes", "nav.projects", "●"},
	}
}

// SecondaryNav is the utility set: Zeit · Frei · Export · Einstellungen.
func SecondaryNav() []NavItem {
	return []NavItem{
		{"zeit", "/zeit", "nav.zeit", "▶"},
		{"frei", "/dayoffs", "nav.dayoffs", "○"},
		{"export", "/export", "nav.export", "▰"},
		{"einstellungen", "/einstellungen", "nav.settings", "·"},
	}
}

// IsSecondaryNavKey reports whether k matches one of the SecondaryNav items.
// Used by AppShell to highlight the mobile "More" tab cell.
func IsSecondaryNavKey(k string) bool {
	for _, l := range SecondaryNav() {
		if l.Key == k {
			return true
		}
	}
	return false
}

// SiteNav renders the desktop sidebar nav list; the item matching active is
// marked aria-current and visually highlighted. Under the "projekte" item the
// sidebar injects an htmx-lazy-loaded project-tree spine.
templ SiteNav(active string) {
	<nav class="flex-1 min-h-0 overflow-y-auto px-3 space-y-1 scroll-thin" aria-label={ T(ctx, "nav.primary") }>
		for _, l := range PrimaryNav() {
			if l.Key == active {
				<a href={ templ.SafeURL(l.Href) } aria-current="page"
					class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-[.95rem] font-medium bg-blue/[.08] text-blue">
					<span class="w-5 text-center text-[.95rem]" aria-hidden="true">{ l.Glyph }</span> { T(ctx, l.LabelKey) }
				</a>
			} else {
				<a href={ templ.SafeURL(l.Href) }
					class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-[.95rem] font-medium text-body hover:bg-sunken hover:text-ink transition-colors">
					<span class="w-5 text-center text-faint" aria-hidden="true">{ l.Glyph }</span> { T(ctx, l.LabelKey) }
				</a>
			}
			if l.Key == "projekte" {
				// htmx lazy-loads the project-tree spine on every page load.
				// The /ui/nav/tree endpoint is auth-protected; unauthenticated
				// requests never reach SiteNav so the tree is always visible.
				<div
					hx-get="/ui/nav/tree"
					hx-trigger="load"
					hx-swap="innerHTML"
					class="ml-5 mt-0.5 pb-1"
				></div>
			}
		}
		<div class="my-2 border-t border-line2"></div>
		for _, l := range SecondaryNav() {
			if l.Key == active {
				<a href={ templ.SafeURL(l.Href) } aria-current="page"
					class="flex items-center gap-3 rounded-xl px-3.5 py-2 text-[.9rem] font-medium bg-blue/[.08] text-blue">
					<span class="w-5 text-center" aria-hidden="true">{ l.Glyph }</span> { T(ctx, l.LabelKey) }
				</a>
			} else {
				<a href={ templ.SafeURL(l.Href) }
					class="flex items-center gap-3 rounded-xl px-3.5 py-2 text-[.9rem] font-medium text-muted hover:bg-sunken hover:text-ink transition-colors">
					<span class="w-5 text-center text-faint" aria-hidden="true">{ l.Glyph }</span> { T(ctx, l.LabelKey) }
				</a>
			}
		}
	</nav>
}
