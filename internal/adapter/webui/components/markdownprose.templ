package components

import "html/template"

// MarkdownProse wraps sanitized markdown HTML in the shared Lesesaal prose
// container. `.prose` (web/tailwind.css, Task 1) already carries max-width
// 680px + min-width:0 — no arbitrary Tailwind utilities needed here anymore.
templ MarkdownProse(html template.HTML) {
	<div class="prose">
		@templ.Raw(string(html))
	</div>
}
