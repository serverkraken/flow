package components

// StyleguidePage is the /ui showcase: it renders every Slice-0 component inside
// the real Base + AppShell chrome (so the theme toggle and offline assets are
// exercised end-to-end), in a single page that reads in both themes.
templ StyleguidePage() {
	@Base("Design-System", styleguideBody())
}

templ styleguideBody() {
	@AppShell("home", nil, styleguideSubnav(), styleguideContent())
}

templ styleguideSubnav() {
	@TabStrip([]Tab{
		{Key: "today", Href: "/", LabelKey: "nav.today"},
		{Key: "week", Href: "/woche", LabelKey: "nav.week"},
		{Key: "history", Href: "/historie", LabelKey: "nav.history"},
		{Key: "frei", Href: "/dayoffs", LabelKey: "nav.dayoffs"},
	}, "today")
}

templ styleguideContent() {
	@Breadcrumb([]Crumb{{Href: "/", Label: "flow"}, {Label: T(ctx, "styleguide.title")}})
	<header class="mb-8">
		<p class="eyebrow uppercase text-[.72rem] font-semibold text-blue mb-1">{ T(ctx, "styleguide.subtitle") }</p>
		<h1 class="font-display text-[2rem] sm:text-[2.5rem] font-semibold leading-none tracking-tight">{ T(ctx, "styleguide.title") }</h1>
	</header>
	// Buttons
	@Card("mb-6", sgButtons())
	// Badges + Chips
	@Card("mb-6", sgBadgesChips())
	// StatTiles
	@Card("mb-6", sgStatTiles())
	// EmptyState
	@Card("mb-6", sgEmpty())
	// Dialogs
	@Card("mb-6", sgDialogs())
	// Pagination (middle page so both edges enabled)
	@Card("mb-6", sgPagination())
	// Kristall identity intro
	@Card("mb-6", sgKristallIntro())
	// Token swatches
	@Card("mb-6", sgTokenSwatches())
	// Glass project-cards (CardCorner)
	@Card("mb-6", sgKristallCards())
	// Brand mark at two sizes
	@Card("mb-6", sgBrandMark())
}

templ sgButtons() {
	<h2 class="font-display text-lg font-semibold mb-4">Buttons</h2>
	<div class="flex flex-wrap items-center gap-3">
		@Button(BtnPrimary, T(ctx, "common.save"), "✓", nil)
		@Button(BtnSecondary, T(ctx, "common.edit"), "", nil)
		@Button(BtnGhost, T(ctx, "common.cancel"), "", nil)
		@Button(BtnDanger, T(ctx, "common.delete"), "■", nil)
		@IconButton("✚", T(ctx, "common.new"), nil)
	</div>
}

templ sgBadgesChips() {
	<h2 class="font-display text-lg font-semibold mb-4">Badges &amp; Chips</h2>
	<div class="flex flex-wrap items-center gap-3">
		@Badge(KindDaily)
		@Badge(KindProject)
		@Badge(KindFree)
		@Badge(KindAgent)
		@Chip("flow", "blue")
		@Chip("homelab", "teal")
		@Chip("serverkraken", "purple")
		@Tag("rebuild")
	</div>
}

templ sgStatTiles() {
	<h2 class="font-display text-lg font-semibold mb-4">StatTiles</h2>
	<div class="grid grid-cols-3 gap-3">
		@StatTile("nav.today", "5h 42m", "")
		@StatTile("nav.week", "32h 10m", "")
		@StatTile("nav.stats", "6 ▲", "green")
	</div>
}

templ sgEmpty() {
	<h2 class="font-display text-lg font-semibold mb-4">EmptyState</h2>
	@EmptyState("·", "empty.default", "empty.default")
}

templ sgDialogs() {
	<h2 class="font-display text-lg font-semibold mb-4">Dialoge</h2>
	<div class="flex flex-wrap items-center gap-3">
		@Button(BtnSecondary, T(ctx, "common.edit"), "", templ.Attributes{"data-dialog-open": "sgEditDlg", "type": "button"})
		@Button(BtnDanger, T(ctx, "common.delete"), "■", templ.Attributes{"data-dialog-open": "sgDelDlg", "type": "button"})
	</div>
	@Dialog("sgEditDlg", "common.edit", templ.Raw(`<p class="text-[.9rem] text-body">Beispiel-Dialoginhalt.</p>`))
	@ConfirmDialog(ConfirmSpec{
		ID:           "sgDelDlg",
		ConfirmAttrs: templ.Attributes{"type": "button", "data-dialog-close": true},
	})
}

templ sgPagination() {
	<h2 class="font-display text-lg font-semibold mb-4">Pagination</h2>
	@Pagination(PageNav{Page: 2, Total: 95, PageSize: 20, BaseHref: "/ui"})
}

// ── Kristall identity sections ──────────────────────────────────────────────

templ sgKristallIntro() {
	<p class="text-body">Kristall — Twilight-Backdrop, Glas-Karten, farbige Projekt-Ecke. Toggle oben rechts für Hell/Dunkel.</p>
}

templ sgTokenSwatches() {
	<h2 class="font-display text-lg font-semibold mb-4">Token-Swatches</h2>
	<div class="grid grid-cols-5 gap-3">
		@sgSwatch("canvas")
		@sgSwatch("surface")
		@sgSwatch("sunken")
		@sgSwatch("line")
		@sgSwatch("ink")
		@sgSwatch("body")
		@sgSwatch("muted")
		@sgSwatch("faint")
		@sgSwatch("blue")
		@sgSwatch("cyan")
		@sgSwatch("green")
		@sgSwatch("purple")
		@sgSwatch("magenta")
		@sgSwatch("yellow")
		@sgSwatch("orange")
		@sgSwatch("red")
		@sgSwatch("teal")
	</div>
}

templ sgSwatch(token string) {
	<div>
		<div class="h-8 rounded-lg border border-line" style={ "background-color: rgb(var(--" + token + "))" } aria-hidden="true"></div>
		<p class="text-xs text-center mt-1 text-muted">{ token }</p>
	</div>
}

templ sgKristallCards() {
	<h2 class="font-display text-lg font-semibold mb-4">Glas-Projektkarten</h2>
	<div class="grid grid-cols-2 gap-4">
		@CardCorner("blue", "") {
			<h3 class="font-semibold text-ink">Kunde A</h3>
			<p class="text-sm text-muted">Engagement</p>
			<p class="text-sm text-body mt-2">Backend-Entwicklung für Q3-Lieferung.</p>
		}
		@CardCorner("green", "") {
			<h3 class="font-semibold text-ink">Kunde B</h3>
			<p class="text-sm text-muted">Engagement</p>
			<p class="text-sm text-body mt-2">Infrastruktur-Modernisierung laufend.</p>
		}
		@CardCorner("purple", "") {
			<h3 class="font-semibold text-ink">Projekt X</h3>
			<p class="text-sm text-muted">Engagement</p>
			<p class="text-sm text-body mt-2">Design-System-Aufbau abgeschlossen.</p>
		}
		@CardCorner("cyan", "") {
			<h3 class="font-semibold text-ink">Projekt Y</h3>
			<p class="text-sm text-muted">Engagement</p>
			<p class="text-sm text-body mt-2">Migrations-Plan in Abstimmung.</p>
		}
	</div>
}

templ sgBrandMark() {
	<h2 class="font-display text-lg font-semibold mb-4">Brand-Mark</h2>
	<div class="flex items-center gap-4">
		<div class="flex flex-col items-center gap-2">
			@BrandMark("h-10 w-10", "sg1")
			<p class="text-xs text-muted">h-10 w-10</p>
		</div>
		<div class="flex flex-col items-center gap-2">
			@BrandMark("h-6 w-6", "sg2")
			<p class="text-xs text-muted">h-6 w-6</p>
		</div>
	</div>
}
