package components

// Empty is a no-op placeholder component — for call sites (mostly tests) that
// need a templ.Component argument but have no content to render.
templ Empty() {
}

// Base is the shared HTML hull with live-sync (SSE) enabled — the default for
// every authenticated page.
templ Base(title string, body templ.Component) {
	@baseHull(title, true, body)
}

// BaseNoSSE is the hull WITHOUT the SSE connection — for pre-auth pages
// (logout landing, OIDC-callback errors) where /api/v1/events would 401 and
// retry pointlessly (K5 A2).
templ BaseNoSSE(title string, body templ.Component) {
	@baseHull(title, false, body)
}

// baseHull is the full HTML hull every page renders inside. It loads only
// local assets (app.css, vendored htmx, vendored fonts), fixes data-theme to
// light before first paint (Lesesaal Spec §6/§7 — Dunkel-Zwilling returns in
// L7), optionally wires the SSE body connection, and exposes a client-side
// live timer. The page-specific markup is passed as body.
templ baseHull(title string, sse bool, body templ.Component) {
	<!DOCTYPE html>
	<html lang="de" class="scroll-smooth">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>flow · { title }</title>
			<link rel="stylesheet" href={ AssetURL("app.css") }/>
			<link rel="stylesheet" href={ AssetURL("chroma.css") }/>
			<link rel="preload" as="font" type="font/woff2" href={ AssetURL("fonts/SchibstedGrotesk-Variable.woff2") } crossorigin/>
			<link rel="preload" as="font" type="font/woff2" href={ AssetURL("fonts/JetBrainsMono-Variable.woff2") } crossorigin/>
			// htmx-Härtung (Lesesaal L3 Task 9, Codex #12): a <script> BEFORE
			// htmx.min.js can't set window.htmx.config yet (not loaded), so the
			// hardening travels as a <meta> htmx reads on load instead — no
			// timing problem, no extra inline script (CSP-friendly).
			<meta name="htmx-config" content="{&#34;allowEval&#34;:false,&#34;allowScriptTags&#34;:false,&#34;selfRequestsOnly&#34;:true,&#34;includeIndicatorStyles&#34;:false}"/>
			<script src={ AssetURL("vendor/htmx.min.js") } defer></script>
			<script src={ AssetURL("vendor/htmx-ext-sse.js") } defer></script>
			<script src={ AssetURL("scrollspy.js") } defer></script>
			<script src={ AssetURL("toc.js") } defer></script>
			// No-flash theme init: Lesesaal fixes light as home (Spec §6/§7).
			// The dark twin returns in L7 with its own toggle. nonce matches the
			// Content-Security-Policy(-Report-Only) script-src (Task 9).
			<script nonce={ CSPNonce(ctx) }>document.documentElement.setAttribute('data-theme','light');</script>
		</head>
		<body class="font-sans text-ink antialiased selection:bg-accent-wash selection:text-ink"
			if sse {
				hx-ext="sse" sse-connect="/api/v1/events"
			}
		>
			@body
			// Client-side live timer: advances every [data-timer]/[data-mini-timer]
			// independently of htmx fragment refreshes. Multi-instance: several
			// [data-timer] elements can coexist (a page hero clock in #content, the
			// always-present shell widget clock, the mobile chip's embedded dialog
			// copy) and must tick independently rather than sharing one binding —
			// otherwise whichever element querySelector finds first "wins" and the
			// others freeze. Each element reads its own base elapsed (data-base,
			// seconds) and tracks its own bind moment (dataset.boundStart).
			<script nonce={ CSPNonce(ctx) }>
				(function () {
					var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					function p(n) { return n < 10 ? '0' + n : '' + n; }
					// (Re)bind every [data-timer] element. Must run again after every htmx
					// swap: a start/stop/error can replace #content, the widget mount, or
					// the chip's embedded dialog copy with a NEW [data-timer] node. An
					// element that survives a swap untouched (same DOM node) already has
					// dataset.boundStart and keeps ticking from it; a genuinely new node
					// has none yet and gets a fresh bind moment.
					function bind() {
						document.querySelectorAll('[data-timer]').forEach(function (el) {
							if (!el.dataset.boundStart) el.dataset.boundStart = Date.now();
						});
						tick();
					}
					function tick() {
						var timers = document.querySelectorAll('[data-timer]');
						var minis = document.querySelectorAll('[data-mini-timer]');  // re-query each tick/swap
						var mh, mm, ms;
						timers.forEach(function (el) {
							// Absolute anchor wins (data-since = unix epoch of the effective
							// start): every surface computes floor(now)-since and flips on
							// the SAME wall-clock second. The relative data-base+boundStart
							// path drifts up to ~1s between surfaces (data-base truncates the
							// sub-second phase; boundStart differs per render) — kept only as
							// fallback for anchors without an epoch (e.g. styleguide demo).
							var since = parseInt(el.getAttribute('data-since') || '0', 10);
							var elapsed;
							if (since > 0) {
								elapsed = Math.max(0, Math.floor(Date.now() / 1000) - since);
							} else {
								var base = parseInt(el.getAttribute('data-base') || '0', 10);
								elapsed = base + Math.floor((Date.now() - el.dataset.boundStart) / 1000);
							}
							var h = Math.floor(elapsed / 3600);
							var m = Math.floor((elapsed % 3600) / 60);
							var s = elapsed % 60;
							el.textContent = el.getAttribute('data-timer-fmt') === 'clock'
								? p(h) + ':' + p(m) + ':' + p(s)
								: h + 'h ' + p(m) + 'm ' + p(s) + 's';
							if (mh === undefined) { mh = h; mm = m; ms = s; }  // first bound timer feeds the mini(s)
						});
						if (minis.length && mh !== undefined) {
							minis.forEach(function (el) { el.textContent = p(mh) + ':' + p(mm) + ':' + p(ms); });
						}
					}
					bind();
					setInterval(tick, reduce ? 60000 : 1000);
					document.body.addEventListener('htmx:afterSwap', bind);
				})();
			</script>
		</body>
	</html>
}
