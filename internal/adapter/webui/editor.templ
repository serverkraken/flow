package webui

import (
	"html/template"

	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

templ MarkdownPreview(html template.HTML) {
	@components.MarkdownProse(html)
}

templ EditorPage(vm EditorVM) {
	@components.Base("wissen", editorBody(vm))
}

// editorBody mounts mermaid-init.js (Task 4) once, outside the htmx-swapped
// #preview fragment, so the Editor-Vorschau renders Mermaid-Fences as a
// figure too (like the document page) — the script's own htmx:afterSwap
// listener re-scans for pre.mermaid on every keyup-triggered preview update.
templ editorBody(vm EditorVM) {
	@components.AppShell("docs", components.Breadcrumb(editorCrumbs(ctx, vm)), nil, editorOuter(vm))
	<script src={ AssetURL("js/mermaid-init.js") } defer data-v={ AssetVersion() }></script>
	<script src={ AssetURL("js/editor-insert.js") } defer data-v={ AssetVersion() }></script>
	<script src={ AssetURL("js/editor-metadata.js") } defer data-v={ AssetVersion() }></script>
	// Modus und Werkzeug-Band: Rich Text ist Standard (eine Fläche), Markdown
	// ist der Umschalter — erst dort Quelle und Vorschau nebeneinander. Die
	// Wahl merkt sich der Browser.
	<script src={ AssetURL("js/editor-mode.js") } defer data-v={ AssetVersion() }></script>
	// Der Stift: Milkdown ersetzt die Textarea, sobald es geladen ist, und
	// schreibt bei jeder Änderung Markdown hinein. Fällt das Bundle aus,
	// bleibt die Textarea bedienbar. type="module": das Bundle ist ESM, und
	// ein src-Skript braucht unter der erzwingenden CSP keine Nonce.
	<link rel="stylesheet" href={ AssetURL("vendor/milkdown/editor.min.css") } data-v={ AssetVersion() }/>
	<script type="module" src={ AssetURL("vendor/milkdown/editor.min.js") } data-v={ AssetVersion() }></script>
}

// editorOuter ist die Karte beim Schreiben (Screens 11/16): Titel als
// Überschrift, darunter eine Zeile Typ · Register · Pfad · Tags, dann das
// Werkzeug-Band mit dem Umschalter Rich Text | Markdown, dann der Stift.
// Kein Formular-Stapel — das Formular ist die Karte.
templ editorOuter(vm EditorVM) {
	if vm.Editing() {
		@components.ConfirmDialog(components.ConfirmSpec{
			ID:              "del-" + vm.ID,
			TitleKey:        "wissen.delete.title",
			BodyKey:         "wissen.delete.body",
			ConfirmLabelKey: "common.delete",
			ConfirmAttrs: templ.Attributes{
				"hx-post":   "/wissen/" + vm.ID + "/delete",
				"hx-target": "body",
				"type":      "button",
			},
		})
	}
	<form action={ templ.SafeURL(vm.Action()) } method="post" class="editor-page" data-document-metadata>
		<div class="editor-head">
			<div class="flex items-baseline justify-between gap-4">
				<span class="eyebrow">{ components.T(ctx, vm.HeadingKey()) }</span>
				<span class="flex items-center gap-3 text-[12.5px]">
					if vm.Editing() {
						<button type="button" class="text-muted hover:text-ink" data-dialog-open={ "del-" + vm.ID }>{ components.T(ctx, "common.delete") }</button>
						<a href={ templ.SafeURL("/wissen/" + vm.ID) } class="text-muted underline underline-offset-2 hover:text-ink">{ components.T(ctx, "common.cancel") }</a>
					} else {
						<a href="/wissen" class="text-muted underline underline-offset-2 hover:text-ink">{ components.T(ctx, "common.cancel") }</a>
					}
					@components.Button(components.BtnPrimary, components.T(ctx, "common.save"), "", templ.Attributes{"type": "submit"})
				</span>
			</div>
			if vm.Err != "" {
				<p class="alert-err mt-3" role="alert">{ vm.Err }</p>
			}
			<input type="text" name="title" value={ vm.Title } class="field editor-title" placeholder={ components.T(ctx, "editor.title.placeholder") } autocomplete="off"/>
			<div class="editor-meta">
				<label class="editor-meta-item">
					<span>{ components.T(ctx, "wissen.type") }</span>
					<select name="type" class="field field-inline" data-document-type>
						for _, option := range vm.TypeOptions {
							<option value={ option.Value } selected?={ option.Value == vm.Type }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="editor-meta-item" data-metadata-field="project" hidden?={ !vm.ShowsProject() }>
					<span>{ components.T(ctx, "wissen.project") }</span>
					<select name="projectId" class="field field-inline" data-document-project disabled?={ !vm.ShowsProject() } required?={ vm.Type == "project" }>
						<option value="">{ components.T(ctx, "wissen.project.none") }</option>
						for _, option := range vm.ProjectOptions {
							<option value={ option.Value } selected?={ option.Value == vm.NodeID }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="editor-meta-item" data-metadata-field="date" hidden?={ !vm.Daily() }>
					<span>{ components.T(ctx, "wissen.date") }</span>
					<input type="date" name="date" value={ vm.Date } class="field field-inline" data-document-date disabled?={ !vm.Daily() } required?={ vm.Daily() }/>
				</label>
				<label class="editor-meta-item" data-metadata-field="path" hidden?={ vm.Daily() }>
					<span>{ components.T(ctx, "wissen.path") }</span>
					<input type="text" name="path" value={ vm.Path } class="field field-inline font-mono" data-document-path disabled?={ vm.Daily() } required?={ !vm.Daily() }/>
				</label>
				<span class="editor-meta-item" data-metadata-field="derived-path" hidden?={ !vm.Daily() } title={ components.T(ctx, "wissen.path.dailyHint") }>
					<span>{ components.T(ctx, "wissen.path.derived") }</span>
					<code class="font-mono text-ink" data-derived-path>{ vm.Path }</code>
				</span>
				<label class="editor-meta-item">
					<span>{ components.T(ctx, "wissen.tags") }</span>
					<input type="text" name="tags" value={ vm.TagsCSV } placeholder="go tui postgres" class="field field-inline"/>
				</label>
			</div>
			if vm.Editing() {
				// Im Bearbeiten-Modus lernt die Vorschau und der Artefakt-Picker den
				// Knoten der Karte nur über dieses Feld (Spec §13).
				<input type="hidden" name="node" value={ vm.NodeID }/>
			}
		</div>
		@editorBand(vm)
		// Kein <label> um Band und Stift: ein Klick in ein Label aktiviert dessen
		// erstes bedienbares Kind — den ersten Knopf des Bands.
		<div class="editor-body" data-editor-field data-editor-body data-mode="rich">
			// Die Figuren-Beschriftungen des Stifts (Abb. n · …) kommen aus
			// demselben Katalog wie die der Leseansicht.
			<textarea id="editor-body" name="body"
				class="field editor-source"
				data-fig-label={ components.T(ctx, "document.figure.label") }
				data-mermaid-label={ components.T(ctx, "document.figure.mermaid") }
				data-unresolved-label={ components.T(ctx, "document.figure.unresolved") }
				hx-post="/wissen/preview"
				hx-include="[name=projectId], [name=node]"
				hx-trigger="keyup changed delay:400ms, load, flow:preview"
				hx-target="#preview"
				hx-swap="innerHTML">{ vm.Body }</textarea>
			// Die Vorschau ist die Wahrheit des Servers (RenderDocument) — auf der
			// Lesefläche, nicht im Kasten, und nur im Markdown-Modus zu sehen.
			<section class="editor-preview bg-canvas" data-preview-pane>
				<div class="mb-4 flex items-baseline border-b border-line2 pb-2.5">
					<span class="eyebrow">{ components.T(ctx, "wissen.preview") }</span>
				</div>
				<div id="preview">
					@MarkdownPreview(vm.PreviewHTML)
				</div>
			</section>
		</div>
		<p class="mt-2 text-[11.5px] text-faint">{ components.T(ctx, "editor.hint") }</p>
	</form>
}

// editorBand ist das Band über dem Stift (Mockup 11/16). Blöcke und
// Auszeichnungen trägt der Stift selbst (Crepe: „/"-Menü, Auswahl-Werkzeuge,
// Block-Griff); hier stehen nur, was flow dazugibt — Bild (Artefakt) und
// [[Verweis]] über die Picker — und rechts der Modus. Das Band klebt oben.
templ editorBand(vm EditorVM) {
	<div class="editor-band panel" role="toolbar" aria-label={ components.T(ctx, "editor.band") }>
		<span class="text-[11.5px] text-faint"><kbd class="font-mono">/</kbd> { components.T(ctx, "editor.band.slash") }</span>
		<div class="insert-picker-anchor" data-insert-anchor data-insert-target="editor-body">
			<button type="button" class="band-btn"
				data-insert-toggle="insert-picker-artefakte"
				hx-get="/ui/editor/artefakte"
				hx-include="[name=node], [name=projectId]"
				hx-params="projectId,node"
				hx-target="#insert-picker-artefakte-results"
				hx-swap="innerHTML"
				hx-trigger="click"
				title={ components.T(ctx, "editor.insertArtifact") }>
				{ components.T(ctx, "editor.band.image") }
			</button>
			@components.InsertPicker(components.InsertPickerVM{
				ID:         "insert-picker-artefakte",
				ResultsID:  "insert-picker-artefakte-results",
				Endpoint:   "/ui/editor/artefakte",
				FilterKey:  "editor.insertArtifact.filter",
				EmptyKey:   "editor.insertArtifact.empty",
				QueryParam: "aq",
				Params:     "projectId,node,aq",
				Include:    "[name=node], [name=projectId]",
			})
		</div>
		<div class="insert-picker-anchor" data-insert-anchor data-insert-target="editor-body">
			<button type="button" class="band-btn font-mono"
				data-insert-toggle="insert-picker-seiten"
				hx-get="/ui/editor/seiten"
				hx-params="none"
				hx-target="#insert-picker-seiten-results"
				hx-swap="innerHTML"
				hx-trigger="click"
				title={ components.T(ctx, "editor.insertPage") }>
				[[{ components.T(ctx, "editor.band.link") }]]
			</button>
			@components.InsertPicker(components.InsertPickerVM{
				ID:         "insert-picker-seiten",
				ResultsID:  "insert-picker-seiten-results",
				Endpoint:   "/ui/editor/seiten",
				FilterKey:  "editor.insertPage.filter",
				EmptyKey:   "editor.insertPage.empty",
				QueryParam: "q",
				Params:     "q",
			})
		</div>
		<span class="flex-1"></span>
		<div class="seg seg-sm" role="group" aria-label={ components.T(ctx, "editor.mode") } data-editor-mode-seg>
			<button type="button" class="px-3 py-1" data-editor-mode-set="rich" aria-pressed="true">{ components.T(ctx, "editor.mode.rich") }</button>
			<button type="button" class="px-3 py-1" data-editor-mode-set="markdown" aria-pressed="false">{ components.T(ctx, "editor.mode.markdown") }</button>
		</div>
	</div>
}

