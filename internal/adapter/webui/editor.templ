package webui

import (
	"html/template"

	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

templ MarkdownPreview(html template.HTML) {
	@components.MarkdownProse(html)
}

templ EditorPage(vm EditorVM) {
	@components.Base("wissen", editorBody(vm))
}

// editorBody mounts mermaid-init.js (Task 4) once, outside the htmx-swapped
// #preview fragment, so the Editor-Vorschau renders Mermaid-Fences as a
// figure too (like the document page) — the script's own htmx:afterSwap
// listener re-scans for pre.mermaid on every keyup-triggered preview update.
templ editorBody(vm EditorVM) {
	@components.AppShell("docs", components.Breadcrumb(editorCrumbs(ctx, vm)), nil, editorOuter(vm))
	<script src={ AssetURL("js/mermaid-init.js") } defer data-v={ AssetVersion() }></script>
	<script src={ AssetURL("js/editor-insert.js") } defer data-v={ AssetVersion() }></script>
	<script src={ AssetURL("js/editor-metadata.js") } defer data-v={ AssetVersion() }></script>
}

templ editorOuter(vm EditorVM) {
	<div class="pagehead" style="display:flex;align-items:flex-end;gap:20px;flex-wrap:wrap">
		<div style="flex:1;min-width:0">
			<span class="eyebrow">{ components.T(ctx, "nav.knowledge") }</span>
			<h1>{ components.T(ctx, vm.HeadingKey()) }</h1>
		</div>
		if vm.Editing() {
			<div class="flex items-center gap-3">
				<button type="button" class="btn btn-q btn-s" data-dialog-open={ "del-" + vm.ID }>
					{ components.T(ctx, "common.delete") }
				</button>
				<a href={ templ.SafeURL("/wissen/" + vm.ID) } class="text-[.8rem] text-muted underline underline-offset-2 hover:text-ink">
					{ components.T(ctx, "common.cancel") }
				</a>
			</div>
		} else {
			<a href="/wissen" class="text-[.8rem] text-muted underline underline-offset-2 hover:text-ink">
				{ components.T(ctx, "common.cancel") }
			</a>
		}
	</div>
	if vm.Editing() {
		@components.ConfirmDialog(components.ConfirmSpec{
			ID:              "del-" + vm.ID,
			TitleKey:        "wissen.delete.title",
			BodyKey:         "wissen.delete.body",
			ConfirmLabelKey: "common.delete",
			ConfirmAttrs: templ.Attributes{
				"hx-post":   "/wissen/" + vm.ID + "/delete",
				"hx-target": "body",
				"type":      "button",
			},
		})
	}
	if vm.Err != "" {
		<p class="mb-5 rounded-lg bg-danger/10 px-4 py-3 text-[.9rem] font-medium text-danger" role="alert">{ vm.Err }</p>
	}
	<div class="grid gap-6 lg:grid-cols-2 lg:items-start">
		<form action={ templ.SafeURL(vm.Action()) } method="post" class="panel p-5" data-document-metadata>
			<div class="grid gap-4 sm:grid-cols-2">
				<label class="block">
					<span class="mb-1 block text-[.78rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.type") }</span>
					<select name="type" class="field" data-document-type>
						for _, option := range vm.TypeOptions {
							<option value={ option.Value } selected?={ option.Value == vm.Type }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="block" data-metadata-field="project" hidden?={ !vm.ShowsProject() }>
					<span class="mb-1 block text-[.78rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.project") }</span>
					<select name="projectId" class="field" data-document-project disabled?={ !vm.ShowsProject() } required?={ vm.Type == "project" }>
						<option value="">{ components.T(ctx, "wissen.project.none") }</option>
						for _, option := range vm.ProjectOptions {
							<option value={ option.Value } selected?={ option.Value == vm.NodeID }>{ option.Label }</option>
						}
					</select>
				</label>
			</div>
			<label class="mt-4 block" data-metadata-field="date" hidden?={ !vm.Daily() }>
				<span class="mb-1 block text-[.78rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.date") }</span>
				<input type="date" name="date" value={ vm.Date } class="field" data-document-date disabled?={ !vm.Daily() } required?={ vm.Daily() }/>
			</label>
			<label class="mt-4 block" data-metadata-field="path" hidden?={ vm.Daily() }>
				<span class="mb-1 block text-[.78rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.path") }</span>
				<input type="text" name="path" value={ vm.Path } class="field font-mono" data-document-path disabled?={ vm.Daily() } required?={ !vm.Daily() }/>
			</label>
			<div class="mt-4 rounded-lg border border-line bg-sunken px-4 py-3" data-metadata-field="derived-path" hidden?={ !vm.Daily() }>
				<span class="mb-1 block text-[.72rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.path.derived") }</span>
				<code class="text-[.86rem] text-ink" data-derived-path>{ vm.Path }</code>
				<p class="mt-1 text-[.78rem] text-muted">{ components.T(ctx, "wissen.path.dailyHint") }</p>
			</div>
			<label class="mt-4 block">
				<span class="mb-1 block text-[.78rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.title.field") }</span>
				<input type="text" name="title" value={ vm.Title } class="field"/>
			</label>
			<label class="mt-4 block">
				<span class="mb-1 block text-[.78rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.tags") }</span>
				<input type="text" name="tags" value={ vm.TagsCSV }
					placeholder="go tui postgres"
					class="field"/>
			</label>
			if vm.Editing() {
				// Edit mode disables the type/path fields and shows no
				// projectId select at all (Editing()'s node never changes
				// here) — a hidden field is the only way the preview POST
				// and the Artefakt-picker's own hx-get learn the doc's node
				// (Task 6: Preview-Node-Kontext, Spec §13 Pflicht-Testfall).
				<input type="hidden" name="node" value={ vm.NodeID }/>
			}
			<label class="mt-4 block">
				<span class="mb-1 block text-[.78rem] font-semibold uppercase text-muted">{ components.T(ctx, "wissen.body") }</span>
				<div class="editor-toolbar">
					<div class="insert-picker-anchor" data-insert-anchor data-insert-target="editor-body">
						<button type="button" class="btn btn-q btn-s"
							data-insert-toggle="insert-picker-artefakte"
							hx-get="/ui/editor/artefakte"
							hx-include="[name=node], [name=projectId]"
							hx-params="projectId,node"
							hx-target="#insert-picker-artefakte-results"
							hx-swap="innerHTML"
							hx-trigger="click">
							{ components.T(ctx, "editor.insertArtifact") }
						</button>
						@components.InsertPicker(components.InsertPickerVM{
							ID:         "insert-picker-artefakte",
							ResultsID:  "insert-picker-artefakte-results",
							Endpoint:   "/ui/editor/artefakte",
							FilterKey:  "editor.insertArtifact.filter",
							EmptyKey:   "editor.insertArtifact.empty",
							QueryParam: "aq",
							Params:     "projectId,node,aq",
							Include:    "[name=node], [name=projectId]",
						})
					</div>
					<div class="insert-picker-anchor" data-insert-anchor data-insert-target="editor-body">
						<button type="button" class="btn btn-q btn-s"
							data-insert-toggle="insert-picker-seiten"
							hx-get="/ui/editor/seiten"
							hx-params="none"
							hx-target="#insert-picker-seiten-results"
							hx-swap="innerHTML"
							hx-trigger="click">
							{ components.T(ctx, "editor.insertPage") }
						</button>
						@components.InsertPicker(components.InsertPickerVM{
							ID:         "insert-picker-seiten",
							ResultsID:  "insert-picker-seiten-results",
							Endpoint:   "/ui/editor/seiten",
							FilterKey:  "editor.insertPage.filter",
							EmptyKey:   "editor.insertPage.empty",
							QueryParam: "q",
							Params:     "q",
						})
					</div>
				</div>
				<textarea id="editor-body" name="body"
					class="field h-[60vh] min-h-96 font-mono"
					hx-post="/wissen/preview"
					hx-include="[name=projectId], [name=node]"
					hx-trigger="keyup changed delay:400ms, load"
					hx-target="#preview"
					hx-swap="innerHTML">{ vm.Body }</textarea>
			</label>
			<div class="mt-5 flex justify-end">
				@components.Button(components.BtnPrimary, components.T(ctx, "common.save"), "", templ.Attributes{"type": "submit"})
			</div>
		</form>
		// Die Vorschau liegt auf der LESEFLÄCHE, nicht in einem Kasten: sie
		// verspricht "so wird es aussehen", und dieses Versprechen bricht
		// schon an der Fläche, wenn sie auf Kastenfarbe in einer gerundeten
		// Box sitzt, während der Artikel auf dem Lesesaal-Papier steht
		// (Soenne, Punkt g). Renderer und Maße sind ohnehin dieselben —
		// components.MarkdownProse für beide.
		<section class="bg-canvas">
			<div class="mb-4 border-b border-line2 pb-2.5">
				<span class="eyebrow">{ components.T(ctx, "wissen.preview") }</span>
			</div>
			<div id="preview">
				@MarkdownPreview(vm.PreviewHTML)
			</div>
		</section>
	</div>
}
