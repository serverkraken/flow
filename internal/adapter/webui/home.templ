package webui

import "github.com/serverkraken/flow/internal/adapter/webui/components"

// HomePage is the full Home landing page on the AppShell — a pure dashboard
// (K3 Task 5): saldo tiles, burndown, activity logstream, neueste
// Wissensartikel. The K1 shell timer widget (sidebar) owns start/stop.
templ HomePage(vm HomeVM) {
	@components.Base("home", homeBody(vm))
}

templ homeBody(vm HomeVM) {
	@components.AppShell("home", nil, nil, homeOuter(vm))
}

// homeOuter is the SSE-swap container: reloads inner HomeFragment on worktime
// and document events. Uses only live event names (project.created is dead;
// the real event is node.created which is not in this trigger set).
templ homeOuter(vm HomeVM) {
	<div id="content"
		hx-get="/ui/home"
		hx-trigger="sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted, sse:settings.changed, sse:document.created, sse:document.updated, sse:document.deleted"
		hx-swap="innerHTML">
		@HomeFragment(vm)
	</div>
}

// HomeFragment is the inner content re-rendered live on SSE events and after
// every home start/stop mutation.
templ HomeFragment(vm HomeVM) {
	if vm.Err != "" {
		<p class="mb-5 rounded-2xl bg-red/10 px-4 py-3 text-[.9rem] font-medium text-red" role="alert">{ vm.Err }</p>
	}
	<div>
		<h1 class="font-display text-[2rem] sm:text-[2.5rem] font-semibold leading-none tracking-tight">{ components.T(ctx, "nav.home") }</h1>
		<p class="mt-2 text-[.92rem] text-muted">{ components.T(ctx, "home.greeting") }</p>
	</div>
	<section class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-5">
		@components.StatTileAccent("stats.tileToday", vm.TodaySaldo, vm.TodaySub, statsSaldoHue(vm.TodayPos))
		@components.StatTileAccent("stats.tileWeek", vm.WeekSaldo, vm.WeekSub, statsSaldoHue(vm.WeekPos))
		@components.StatTileAccent("stats.tileMonth", vm.MonthSaldo, vm.MonthSub, statsSaldoHue(vm.MonthPos))
	</section>
	<section class="mt-5 md:mt-6">
		@components.BurndownBanner(vm.Burndown)
	</section>
	@HomeLogstream(vm)
	if len(vm.NewestDocs) > 0 {
		<section class="mt-6">
			<h2 class="mb-3 text-[.78rem] font-semibold uppercase tracking-wide text-faint">{ components.T(ctx, "wissen.latest") }</h2>
			<ul class="divide-y divide-line2 rounded-2xl glass shadow-soft">
				for _, row := range vm.NewestDocs {
					@homeNewestDocRow(row)
				}
			</ul>
		</section>
	}
}

// HomeLogstream is the outermost logstream section — also used as the htmx
// fragment target so the section can refresh itself without reloading the page.
templ HomeLogstream(vm HomeVM) {
	<section id="logstream"
		hx-get={ "/ui/home/logstream" + vm.logQuery() }
		hx-trigger="sse:activity.logged"
		hx-swap="outerHTML"
		class="mt-6">
		@homeLogstreamInner(vm)
	</section>
}

// homeLogstreamInner renders the chip filters, actor selector, rows, and empty state.
templ homeLogstreamInner(vm HomeVM) {
	<h2 class="mb-3 text-[.78rem] font-semibold uppercase tracking-wide text-faint">{ components.T(ctx, "home.activity") }</h2>
	<div class="mb-3 flex flex-wrap items-center gap-2">
		{{ chips := []struct{ key, label, cls string }{
			{"", "activity.filter.all", ""},
			{"zeit", "activity.filter.zeit", "zeit"},
			{"wissen", "activity.filter.wissen", "wissen"},
			{"struktur", "activity.filter.struktur", "struktur"},
			{"frei", "activity.filter.frei", "frei"},
		} }}
		for _, chip := range chips {
			if vm.LogClass == chip.cls {
				<a href="#"
					hx-get={ logstreamHref(chip.cls, vm.LogActor) }
					hx-target="#logstream"
					hx-swap="outerHTML"
					class="inline-flex items-center rounded-full bg-ink px-3 py-1 text-[.8rem] font-medium text-canvas">
					{ components.T(ctx, chip.label) }
				</a>
			} else {
				<a href="#"
					hx-get={ logstreamHref(chip.cls, vm.LogActor) }
					hx-target="#logstream"
					hx-swap="outerHTML"
					class="inline-flex items-center rounded-full border border-line bg-surface px-3 py-1 text-[.8rem] font-medium text-muted hover:border-blue/40 hover:text-blue">
					{ components.T(ctx, chip.label) }
				</a>
			}
		}
		if len(vm.LogActors) > 0 {
			<select
				hx-get={ logstreamHref(vm.LogClass, "") }
				hx-include="this"
				hx-target="#logstream"
				hx-swap="outerHTML"
				name="actor"
				class="ml-2 rounded-lg border border-line bg-surface px-2 py-1 text-[.8rem] text-muted focus:border-blue/40 transition-colors">
				<option value="">{ components.T(ctx, "activity.actor.all") }</option>
				for _, actor := range vm.LogActors {
					if vm.LogActor == actor {
						<option value={ actor } selected>{ actor }</option>
					} else {
						<option value={ actor }>{ actor }</option>
					}
				}
			</select>
		}
	</div>
	if len(vm.LogEntries) == 0 {
		<p class="text-[.88rem] text-muted">{ components.T(ctx, "activity.empty") }</p>
	} else {
		<ul class="divide-y divide-line2 rounded-2xl glass shadow-soft">
			for _, row := range vm.LogEntries {
				@activityFeedRow(row, false, true)
			}
		</ul>
	}
}

// homeNewestDocRow renders one recent-knowledge card in the "Zuletzt im Wissen"
// home section. It mirrors the wissenDocRow style from wissen.templ and links
// to /wissen/{id}. The project-color corner swatch follows document.templ:52-53.
templ homeNewestDocRow(row DocRow) {
	{{ kind := rowKind(row) }}
	<li class="p-4 transition-colors hover:bg-sunken/40">
		<a href={ templ.SafeURL("/wissen/" + row.ID) } class="group flex items-start gap-3">
			<span class={ "mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border text-[.82rem]", kindToneClass(kind.Tone) } aria-hidden="true">{ kind.Glyph }</span>
			<span class="min-w-0 flex-1">
				<span class="block truncate font-medium text-ink group-hover:text-blue">{ row.Title }</span>
				if row.Path != "" {
					<span class="mt-0.5 block truncate font-mono text-[.78rem] text-muted">{ row.Path }</span>
				}
			</span>
			if row.ProjectColor != "" {
				<span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full" style={ swatchStyle(row.ProjectColor) } aria-hidden="true"></span>
			}
		</a>
	</li>
}
