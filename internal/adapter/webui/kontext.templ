package webui

import (
	"fmt"
	"strconv"

	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

// KontextPage is the Kuratieren page (Soenne-Entscheid OE #1: schlichte
// Reorder-Liste, kein Mockup) — a .narrow page belonging to the project
// context ("projekte" tab), reachable from the cockpit rail's context
// instrument panel ("Kuratieren — sortieren & pinnen ›").
templ KontextPage(vm KontextVM) {
	@components.Base("projekte", kontextBody(vm))
}

// kontextBody wires the Lesesaal AppShell around the Kuratieren fragment,
// mirroring document.templ's Base→Body→AppShell layering (KontextPage must
// not call AppShell directly — that skips the shared HTML hull, shipping
// kopfloses HTML with no app.css).
templ kontextBody(vm KontextVM) {
	@components.AppShell("projekte", nil, nil, kontextOuter(vm))
}

// kontextOuter mirrors document.templ's fragment-safe SSE pattern
// (documentOuter): #content wraps #kontext-fragment and reloads it via
// hx-get + hx-select on every document.* mutation (a pin/reorder anywhere —
// including this page's own actions on other clients — refreshes the
// ranking). hx-select extracts ONLY #kontext-fragment from the full page
// response, so the AppShell never nests inside itself.
templ kontextOuter(vm KontextVM) {
	<div
		id="content"
		hx-get={ "/kontext/" + vm.NodeID }
		hx-trigger="sse:document.updated, sse:document.created, sse:document.deleted"
		hx-select="#kontext-fragment"
		hx-target="#kontext-fragment"
		hx-swap="outerHTML"
	>
		@KontextFragment(vm)
	</div>
}

// KontextFragment is the reorder/pin round-trip's own render target: the
// pagehead, the budget-meter panel (same instrument as the cockpit rail), and
// the flat rang list in Compose fill order. Returned by the view handler AND
// both mutation handlers (reorder/pin) — never the full page — so those
// POSTs can safely target #kontext-fragment with hx-swap="outerHTML".
templ KontextFragment(vm KontextVM) {
	<div id="kontext-fragment" class="narrow">
		if vm.Err != "" {
			<p class="alert-err" role="alert">{ vm.Err }</p>
		}
		<div class="pagehead">
			<span class="eyebrow">{ components.T(ctx, "context.curate.eyebrow") }</span>
			<h1>{ vm.Title }</h1>
			<p class="sub">{ fmt.Sprintf(components.T(ctx, "context.curate.sub"), vm.Title, vm.IncludedN, vm.DroppedN) }</p>
		</div>
		<div class="sect">
			<section class="panel p-5">
				<div class={ "meter", templ.KV("full", vm.Full) } role="img" aria-label={ fmt.Sprintf(components.T(ctx, "context.meterAria"), vm.Pct) }>
					<i style={ "width:" + strconv.Itoa(vm.Pct) + "%" }></i>
				</div>
				<div class="meter-l">
					<span>{ vm.UsedStr } tk</span>
					if vm.Full {
						<span class="warn">{ components.T(ctx, "context.budgetFull") } · { vm.CapStr }</span>
					} else {
						<span>{ vm.CapStr }</span>
					}
				</div>
			</section>
		</div>
		if len(vm.Always) > 0 {
			<div class="sect">
				<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "context.curate.always") }</span></div>
				for _, a := range vm.Always {
					@kontextAlwaysRow(vm.NodeID, a)
				}
			</div>
		}
		<div class="sect">
			<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "context.rail.title") }</span></div>
			if len(vm.Rows) == 0 {
				<p class="text-sm text-faint" style="margin-top:16px">{ components.T(ctx, "context.curate.empty") }</p>
			} else {
				for _, row := range vm.Rows {
					if row.FirstDropped {
						<div class="cutline">{ components.T(ctx, "context.cutline") }</div>
					}
					@kontextRow(vm.NodeID, row)
				}
			}
		</div>
		if len(vm.Hidden) > 0 {
			<div class="sect">
				<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "context.curate.hidden") }</span></div>
				for _, h := range vm.Hidden {
					@kontextHiddenRow(vm.NodeID, h)
				}
			</div>
		}
	</div>
}

// kontextRow is one rang-list row: rang badge, type chip, title+scope+tokens,
// and the pin/reorder actions. Dropped rows (Included=false) dim via
// templ.KV("dim", ...) so the cutline visually separates them without a
// second list. All actions target #kontext-fragment (Codex-Fund #3) and send
// their document id via hx-vals (the frei.templ/heute.templ precedent for
// parameterized mutation buttons outside a <form>).
templ kontextRow(nodeID string, row KontextRowVM) {
	<div class={ "row", templ.KV("dim", !row.Included) }>
		if row.Included {
			<span class="num">{ fmt.Sprintf("%02d", row.Num) }</span>
		} else {
			<span class="num text-faint">—</span>
		}
		<span class={ "typechip", row.ChipClass }>{ row.TypeLabel }</span>
		<div class="grow">
			<a class="t" href={ templ.SafeURL("/wissen/" + row.DocID) } title={ row.Title }>{ row.Title }</a>
			<div class="s">{ row.ScopeLabel } · { fmt.Sprintf(components.T(ctx, "context.estTokens"), row.TokensStr) }</div>
		</div>
		<div class="right kontext-actions">
			<button
				type="button"
				class="btn btn-q btn-s"
				hx-post={ "/kontext/" + nodeID + "/pin" }
				hx-target="#kontext-fragment"
				hx-swap="outerHTML"
				hx-vals={ fmt.Sprintf(`{"doc":"%s"}`, row.DocID) }
				aria-label={ components.T(ctx, pinLabelKey(row.Pinned)) }
				title={ components.T(ctx, pinLabelKey(row.Pinned)) }
			>
				{ components.T(ctx, pinLabelKey(row.Pinned)) }
			</button>
			<button
				type="button"
				class="btn btn-q btn-s"
				hx-post={ "/kontext/" + nodeID + "/reorder" }
				hx-target="#kontext-fragment"
				hx-swap="outerHTML"
				hx-vals={ fmt.Sprintf(`{"doc":"%s","dir":"up"}`, row.DocID) }
				aria-label={ components.T(ctx, "context.moveUp") }
				title={ components.T(ctx, "context.moveUp") }
				disabled?={ row.IsFirst }
			>
				↑
			</button>
			<button
				type="button"
				class="btn btn-q btn-s"
				hx-post={ "/kontext/" + nodeID + "/reorder" }
				hx-target="#kontext-fragment"
				hx-swap="outerHTML"
				hx-vals={ fmt.Sprintf(`{"doc":"%s","dir":"down"}`, row.DocID) }
				aria-label={ components.T(ctx, "context.moveDown") }
				title={ components.T(ctx, "context.moveDown") }
				disabled?={ row.IsLast }
			>
				↓
			</button>
			@modeSeg("/kontext/"+nodeID+"/mode", "#kontext-fragment", row.DocID, row.Mode)
			<a
				class="btn btn-q btn-s"
				href={ templ.SafeURL("/wissen/" + row.DocID + "/bearbeiten") }
				hx-boost="false"
				aria-label={ components.T(ctx, "wissen.edit") }
				title={ components.T(ctx, "wissen.edit") }
			>
				{ components.T(ctx, "wissen.edit") }
			</a>
		</div>
	</div>
}

// kontextAlwaysRow is one Always-Tier row (Instruction/ActiveContext/immer
// memory, Mini-Task 6b + Task 4): same .row shell + type chip + title/scope/
// tokens as kontextRow, but no rank badge and no pin/↑/↓ buttons (Always-Tier
// is not curatable that way) — a dim "immer" label (document.context.always,
// reused from the document page's context-standing line) stands in their
// place. The mode switcher (Task 4) lets even an Instruction/ActiveContext be
// demoted to "nie" (OE #4/#5). Mini-Task 7c adds the same direct
// Bearbeiten-link as kontextRow — the row's remaining action.
templ kontextAlwaysRow(nodeID string, a KontextAlwaysVM) {
	<div class="row">
		<span class={ "typechip", a.ChipClass }>{ a.TypeLabel }</span>
		<div class="grow">
			<a class="t" href={ templ.SafeURL("/wissen/" + a.DocID) } title={ a.Title }>{ a.Title }</a>
			<div class="s">{ a.ScopeLabel } · { fmt.Sprintf(components.T(ctx, "context.estTokens"), a.TokensStr) }</div>
		</div>
		<div class="right kontext-actions">
			<span class="dim text-sm">{ components.T(ctx, "document.context.always") }</span>
			@modeSeg("/kontext/"+nodeID+"/mode", "#kontext-fragment", a.DocID, a.Mode)
			<a
				class="btn btn-q btn-s"
				href={ templ.SafeURL("/wissen/" + a.DocID + "/bearbeiten") }
				hx-boost="false"
				aria-label={ components.T(ctx, "wissen.edit") }
				title={ components.T(ctx, "wissen.edit") }
			>
				{ components.T(ctx, "wissen.edit") }
			</a>
		</div>
	</div>
}

// kontextHiddenRow is one row of the new "Ausgeblendet (nie)" section (Task
// 4): a nie-mode doc, dimmed via the static `dim` class (mirrors the dropped
// rang-row's Included=false treatment), with only the mode switcher (the
// in-place restore path — flipping to auto/immer moves it back into the
// composed context) and the same Bearbeiten-link as the other sections. No
// pin/↑/↓ (not curatable there either — this section only exists to make
// "nie" reversible without leaving Kuratieren).
templ kontextHiddenRow(nodeID string, h KontextHiddenVM) {
	<div class="row dim">
		<span class={ "typechip", h.ChipClass }>{ h.TypeLabel }</span>
		<div class="grow">
			<a class="t" href={ templ.SafeURL("/wissen/" + h.DocID) } title={ h.Title }>{ h.Title }</a>
			<div class="s">{ h.ScopeLabel } · { fmt.Sprintf(components.T(ctx, "context.estTokens"), h.TokensStr) }</div>
		</div>
		<div class="right kontext-actions">
			@modeSeg("/kontext/"+nodeID+"/mode", "#kontext-fragment", h.DocID, h.Mode)
			<a
				class="btn btn-q btn-s"
				href={ templ.SafeURL("/wissen/" + h.DocID + "/bearbeiten") }
				hx-boost="false"
				aria-label={ components.T(ctx, "wissen.edit") }
				title={ components.T(ctx, "wissen.edit") }
			>
				{ components.T(ctx, "wissen.edit") }
			</a>
		</div>
	</div>
}

// pinLabelKey reuses the document page's Anpinnen/Angepinnt i18n keys
// (document.pin/document.pinned — Bestand, verified reusable per the brief)
// rather than minting Kuratieren-local duplicates.
func pinLabelKey(pinned bool) string {
	if pinned {
		return "document.pinned"
	}
	return "document.pin"
}
