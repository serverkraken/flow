package webui

import "github.com/serverkraken/flow/internal/adapter/webui/components"

templ WissenPage(vm WissenVM) {
	@components.Base("wissen", wissenBody(vm))
}

templ wissenBody(vm WissenVM) {
	@components.AppShell("docs", nil, nil, wissenOuter(vm))
}

templ wissenOuter(vm WissenVM) {
	<div id="content"
		hx-get={ "/ui/wissen/list" + vm.Query }
		hx-trigger="sse:document.created, sse:document.updated, sse:document.deleted"
		hx-swap="innerHTML">
		@WissenFragment(vm)
	</div>
}

templ WissenFragment(vm WissenVM) {
	<header class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="eyebrow mb-1 text-[.72rem] font-semibold uppercase text-blue">{ components.T(ctx, "nav.knowledge") }</p>
			<h1 class="font-display text-[2rem] font-semibold leading-tight">{ components.T(ctx, "wissen.title") }</h1>
		</div>
		<a href="/wissen/neu"
			class="inline-flex items-center justify-center gap-2 rounded-2xl bg-ink px-5 py-2.5 text-[.92rem] font-semibold text-canvas shadow-soft transition hover:bg-ink/90 active:scale-[.99]">
			<span aria-hidden="true">✚</span>
			{ components.T(ctx, "common.new") }
		</a>
	</header>
	@wissenSearchBar(vm)
	@wissenTagChips(vm)
	if vm.SearchQ != "" {
		@wissenResults(vm)
	} else {
		@components.CategoryStrip(ctx, WissenTabs(vm))
		if WissenEmpty(vm) {
			@components.EmptyState("○", "wissen.empty", "wissen.emptyHint")
		} else {
			<div class="space-y-8">
				@wissenDailySection(vm)
				@wissenNotesSection(vm)
				@wissenFreeSection(vm)
				@wissenSystemSection(vm)
			</div>
			@components.Pagination(vm.Page)
		}
	}
}

templ wissenSearchBar(vm WissenVM) {
	<form method="get" action="/wissen" class="mb-3 flex flex-col gap-2 sm:flex-row">
		for _, t := range vm.ActiveTags {
			<input type="hidden" name="tag" value={ t }/>
		}
		<label class="flex-1">
			<span class="sr-only">{ components.T(ctx, "wissen.search") }</span>
			<input type="search" name="q" value={ vm.SearchQ } placeholder={ components.T(ctx, "wissen.search") }
				class="w-full rounded-2xl border border-line bg-surface px-4 py-2.5 text-[.92rem] text-ink placeholder:text-faint shadow-soft focus:border-blue/40 focus:outline-none"/>
		</label>
		@components.Button(components.BtnSecondary, components.T(ctx, "common.search"), "⌕", templ.Attributes{"type": "submit"})
	</form>
}

templ wissenTagChips(vm WissenVM) {
	if len(vm.AllTags) > 0 {
		<div class="mb-5 flex flex-wrap items-center gap-2">
			for _, chip := range vm.AllTags {
				if chip.Active {
					<a href={ templ.SafeURL(chip.Href) }
						class="inline-flex items-center gap-1.5 rounded-full bg-ink px-3 py-1 text-[.8rem] font-medium text-canvas">
						<span aria-hidden="true">#</span>{ chip.Tag }
						<span class="text-canvas/70">{ itoa(chip.Count) }</span>
					</a>
				} else {
					<a href={ templ.SafeURL(chip.Href) }
						class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 text-[.8rem] font-medium text-muted hover:border-blue/40 hover:text-blue">
						<span aria-hidden="true">#</span>{ chip.Tag }
						<span class="text-faint">{ itoa(chip.Count) }</span>
					</a>
				}
			}
			if len(vm.ActiveTags) > 0 || vm.SearchQ != "" {
				<a href="/wissen" class="ml-1 text-[.8rem] text-muted underline underline-offset-2 hover:text-ink">
					{ components.T(ctx, "wissen.resetFilters") }
				</a>
			}
		</div>
	}
}

templ wissenResults(vm WissenVM) {
	if len(vm.Results) == 0 {
		@components.EmptyState("⌕", "wissen.noresults", "wissen.noresultsHint")
	} else {
		<section aria-label={ components.T(ctx, "wissen.results") } class="rounded-2xl border border-line bg-surface shadow-soft">
			<ul class="divide-y divide-line2">
				for _, result := range vm.Results {
					<li class="p-4">
						<a href={ templ.SafeURL("/wissen/" + result.ID) } class="block hover:text-blue">
							<div class="mb-1 flex items-center justify-between gap-3">
								<span class="font-medium text-ink">{ result.Title }</span>
								<span class="shrink-0 font-mono text-[.75rem] text-faint">{ result.Type }</span>
							</div>
							if result.Path != "" {
								<div class="mb-1 font-mono text-[.78rem] text-muted">{ result.Path }</div>
							}
							<p class="text-[.88rem] leading-relaxed text-body">
								@templ.Raw(result.Snippet)
							</p>
						</a>
					</li>
				}
			</ul>
		</section>
	}
}

templ wissenDailySection(vm WissenVM) {
	@wissenFlatSection("daily-sec", "wissen.daily", vm.Daily, "")
}

templ wissenFreeSection(vm WissenVM) {
	@wissenFlatSection("free-sec", "wissen.free", vm.Free, "")
}

templ wissenSystemSection(vm WissenVM) {
	@wissenFlatSection("system-sec", "wissen.system", vm.System, "docs-system")
}

templ wissenFlatSection(id, titleKey string, rows []DocRow, extraClass string) {
	<section id={ id } class={ "scroll-mt-24", extraClass }>
		<div class="mb-3 flex items-center justify-between gap-3">
			<h2 class="font-display text-xl font-semibold text-ink">{ components.T(ctx, titleKey) }</h2>
			<span class="rounded-full bg-sunken px-2.5 py-1 text-[.76rem] text-muted">{ itoa(len(rows)) }</span>
		</div>
		if len(rows) > 0 {
			<ul class="divide-y divide-line2 rounded-2xl border border-line bg-surface shadow-soft">
				for _, row := range rows {
					@wissenDocRow(row)
				}
			</ul>
		}
	</section>
}

templ wissenNotesSection(vm WissenVM) {
	<section id="notes-sec" class="scroll-mt-24">
		<div class="mb-3 flex items-center justify-between gap-3">
			<h2 class="font-display text-xl font-semibold text-ink">{ components.T(ctx, "wissen.notes") }</h2>
			<span class="rounded-full bg-sunken px-2.5 py-1 text-[.76rem] text-muted">{ itoa(projectDocCount(vm.Notes)) }</span>
		</div>
		if len(vm.Notes) > 0 {
			<div class="space-y-4">
				for _, group := range vm.Notes {
					<article class="overflow-hidden rounded-2xl border border-line bg-surface shadow-soft" style={ swatchStyle(group.Color) }>
						<header class="flex items-center gap-3 border-b border-line2 px-4 py-3">
							<span class="grid h-8 w-8 place-items-center rounded-lg bg-sunken text-[.9rem] text-success" aria-hidden="true">{ group.Glyph }</span>
							<div class="min-w-0">
								<h3 class="truncate font-medium text-ink">{ group.Name }</h3>
								if group.ProjectID != "" {
									<p class="font-mono text-[.75rem] text-muted">{ group.ProjectID }</p>
								}
							</div>
							if group.Color != "" {
								<span class="ml-auto h-3 w-3 rounded-full border border-line" style="background-color: var(--swatch)" aria-hidden="true"></span>
							}
						</header>
						<ul class="divide-y divide-line2">
							for _, row := range group.Docs {
								@wissenDocRow(row)
							}
						</ul>
					</article>
				}
			</div>
		}
	</section>
}

templ wissenDocRow(row DocRow) {
	{{ kind := rowKind(row) }}
	<li class="p-4 transition-colors hover:bg-sunken/40">
		<a href={ templ.SafeURL("/wissen/" + row.ID) } class="group flex items-start gap-3">
			<span class={ "mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border text-[.82rem]", kindToneClass(kind.Tone) } aria-hidden="true">{ kind.Glyph }</span>
			<span class="min-w-0 flex-1">
				<span class="block truncate font-medium text-ink group-hover:text-blue">{ row.Title }</span>
				if row.Path != "" {
					<span class="mt-0.5 block truncate font-mono text-[.78rem] text-muted">{ row.Path }</span>
				}
				if len(row.Tags) > 0 {
					<span class="mt-2 flex flex-wrap gap-1.5">
						for _, tag := range row.Tags {
							<span class="rounded-full bg-sunken px-2 py-0.5 text-[.74rem] text-muted">{ "#" + tag }</span>
						}
					</span>
				}
			</span>
			<span class="mt-1 shrink-0 font-mono text-[.72rem] uppercase text-faint">{ row.Type }</span>
		</a>
	</li>
}
