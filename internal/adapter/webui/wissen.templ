package webui

import "github.com/serverkraken/flow/internal/adapter/webui/components"

templ WissenPage(vm WissenOverviewVM) {
	@components.Base("wissen", wissenBody(vm))
}

templ wissenBody(vm WissenOverviewVM) {
	@components.AppShell("docs", nil, nil, wissenOuter(vm))
}

templ wissenOuter(vm WissenOverviewVM) {
	<div id="content"
		hx-get={ "/ui/wissen/list" + vm.Query }
		hx-trigger="sse:document.created, sse:document.updated, sse:document.deleted"
		hx-swap="innerHTML">
		@WissenFragment(vm)
	</div>
}

templ WissenCategoryPage(vm WissenCategoryVM) {
	@components.Base("wissen", wissenCategoryBody(vm))
}

templ wissenCategoryBody(vm WissenCategoryVM) {
	@components.AppShell("docs", nil, nil, wissenCategoryOuter(vm))
}

templ wissenCategoryOuter(vm WissenCategoryVM) {
	<div id="content"
		hx-get={ "/ui/wissen/list/" + vm.Category.Slug + vm.Query }
		hx-trigger="sse:document.created, sse:document.updated, sse:document.deleted"
		hx-swap="innerHTML">
		@WissenCategoryFragment(vm)
	</div>
}

templ WissenFragment(vm WissenOverviewVM) {
	<header class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="eyebrow mb-1 text-[.72rem] font-semibold uppercase text-blue">{ components.T(ctx, "nav.knowledge") }</p>
			<h1 class="font-display text-[2rem] font-semibold leading-tight">{ components.T(ctx, "wissen.title") }</h1>
		</div>
		<a href="/wissen/neu"
			class="inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-green to-cyan px-5 py-2.5 text-[.92rem] font-semibold text-oncolor shadow-soft transition active:scale-[.99] cta-glow">
			<span aria-hidden="true">✚</span>
			{ components.T(ctx, "common.new") }
		</a>
	</header>
	@wissenSearchBar(vm.WissenVM)
	@wissenTagChips(vm.WissenVM)
	if vm.SearchQ != "" {
		@wissenResults(vm.WissenVM)
	} else {
		@wissenOverviewCards(vm)
	}
}

templ wissenOverviewCards(vm WissenOverviewVM) {
	<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
		for _, card := range vm.Categories {
			<a href={ templ.SafeURL(card.Href) }
				class="group flex min-h-52 flex-col rounded-2xl glass p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-blue/40 hover:shadow-lift">
				<div class="mb-4 flex items-start justify-between gap-3">
					<div>
						<h2 class="font-display text-xl font-semibold text-ink group-hover:text-blue">{ components.T(ctx, card.LabelKey) }</h2>
						<p class="mt-1 text-[.86rem] leading-relaxed text-muted">{ components.T(ctx, card.DescriptionKey) }</p>
					</div>
					<span class="rounded-full bg-sunken px-2.5 py-1 font-mono text-[.76rem] text-muted">{ itoa(card.Count) }</span>
				</div>
				if len(card.Latest) > 0 {
					<div class="mt-auto">
						<p class="mb-2 text-[.72rem] font-semibold uppercase text-faint">{ components.T(ctx, "wissen.latest") }</p>
						<ul class="space-y-2">
							for _, row := range card.Latest {
								<li class="min-w-0">
									<span class="block truncate text-[.88rem] font-medium text-body group-hover:text-ink">{ row.Title }</span>
									if row.Path != "" {
										<span class="mt-0.5 block truncate font-mono text-[.72rem] text-faint">{ row.Path }</span>
									}
								</li>
							}
						</ul>
					</div>
				} else {
					<div class="mt-auto text-[.84rem] text-faint">{ components.T(ctx, "wissen.empty") }</div>
				}
			</a>
		}
	</div>
}

templ WissenCategoryFragment(vm WissenCategoryVM) {
	<header class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="eyebrow mb-1 text-[.72rem] font-semibold uppercase text-blue">{ components.T(ctx, "nav.knowledge") }</p>
			<h1 class="font-display text-[2rem] font-semibold leading-tight">{ components.T(ctx, vm.Category.LabelKey) }</h1>
			<p class="mt-1 text-[.9rem] text-muted">{ components.T(ctx, vm.Category.DescriptionKey) }</p>
		</div>
		<a href="/wissen/neu"
			class="inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-green to-cyan px-5 py-2.5 text-[.92rem] font-semibold text-oncolor shadow-soft transition active:scale-[.99] cta-glow">
			<span aria-hidden="true">✚</span>
			{ components.T(ctx, "common.new") }
		</a>
	</header>
	@wissenCategoryNav(vm.Category.Slug)
	@wissenSearchBar(vm.WissenVM)
	@wissenTagChips(vm.WissenVM)
	if vm.SearchQ != "" {
		@wissenResults(vm.WissenVM)
	} else if vm.Total == 0 {
		@components.EmptyState("○", "wissen.empty", "wissen.emptyHint")
	} else {
		@wissenCategoryContent(vm)
		@components.Pagination(vm.Page)
	}
}

templ wissenCategoryNav(active string) {
	<nav class="mb-5 flex gap-2 overflow-x-auto" aria-label={ components.T(ctx, "wissen.categories") }>
		<a href="/wissen" class="inline-flex items-center gap-2 rounded-xl glass px-3 py-2 text-[.84rem] font-medium text-muted transition hover:border-blue/40 hover:text-blue">
			{ components.T(ctx, "wissen.overview") }
		</a>
		for _, cat := range WissenCategories() {
			<a href={ templ.SafeURL(cat.Href) } class={ wissenCategoryNavClass(active, cat.Slug) }>
				{ components.T(ctx, cat.LabelKey) }
			</a>
		}
	</nav>
}

templ wissenCategoryContent(vm WissenCategoryVM) {
	if vm.Category.ID == "projekte" {
		@wissenCategoryProjectGroups(vm)
	} else {
		<ul class="divide-y divide-line2 rounded-2xl glass shadow-soft">
			for _, row := range vm.Rows {
				@wissenDocRow(row)
			}
		</ul>
	}
}

templ wissenCategoryProjectGroups(vm WissenCategoryVM) {
	<div class="space-y-4">
		for _, group := range vm.Groups {
			<article class="overflow-hidden rounded-2xl glass shadow-soft" style={ swatchStyle(group.Color) }>
				<header class="flex items-center gap-3 border-b border-line2 px-4 py-3">
					<span class="grid h-8 w-8 place-items-center rounded-lg bg-sunken text-[.9rem] text-success" aria-hidden="true">{ group.Glyph }</span>
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2">
							<h2 class="truncate font-medium text-ink">{ group.Name }</h2>
							@nodeKindBadge(group.Kind)
						</div>
						if group.NodeID != "" {
							<p class="font-mono text-[.75rem] text-muted">{ group.NodeID }</p>
						}
					</div>
					if group.Color != "" {
						<span class="ml-auto h-3 w-3 rounded-full border border-line" style="background-color: var(--swatch)" aria-hidden="true"></span>
					}
				</header>
				<ul class="divide-y divide-line2">
					for _, row := range group.Docs {
						@wissenDocRow(row)
					}
				</ul>
			</article>
		}
	</div>
}

templ wissenSearchBar(vm WissenVM) {
	<form method="get" action={ templ.SafeURL(wissenSearchAction(vm)) } class="mb-3 flex flex-col gap-2 sm:flex-row">
		for _, t := range vm.ActiveTags {
			<input type="hidden" name="tag" value={ t }/>
		}
		<label class="flex-1">
			<span class="sr-only">{ components.T(ctx, "wissen.search") }</span>
			<input type="search" name="q" value={ vm.SearchQ } placeholder={ components.T(ctx, "wissen.search") }
				class="w-full rounded-2xl glass px-4 py-2.5 text-[.92rem] text-ink placeholder:text-faint shadow-soft focus:border-blue/40 focus:outline-none"/>
		</label>
		@components.Button(components.BtnSecondary, components.T(ctx, "common.search"), "⌕", templ.Attributes{"type": "submit"})
	</form>
}

templ wissenTagChips(vm WissenVM) {
	if len(vm.AllTags) > 0 {
		<div class="mb-5 flex flex-wrap items-center gap-2">
			for _, chip := range vm.AllTags {
				if chip.Active {
					<a href={ templ.SafeURL(chip.Href) }
						class="inline-flex items-center gap-1.5 rounded-full bg-ink px-3 py-1 text-[.8rem] font-medium text-canvas">
						<span aria-hidden="true">#</span>{ chip.Tag }
						<span class="text-canvas/70">{ itoa(chip.Count) }</span>
					</a>
				} else {
					<a href={ templ.SafeURL(chip.Href) }
						class="inline-flex items-center gap-1.5 rounded-full glass px-3 py-1 text-[.8rem] font-medium text-muted hover:border-blue/40 hover:text-blue">
						<span aria-hidden="true">#</span>{ chip.Tag }
						<span class="text-faint">{ itoa(chip.Count) }</span>
					</a>
				}
			}
			if len(vm.ActiveTags) > 0 || vm.SearchQ != "" {
				<a href={ templ.SafeURL(wissenResetHref(vm)) } class="ml-1 text-[.8rem] text-muted underline underline-offset-2 hover:text-ink">
					{ components.T(ctx, "wissen.resetFilters") }
				</a>
			}
		</div>
	}
}

templ wissenResults(vm WissenVM) {
	if len(vm.Results) == 0 {
		@components.EmptyState("⌕", "wissen.noresults", "wissen.noresultsHint")
	} else {
		<section aria-label={ components.T(ctx, "wissen.results") } class="rounded-2xl glass shadow-soft">
			<ul class="divide-y divide-line2">
				for _, result := range vm.Results {
					<li class="p-4">
						<a href={ templ.SafeURL("/wissen/" + result.ID) } class="block hover:text-blue">
							<div class="mb-1 flex items-center justify-between gap-3">
								<span class="font-medium text-ink">{ result.Title }</span>
								<span class="shrink-0 font-mono text-[.75rem] text-faint">{ result.Type }</span>
							</div>
							if result.Path != "" {
								<div class="mb-1 font-mono text-[.78rem] text-muted">{ result.Path }</div>
							}
							<p class="text-[.88rem] leading-relaxed text-body">
								@templ.Raw(result.Snippet)
							</p>
						</a>
					</li>
				}
			</ul>
		</section>
	}
}

templ wissenDailySection(vm WissenVM) {
	@wissenFlatSection("daily-sec", "wissen.daily", vm.Daily, "")
}

templ wissenFreeSection(vm WissenVM) {
	@wissenFlatSection("free-sec", "wissen.free", vm.Free, "")
}

templ wissenSystemSection(vm WissenVM) {
	@wissenFlatSection("system-sec", "wissen.system", vm.System, "docs-system")
}

templ wissenFlatSection(id, titleKey string, rows []DocRow, extraClass string) {
	<section id={ id } class={ "scroll-mt-24", extraClass }>
		<div class="mb-3 flex items-center justify-between gap-3">
			<h2 class="font-display text-xl font-semibold text-ink">{ components.T(ctx, titleKey) }</h2>
			<span class="rounded-full bg-sunken px-2.5 py-1 text-[.76rem] text-muted">{ itoa(len(rows)) }</span>
		</div>
		if len(rows) > 0 {
			<ul class="divide-y divide-line2 rounded-2xl glass shadow-soft">
				for _, row := range rows {
					@wissenDocRow(row)
				}
			</ul>
		}
	</section>
}

templ wissenDocRow(row DocRow) {
	{{ kind := rowKind(row) }}
	<li class="p-4 transition-colors hover:bg-sunken/40">
		<a href={ templ.SafeURL("/wissen/" + row.ID) } class="group flex items-start gap-3">
			<span class={ "mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border text-[.82rem]", kindToneClass(kind.Tone) } aria-hidden="true">{ kind.Glyph }</span>
			<span class="min-w-0 flex-1">
				<span class="block truncate font-medium text-ink group-hover:text-blue">{ row.Title }</span>
				if row.Path != "" {
					<span class="mt-0.5 block truncate font-mono text-[.78rem] text-muted">{ row.Path }</span>
				}
				if len(row.Tags) > 0 {
					<span class="mt-2 flex flex-wrap gap-1.5">
						for _, tag := range row.Tags {
							<span class="rounded-full bg-sunken px-2 py-0.5 text-[.74rem] text-muted">{ "#" + tag }</span>
						}
					</span>
				}
				if row.Preview != "" {
					<span class="preview-clamp mt-2 whitespace-pre-line text-[.84rem] leading-relaxed text-muted">{ row.Preview }</span>
				}
			</span>
			<span class="mt-1 shrink-0 font-mono text-[.72rem] uppercase text-faint">{ row.Type }</span>
		</a>
	</li>
}
