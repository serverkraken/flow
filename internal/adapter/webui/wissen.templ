package webui

import (
	"fmt"

	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

templ WissenPage(vm WissenOverviewVM) {
	@components.Base("wissen", wissenBody(vm))
}

templ wissenBody(vm WissenOverviewVM) {
	@components.AppShellFlush("docs", "blue", wissenOuter(vm))
}
templ wissenOuter(vm WissenOverviewVM) {
	<div id="content"
		class="flex flex-1 flex-col"
		hx-get={ "/ui/wissen/list" + vm.Query }
		hx-trigger="sse:document.created, sse:document.updated, sse:document.deleted"
		hx-swap="innerHTML">
		@WissenFragment(vm)
	</div>
	<script src={ AssetURL("js/wissen-select.js") } defer></script>
}

// WissenFragment is the Wissen library page (Mockup Z.806–843): a pagehead
// with the document-count summary, the bigsearch bar (the page's main
// door), and — outside search mode — the 7 type shelves plus the capped
// "Zuletzt aktualisiert" list. Tags stay available as a collapsed management
// filter instead of a permanent tag wall.
templ WissenFragment(vm WissenOverviewVM) {
	// Dreispalter (Screen 06): die REGALE stehen im 372px-Kasten, Suche,
	// Filter und Liste im Lesesaal. Vorher lief alles untereinander in einer
	// Spalte — das war mains Anatomie, nicht die des Karteikastens.
	<div class="k3-cols grid flex-1 lg:grid-cols-[372px_minmax(0,1fr)]">
		@wissenShelfColumn(vm)
		<div class="min-w-0 bg-canvas px-6 py-7 lg:px-14">
			// Im Tablet-Band ist die Kasten-Spalte ausgeblendet; dieser
			// Schalter schiebt sie als Overlay ein (Screen 21A).
			@components.PanelToggle("wissen.shelves", "mb-4")
			<div class="pagehead" style="display:flex;align-items:flex-end;gap:20px">
		<div style="flex:1">
			<span class="eyebrow">{ components.T(ctx, "nav.knowledge") }</span>
			<h1>{ components.T(ctx, "wissen.libraryTitle") }</h1>
			<p class="sub">{ WissenSummary(ctx, vm) }</p>
		</div>
		<a href="/wissen/artefakte" class="btn btn-q" hx-boost="false">{ components.T(ctx, "wissen.artifacts.nav") }</a>
		<button type="button" class="btn btn-q" data-wissen-select-toggle
			data-label-select={ components.T(ctx, "wissen.bulk.select") }
			data-label-done={ components.T(ctx, "wissen.bulk.done") }>{ components.T(ctx, "wissen.bulk.select") }</button>
		<a href={ templ.SafeURL(WissenNewDocumentHref("", vm.NodeParam)) } class="btn btn-q" hx-boost="false">{ components.T(ctx, "common.new") }</a>
			</div>
			@wissenManagementFilters(vm.WissenVM)
			@wissenBigsearch(vm.WissenVM)
			@wissenTagChips(vm.WissenVM)
			if vm.SearchQ != "" {
				@wissenResults(vm.WissenVM)
			} else {
				@wissenRecentSection(vm)
			}
		</div>
	</div>
	@wissenBulkActionBar()
}

// wissenShelfColumn ist die Kasten-Spalte der Bibliothek: die Regale als
// Liste, aus der man wählt (Katalog 3.13 — "Panel: Liste, aus der man
// wählt"). Auf dem Tablet-Band schiebt der PanelToggle sie ein.
templ wissenShelfColumn(vm WissenOverviewVM) {
	<div class="k3-panel flex flex-col border-b border-hairp bg-panel lg:border-b-0 lg:border-r">
		<div class="px-6 pb-2.5 pt-6">
			<span class="eyebrow">{ components.T(ctx, "wissen.shelves") }</span>
		</div>
		for _, shelf := range vm.Shelves {
			<a
				href={ templ.SafeURL(wissenShelfHref(shelf)) }
				data-tint="blue"
				class={ "flex items-baseline gap-2.5 border-b border-line border-l-[3px] border-l-transparent px-6 py-[13px] pl-[21px]",
					templ.KV("opacity-60", shelf.Count == 0) }
			>
				<span class="min-w-0 flex-1">
					<span class="block truncate text-[14.5px] font-[650] leading-[1.35] text-ink">{ components.T(ctx, shelf.LabelKey) }</span>
					<span class="mt-[3px] block truncate text-[12.5px] leading-[1.55] text-muted">{ components.T(ctx, shelf.DescKey) }</span>
				</span>
				<span class="shrink-0 font-mono text-[10px] uppercase tracking-[.1em] text-faint">{ shelf.TypeKey }</span>
				<span class="w-8 shrink-0 text-right font-mono text-[12.5px] font-semibold tnum text-ink">{ itoa(shelf.Count) }</span>
			</a>
		}
	</div>
}

// wissenBigsearch is the Wissen page's main door (Mockup Z.815–819): a plain
// GET form on /wissen (or the current shelf's href), full-text + semantic
// search underneath. The magnifier uses the named `.bigsearch .ico` class,
// deliberately NOT `.glass` — that utility collides with the Kristall glass
// primitive being swept off L3 surfaces (Codex #13).
templ wissenBigsearch(vm WissenVM) {
	<form method="get" action={ templ.SafeURL(wissenSearchAction(vm)) } class="bigsearch">
		if vm.TypeParam != "" {
			<input type="hidden" name="type" value={ vm.TypeParam }/>
		}
		for _, t := range vm.ActiveTags {
			<input type="hidden" name="tag" value={ t }/>
		}
		if vm.Status != "" && vm.Status != "active" {
			<input type="hidden" name="status" value={ vm.Status }/>
		}
		if vm.NodeParam != "" {
			<input type="hidden" name="node" value={ vm.NodeParam }/>
		}
		if vm.Scope != "" {
			<input type="hidden" name="scope" value={ vm.Scope }/>
		}
		<span class="ico" aria-hidden="true">⌕</span>
		<input type="search" name="q" value={ vm.SearchQ }
			placeholder={ components.T(ctx, wissenSearchPlaceholderKey(vm)) }
			aria-label={ components.T(ctx, wissenSearchLabelKey(vm)) }/>
		<kbd>⌘K</kbd>
	</form>
}

// wissenManagementFilters is the management surface shared by overview and
// type shelves. The status band makes archive inventory visible at a glance;
// the node selector scopes the same library without creating a second page.
templ wissenManagementFilters(vm WissenVM) {
	<div class="mb-5 border-y border-line py-3" data-wissen-status={ vm.Status }>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<nav class="seg seg-sm inline-flex" aria-label={ components.T(ctx, "wissen.status.label") }>
				<a href={ templ.SafeURL(vm.StatusActiveHref) } aria-current?={ vm.Status == "active" } class="px-3 py-1.5">
					{ fmt.Sprintf(components.T(ctx, "wissen.status.active"), vm.ActiveCount) }
				</a>
				<a href={ templ.SafeURL(vm.StatusArchivedHref) } aria-current?={ vm.Status == "archived" } class="px-3 py-1.5">
					{ fmt.Sprintf(components.T(ctx, "wissen.status.archived"), vm.ArchivedCount) }
				</a>
				<a href={ templ.SafeURL(vm.StatusAllHref) } aria-current?={ vm.Status == "all" } class="px-3 py-1.5">
					{ fmt.Sprintf(components.T(ctx, "wissen.status.all"), vm.ActiveCount + vm.ArchivedCount) }
				</a>
			</nav>
			<form method="get" action={ templ.SafeURL(vm.FilterAction) } class="flex flex-wrap items-center gap-2">
				if vm.TypeParam != "" {
					<input type="hidden" name="type" value={ vm.TypeParam }/>
				}
				if vm.Status != "" && vm.Status != "active" {
					<input type="hidden" name="status" value={ vm.Status }/>
				}
				if vm.SearchQ != "" {
					<input type="hidden" name="q" value={ vm.SearchQ }/>
				}
				<input type="hidden" name="scope" value="subtree"/>
				for _, tag := range vm.ActiveTags {
					<input type="hidden" name="tag" value={ tag }/>
				}
				<label class="text-sm text-muted" for="wissen-node-filter">{ components.T(ctx, "wissen.filter.project") }</label>
				<select id="wissen-node-filter" name="node" class="field min-w-52 py-2 text-sm">
					<option value="" selected?={ vm.NodeParam == "" }>{ components.T(ctx, "wissen.filter.allProjects") }</option>
					<option value="none" selected?={ vm.NodeParam == "none" }>{ components.T(ctx, "wissen.project.none") }</option>
					for _, option := range vm.NodeOptions {
						<option value={ option.ID } selected?={ vm.NodeParam == option.ID }>{ option.Name }</option>
					}
				</select>
				<button type="submit" class="btn btn-q btn-s">{ components.T(ctx, "wissen.filter.apply") }</button>
			</form>
		</div>
	</div>
}

// wissenShelvesSection renders the 7 type-shelves (Mockup Z.821–830) as
// Lesesaal rows: title + description, the type's mono key, and its count.
// A count of 0 is shown de-emphasized rather than hidden (Zustand "leer").
templ wissenShelvesSection(shelves []WissenShelf) {
	<div class="sect shelf">
		<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "wissen.shelves") }</span></div>
		for _, shelf := range shelves {
			<a class={ "row", templ.KV("opacity-60", shelf.Count == 0) } href={ templ.SafeURL(wissenShelfHref(shelf)) }>
				<div class="grow">
					<div class="t">{ components.T(ctx, shelf.LabelKey) }</div>
					<div class="s">{ components.T(ctx, shelf.DescKey) }</div>
				</div>
				<span class="mono">{ shelf.TypeKey }</span>
				<div class="right"><div class="v">{ itoa(shelf.Count) }</div></div>
			</a>
		}
	</div>
}

// wissenRecentSection is the "Zuletzt aktualisiert" list (Mockup Z.832–838):
// capped at wissenRecentCap, with an "Alle N ›" expand-in-place link (same
// pattern as the cockpit Wissen section's ?wissen=all) when there is more to
// show.
templ wissenRecentSection(vm WissenOverviewVM) {
	<div class="sect">
		<div class="sect-h">
			// Trägt die Liste einen Sortierschalter, heißt sie neutral
			// "Karten" — sonst behauptete die Überschrift "Zuletzt
			// aktualisiert", während nach Titel sortiert ist.
			if vm.SortSupported {
				<span class="eyebrow">{ components.T(ctx, "wissen.cards") }</span>
			} else {
				<span class="eyebrow">{ components.T(ctx, "wissen.recent") }</span>
			}
			// Der Sortierkopf sitzt in der Kopfzeile, die es schon gibt —
			// keine zweite Werkzeugleiste (Katalog 3.10). Er erscheint nur,
			// wo er auch die ganze Liste sortiert.
			if vm.SortSupported {
				@components.SortHead(vm.SortHead)
			}
			if !vm.RecentAll && vm.RecentTotal > len(vm.Recent) {
				<a class="more" href={ templ.SafeURL(wissenRecentAllHref(vm, false)) }
					hx-get={ wissenRecentAllHref(vm, true) } hx-target="#content" hx-swap="innerHTML">
					{ fmt.Sprintf(components.T(ctx, "wissen.recent.all"), vm.RecentTotal) }
				</a>
			}
		</div>
		if len(vm.Recent) == 0 {
			<p class="text-sm text-faint">{ components.T(ctx, "wissen.empty") }</p>
		} else {
			for _, row := range vm.Recent {
				@wissenRow(row)
			}
		}
		if vm.RecentAll && vm.Page.PageSize > 0 && (vm.Page.Total > 0 || vm.Page.Page > 1) {
			@components.Pagination(vm.Page)
		}
	</div>
}

// wissenRow is one Lesesaal document row shared by the "Zuletzt
// aktualisiert" list and the /wissen/typ shelf listing: the doc-type
// chip (DocTypeChipClass/DocTypeLabel, Spec §7.1), title + meta
// ("Pfad · Akteur"), and the relative update time.
templ wissenRow(row WissenRowVM) {
	<div class="row" data-wissen-row data-document-id={ row.ID } data-context-eligible={ fmt.Sprintf("%t", row.ContextEligible) } data-archived={ fmt.Sprintf("%t", row.Archived) }>
		<input type="checkbox" class="hidden h-4 w-4 shrink-0 accent-blue" data-wissen-checkbox
			aria-label={ fmt.Sprintf(components.T(ctx, "wissen.bulk.selectDocument"), row.Title) }/>
		<a class="contents" href={ templ.SafeURL("/wissen/" + row.ID) }>
			<span class={ "typechip", row.ChipClass }>{ row.ChipLabel }</span>
			if row.Archived {
				<span class="typechip border-warning/35 bg-warning/10 text-warning">{ components.T(ctx, "wissen.status.badge") }</span>
			}
			<div class="grow">
				<div class="t">{ row.Title }</div>
				<div class="s">{ row.Meta }</div>
			</div>
			<div class="right"><div class="v">{ row.TimeStr }</div></div>
		</a>
	</div>
}

// wissenTagChips lists every taggable-document tag inside a collapsed filter
// so archive management can discover tags without turning the library into a
// permanent tag wall. Active/search state opens it automatically.
templ wissenTagChips(vm WissenVM) {
	if len(vm.AllTags) > 0 {
		<details class="mb-4 border-b border-line pb-3" open?={ len(vm.ActiveTags) > 0 || vm.SearchQ != "" }>
			<summary class="cursor-pointer text-sm font-medium text-muted hover:text-ink">
				{ fmt.Sprintf(components.T(ctx, "wissen.filter.tags"), len(vm.AllTags)) }
			</summary>
			<div class="mt-3 flex flex-wrap items-center gap-2">
				for _, chip := range vm.AllTags {
					if chip.Active {
						<a href={ templ.SafeURL(chip.Href) }
							class="inline-flex items-center gap-1.5 rounded-full border border-blue/40 bg-blue/10 px-3 py-1 text-[.8rem] font-medium text-blue">
							<span aria-hidden="true">#</span>{ chip.Tag }
							<span class="text-faint">{ itoa(chip.Count) }</span>
						</a>
					} else {
						<a href={ templ.SafeURL(chip.Href) }
							class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-[.8rem] font-medium text-muted hover:border-blue/40 hover:text-blue">
							<span aria-hidden="true">#</span>{ chip.Tag }
							<span class="text-faint">{ itoa(chip.Count) }</span>
						</a>
					}
				}
				if len(vm.ActiveTags) > 0 || vm.SearchQ != "" {
					<a href={ templ.SafeURL(wissenResetHref(vm)) } class="ml-1 text-[.8rem] text-muted underline underline-offset-2 hover:text-ink">
						{ components.T(ctx, "wissen.resetFilters") }
					</a>
				}
			</div>
		</details>
	}
}

// wissenResults is the bigsearch result list, rendered as Lesesaal rows
// (replaces the old glass-card list) — the snippet carries server-escaped
// <mark> highlights (renderSnippet), rendered raw.
templ wissenResults(vm WissenVM) {
	<div class="sect">
		<div class="sect-h"><span class="eyebrow">{ components.T(ctx, "wissen.results") }</span></div>
		if len(vm.Results) == 0 {
			<p class="text-sm text-faint">{ components.T(ctx, "wissen.noresults") }</p>
		} else {
			for _, result := range vm.Results {
				<div class="row" data-wissen-row data-document-id={ result.ID } data-context-eligible={ fmt.Sprintf("%t", result.ContextEligible) } data-archived={ fmt.Sprintf("%t", result.Archived) }>
					<input type="checkbox" class="hidden h-4 w-4 shrink-0 accent-blue" data-wissen-checkbox
						aria-label={ fmt.Sprintf(components.T(ctx, "wissen.bulk.selectDocument"), result.Title) }/>
					<a class="contents" href={ templ.SafeURL("/wissen/" + result.ID) }>
						<span class={ "typechip", result.ChipClass }>{ result.ChipLabel }</span>
						if result.Archived {
							<span class="typechip border-warning/35 bg-warning/10 text-warning">{ components.T(ctx, "wissen.status.badge") }</span>
						}
						<div class="grow">
							<div class="t">{ result.Title }</div>
							if result.Path != "" {
								<div class="path">{ result.Path }</div>
							}
							<div class="s">@templ.Raw(result.Snippet)</div>
						</div>
					</a>
				</div>
			}
		}
		if vm.Page.PageSize > 0 && (vm.Page.Total > 0 || vm.Page.Page > 1) {
			@components.Pagination(vm.Page)
		}
	</div>
}

templ WissenTypePage(vm WissenTypeVM) {
	@components.Base("wissen", wissenTypeBody(vm))
}

templ wissenTypeBody(vm WissenTypeVM) {
	@components.AppShell("docs", nil, nil, wissenTypeOuter(vm))
}

templ wissenTypeOuter(vm WissenTypeVM) {
	<div id="content"
		hx-get={ "/ui/wissen/list/typ" + vm.Query }
		hx-trigger="sse:document.created, sse:document.updated, sse:document.deleted"
		hx-swap="innerHTML">
		@WissenTypeFragment(vm)
	</div>
	<script src={ AssetURL("js/wissen-select.js") } defer></script>
}

// WissenTypeFragment is one shelf's document list (/wissen/typ?type=...):
// the shelf's own title/description as pagehead, the same bigsearch (scoped
// to this shelf via wissenBaseVM's basePath), flat Lesesaal rows, and
// pagination. Replaces the old WissenCategoryFragment's project-grouped
// listing — the type-shelf page lists flat, matching every other Wissen row.
templ WissenTypeFragment(vm WissenTypeVM) {
	<div class="pagehead" style="display:flex;align-items:flex-end;gap:20px;flex-wrap:wrap">
		<div style="flex:1;min-width:0">
			<a href={ templ.SafeURL(wissenOverviewHref(vm)) } class="mb-2 inline-block text-[.8rem] text-muted underline underline-offset-2 hover:text-ink">
				{ components.T(ctx, "wissen.overview") }
			</a>
			<span class="eyebrow">{ components.T(ctx, "nav.knowledge") }</span>
			<h1>{ components.T(ctx, vm.Shelf.LabelKey) }</h1>
			<p class="sub">{ components.T(ctx, vm.Shelf.DescKey) }</p>
		</div>
		<button type="button" class="btn btn-q" data-wissen-select-toggle
			data-label-select={ components.T(ctx, "wissen.bulk.select") }
			data-label-done={ components.T(ctx, "wissen.bulk.done") }>{ components.T(ctx, "wissen.bulk.select") }</button>
		<a href={ templ.SafeURL(vm.Shelf.NewDocumentHref(vm.NodeParam)) } class="btn btn-q" hx-boost="false">{ components.T(ctx, "common.new") }</a>
	</div>
	@wissenManagementFilters(vm.WissenVM)
	@wissenBigsearch(vm.WissenVM)
	@wissenTagChips(vm.WissenVM)
	if vm.SearchQ != "" {
		@wissenResults(vm.WissenVM)
	} else if vm.Total == 0 {
		<p class="text-sm text-faint">{ components.T(ctx, "wissen.empty") }</p>
	} else {
		<div class="sect">
			for _, row := range vm.Rows {
				@wissenRow(row)
			}
		</div>
		@components.Pagination(vm.Page)
	}
	@wissenBulkActionBar()
}

templ wissenBulkActionBar() {
	<div class="hidden fixed inset-x-0 bottom-0 z-50 px-3 md:bottom-5 md:pl-[260px] md:pr-6" data-wissen-action-bar>
		<div class="mx-auto max-w-[1100px] border border-line bg-surface p-3 md:mx-0">
			<form id="wissenBulkForm" class="contents">
				<input type="hidden" name="ids" data-wissen-ids value=""/>
			</form>
			<div class="flex flex-wrap items-center gap-2.5">
				<span class="inline-flex items-center gap-2 border-l-2 border-blue bg-blue/10 px-3 py-2 text-[.9rem] font-semibold text-blue">
					<span data-wissen-count>0</span> { components.T(ctx, "wissen.bulk.selected") }
				</span>
				<div class="flex-1"></div>
				<button type="button" class="btn btn-q btn-s disabled:cursor-not-allowed disabled:opacity-40" data-wissen-submit data-wissen-action="restore"
					hx-post="/wissen/bulk" hx-include="#wissenBulkForm" hx-vals="{&quot;action&quot;:&quot;restore&quot;}" hx-swap="none">
					{ components.T(ctx, "wissen.bulk.restore") }
				</button>
				<div class="inline-flex items-center border border-line" role="group" aria-label={ components.T(ctx, "wissen.bulk.context") }>
					for _, mode := range []string{"auto", "immer", "nie"} {
						<button type="button" class="px-2.5 py-2 text-[.78rem] font-medium text-muted hover:bg-sunken hover:text-ink disabled:cursor-not-allowed disabled:opacity-40"
							data-wissen-submit data-wissen-context-action data-wissen-mode={ mode }
							hx-post="/wissen/bulk" hx-include="#wissenBulkForm" hx-vals={ fmt.Sprintf(`{"action":"mode","mode":%q}`, mode) } hx-swap="none">
							{ components.T(ctx, "context.mode." + mode) }
						</button>
					}
				</div>
				<button type="button" class="btn btn-q btn-s text-danger disabled:cursor-not-allowed disabled:opacity-40" data-wissen-submit data-wissen-action="archive" data-dialog-open="wissenBulkArchive">
					{ components.T(ctx, "wissen.bulk.archive") }
				</button>
				<button type="button" class="btn btn-q btn-s" data-wissen-cancel>{ components.T(ctx, "common.cancel") }</button>
			</div>
		</div>
	</div>
	@components.ConfirmDialog(components.ConfirmSpec{
		ID: "wissenBulkArchive", TitleKey: "wissen.bulk.archiveTitle", BodyKey: "wissen.bulk.archiveBody",
		ConfirmLabelKey: "wissen.bulk.archive",
		ConfirmAttrs: templ.Attributes{
			"type": "button", "data-wissen-submit": true, "data-wissen-action": "archive",
			"hx-post": "/wissen/bulk", "hx-include": "#wissenBulkForm",
			"hx-vals": `{"action":"archive"}`, "hx-swap": "none", "data-dialog-close": true,
		},
	})
}
