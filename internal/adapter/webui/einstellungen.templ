package webui

import (
	"strconv"

	"github.com/serverkraken/flow/internal/adapter/webui/components"
)

// EinstellungenPage ist Screen 30: links der Kasten mit Konto-Fakten und
// der Abschnittsliste, rechts die Abschnitte. Erscheinungsbild fehlt mit
// Absicht — solange es keinen Dunkel-Zwilling gibt, wäre ein Umschalter ein
// Schalter ohne Schalttafel.
templ EinstellungenPage(vm EinstellungenVM) {
	@components.Base("einstellungen", einstellungenBody(vm))
}

templ einstellungenBody(vm EinstellungenVM) {
	@components.AppShellFlush("einstellungen", "", einstellungenOuter(vm))
}

templ einstellungenOuter(vm EinstellungenVM) {
	<div class="k3-cols grid flex-1 lg:grid-cols-[372px_minmax(0,1fr)]">
		<div class="k3-panel flex flex-col bg-panel border-b border-hairp lg:border-b-0 lg:border-r lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto scroll-thin">
			@einstellungenKasten(vm)
		</div>
		<div class="min-w-0 bg-canvas px-6 py-7 lg:px-14">
			@components.PanelToggle("nav.settings", "mb-4")
			<div class="max-w-[720px]">
				@einstellungenKonto(vm)
				@einstellungenSollzeiten(vm)
				@einstellungenSprache(vm)
				@einstellungenZugaenge(vm)
				@einstellungenDaten(vm)
			</div>
		</div>
	</div>
}

// einstellungenKasten: wer, welcher Bereich, zwei Kennzahlen, dann die
// Abschnitte als Liste mit ihrer Kurzbeschreibung.
templ einstellungenKasten(vm EinstellungenVM) {
	<div class="px-6 pt-[26px]">
		<div class="font-mono text-[12px] text-meta">{ vm.Username }</div>
		<span class="eyebrow mt-3 block">{ components.T(ctx, "einst.area") }</span>
		<h1 class="mt-1 font-display text-xl font-[750] tracking-[-.015em] text-ink">{ components.T(ctx, "nav.settings") }</h1>
		<div class="mt-3.5 grid grid-cols-2 gap-px border border-line2 bg-line2">
			<div class="bg-sheet px-3 py-3">
				<span class="block font-mono text-[18px] font-semibold tnum">{ vm.WeekSoll }</span>
				<span class="mt-0.5 block text-[10.5px] text-muted">{ components.T(ctx, "einst.weekSoll") }</span>
			</div>
			<div class="bg-sheet px-3 py-3">
				<span class="block font-mono text-[18px] font-semibold tnum">{ strconv.Itoa(vm.Engagements) }</span>
				<span class="mt-0.5 block text-[10.5px] text-muted">{ components.Tn(ctx, "einst.engagements", vm.Engagements) }</span>
			</div>
		</div>
	</div>
	<nav class="mt-6" aria-label={ components.T(ctx, "nav.settings") }>
		@einstellungenKastenRow("#konto", "einst.konto", "einst.konto.sub")
		@einstellungenKastenRow("#sollzeiten", "einst.soll", "einst.soll.sub")
		@einstellungenKastenRow("#sprache", "einst.sprache", "einst.sprache.sub")
		@einstellungenKastenRow("#zugaenge", "einst.zugaenge", "einst.zugaenge.sub")
		@einstellungenKastenRow("#daten", "einst.daten", "einst.daten.sub")
	</nav>
}

templ einstellungenKastenRow(href, labelKey, subKey string) {
	<a href={ templ.SafeURL(href) } class="block border-b border-line border-l-[3px] border-l-transparent px-6 py-[11px] pl-[21px] hover:border-l-accent hover:bg-accent-wash">
		<span class="block text-[14px] font-[650] text-ink">{ components.T(ctx, labelKey) }</span>
		<span class="block text-[11px] text-muted">{ components.T(ctx, subKey) }</span>
	</a>
}

templ einstellungenSectionKopf(id, titleKey, subKey string) {
	<div id={ id } class="mt-12 border-b border-line2 pb-2.5 first:mt-0">
		<h2 class="font-display text-[20px] font-[750] tracking-[-.015em] text-ink">{ components.T(ctx, titleKey) }</h2>
		if subKey != "" {
			<p class="mt-1 text-[12.5px] text-muted">{ components.T(ctx, subKey) }</p>
		}
	</div>
}

templ einstellungenFact(labelKey, value, aside string) {
	<div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5 text-[13px]">
		<span class="shrink-0 text-muted">{ components.T(ctx, labelKey) }</span>
		<span class="min-w-0 truncate text-right font-semibold text-ink">
			if value == "" {
				<span class="font-normal text-faint">—</span>
			} else {
				{ value }
			}
			if aside != "" {
				<span class="ml-1.5 text-[11px] font-normal text-faint">{ aside }</span>
			}
		</span>
	</div>
}

// Konto: lesbar, nicht änderbar — das Konto gehört dem Anmeldedienst.
templ einstellungenKonto(vm EinstellungenVM) {
	@einstellungenSectionKopf("konto", "einst.konto", "einst.konto.hint")
	<div class="mt-2">
		@einstellungenFact("einst.konto.displayName", vm.DisplayName, "")
		@einstellungenFact("einst.konto.username", vm.Username, "")
		@einstellungenFact("einst.konto.email", vm.Email, "")
		@einstellungenFact("einst.konto.password", components.T(ctx, "einst.konto.viaIdp"), "")
	</div>
}

templ einstellungenSollzeiten(vm EinstellungenVM) {
	@einstellungenSectionKopf("sollzeiten", "einst.soll", "einst.soll.hint")
	<div id="einstellungen-target" class="mt-4">
		@EinstellungenTargetFragment(vm)
	</div>
}

// EinstellungenTargetFragment is the Tagesziel editor. It is re-rendered
// after every POST /ui/einstellungen/target and swapped into #einstellungen-target.
templ EinstellungenTargetFragment(vm EinstellungenVM) {
	if vm.Err != "" {
		<p class="alert-err mb-4" role="alert">{ vm.Err }</p>
	}
	<form hx-post="/ui/einstellungen/target" hx-target="#einstellungen-target" hx-swap="innerHTML" class="space-y-5">
		<label class="block">
			<span class="mb-1 block text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "stats.defaultTarget") }</span>
			<input type="number" name="defaultTargetMin" value={ vm.DefaultTarget } min="0" max="1440" inputmode="numeric"
				class="field w-32 font-mono tnum"/>
		</label>
		<div>
			<p class="mb-2 text-[10.5px] font-bold uppercase tracking-[.14em] text-faint">{ components.T(ctx, "stats.weekdayOverrides") } <span class="font-normal normal-case tracking-normal text-faint">· { components.T(ctx, "stats.weekdayHint") }</span></p>
			<div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
				for _, wd := range vm.Weekdays {
					<label class="block">
						<span class="text-[11px] font-semibold text-body">{ wd.Label }</span>
						<input type="number" name={ wd.Name } value={ wd.Value } min="0" max="1440" inputmode="numeric"
							class="field mt-1 w-full font-mono tnum"/>
					</label>
				}
			</div>
		</div>
		<div class="flex items-baseline justify-between gap-4">
			<span class="text-[12.5px] text-muted">{ components.T(ctx, "einst.weekSoll") }: <b class="font-mono font-semibold tnum text-ink">{ vm.WeekSoll }</b></span>
			@components.Button(components.BtnPrimary, components.T(ctx, "common.save"), "", templ.Attributes{"type": "submit"})
		</div>
	</form>
}

// Sprache: nur die Oberfläche wechselt. Ohne Wahl entscheidet der Browser.
templ einstellungenSprache(vm EinstellungenVM) {
	@einstellungenSectionKopf("sprache", "einst.sprache", "einst.sprache.hint")
	<form method="post" action="/ui/einstellungen/sprache" hx-boost="false" class="mt-4">
		<div class="grid border-l border-t border-line2 sm:grid-cols-3">
			@einstellungenSpracheOption("de", "einst.sprache.de", "einst.sprache.de.sample", vm.Lang == "de")
			@einstellungenSpracheOption("en", "einst.sprache.en", "einst.sprache.en.sample", vm.Lang == "en")
			@einstellungenSpracheOption("", "einst.sprache.browser", "einst.sprache.browser.sample", vm.Lang == "")
		</div>
		<div class="mt-4 flex items-baseline justify-between gap-4">
			<span class="text-[11px] text-faint">{ components.T(ctx, "einst.sprache.immediate") }</span>
			@components.Button(components.BtnPrimary, components.T(ctx, "common.save"), "", templ.Attributes{"type": "submit"})
		</div>
	</form>
}

templ einstellungenSpracheOption(value, labelKey, sampleKey string, checked bool) {
	<label class="flex cursor-pointer items-baseline gap-2.5 border-b border-r border-line2 bg-surface px-3 py-2.5 has-[:checked]:bg-accent-wash">
		<input type="radio" name="lang" value={ value } checked?={ checked } class="accent-accent"/>
		<span class="min-w-0">
			<span class="block text-[13px] font-semibold text-ink">{ components.T(ctx, labelKey) }</span>
			<span class="block font-mono text-[11px] text-muted">{ components.T(ctx, sampleKey) }</span>
		</span>
	</label>
}

// Zugänge: was es gibt, wo es verwaltet wird — keine zweite Schalttafel.
templ einstellungenZugaenge(vm EinstellungenVM) {
	@einstellungenSectionKopf("zugaenge", "einst.zugaenge", "einst.zugaenge.hint")
	<div class="mt-2">
		@einstellungenFact("einst.zugaenge.ics", components.Tn(ctx, "einst.zugaenge.tokens", vm.FeedTokens), "")
		@einstellungenFact("einst.zugaenge.land", vm.Bundesland, "")
	</div>
	<p class="mt-3 text-[12.5px] text-muted">
		<a href="/dayoffs" class="font-semibold text-accent hover:underline">{ components.T(ctx, "einst.zugaenge.manage") }</a>
		· { components.T(ctx, "einst.zugaenge.agents") }
	</p>
}

templ einstellungenDaten(vm EinstellungenVM) {
	@einstellungenSectionKopf("daten", "einst.daten", "einst.daten.hint")
	<p class="mt-3 text-[13px] text-body">
		<a href="/export" class="font-semibold text-accent hover:underline">{ components.T(ctx, "einst.daten.export") }</a>
		<span class="ml-2 text-[12.5px] text-muted">{ components.T(ctx, "einst.daten.export.sub") }</span>
	</p>
	<p class="mt-2 text-[12.5px] text-muted">{ components.T(ctx, "einst.daten.cli") }</p>
}
