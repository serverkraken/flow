package webui

import "github.com/serverkraken/flow/internal/adapter/webui/components"

// NormalizeTab maps a ?tab= value onto the surfaces a register actually has.
// Anything else — an old bookmark, a typo — normalises to "" and lands on the
// register itself rather than an error page.
func NormalizeTab(raw string) string {
	switch raw {
	case "wissen", "worktime", "struktur", "kontext":
		return raw
	default:
		return ""
	}
}

// NodeTabPage renders ONE of the register's surfaces as a page of its own
// (Task 10). The sections are the same templates the flat cockpit stacked —
// what changes is that each now has a crumb, a heading and a way back, so it
// can be linked to from the register entry point instead of being a scroll
// position on a longer page.
templ NodeTabPage(d NodeCockpit, tab string) {
	@components.Base("projekte", nodeTabShell(d, tab))
}

templ nodeTabShell(d NodeCockpit, tab string) {
	@components.AppShell("projekte", nodeBreadcrumb(d), nil, nodeTabBody(d, tab))
}

templ nodeTabBody(d NodeCockpit, tab string) {
	<div class="mx-auto w-full max-w-[820px] px-6 py-7">
		// The way back belongs at the top, before anything scrollable — a
		// surface you can reach but not leave is a trap.
		<a href={ templ.SafeURL("/nodes/" + d.N.ID) }
			class="mb-4 inline-flex items-baseline gap-1.5 text-[12.5px] font-semibold text-accent hover:underline">
			<span aria-hidden="true">‹</span>
			{ components.T(ctx, "nodetab.back") } { ShortName(d.N.Name) }
		</a>
		<div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
			<h1 class="font-display text-[22px] font-bold text-ink">{ components.T(ctx, nodeTabTitleKey(tab)) }</h1>
			if tab == "worktime" {
				// Der Auslöser des Nachbuchen-Dialogs saß im Cockpit-KOPF, den
				// diese Fläche nicht rendert. Ohne ihn wäre der Dialog montiert,
				// aber unerreichbar.
				<button type="button" class="btn btn-q btn-s" data-dialog-open="session-dialog">
					{ components.T(ctx, "cockpit.worktime.add") }
				</button>
			}
		</div>
		// Die Abschnitte verdrahten ihre htmx-Ziele auf #cockpit-main — der
		// Bereichsschalter, "alle N ›" und die Buchungsbearbeitung hängen
		// daran. Ohne dieses Element liefen sie ins Leere, also spannt die
		// Fläche es genauso auf wie die frühere Seite, samt SSE-Nachladen.
		<div
			id="cockpit-main"
			class="min-w-0"
			hx-get={ cockpitMainReloadURL(d) }
			hx-trigger="sse:session.started, sse:session.stopped, sse:session.updated, sse:session.deleted, sse:document.created, sse:document.updated, sse:document.deleted, sse:node.created, sse:node.updated, sse:node.moved, sse:node.deleted, sse:activity.logged"
			hx-swap="innerHTML"
		>
			switch tab {
				case "wissen":
					@cockpitWissenSection(d)
				case "worktime":
					@cockpitBuchungenSection(d)
				case "struktur":
					@cockpitEnthaeltSection(d)
				case "kontext":
					// Das Kontext-Instrument stand nach der Umlegung ohne Weg da
					// (Soenne, 21.08.). Kette und Beiträger laufen im selben
					// Baustein mit; zusammenführen lohnt erst, wenn Screen 07
					// zeigt, was die Kuratieren-Seite selbst trägt.
					@CockpitRailBlocks(d)
			}
		</div>
		if tab == "worktime" {
			// Der Nachbuchen-Knopf öffnet diesen Dialog client-seitig. Er hing
			// bisher an der Cockpit-SEITE; auf einer eigenen Zeitfläche wäre
			// der Knopf sonst ein Schalter ohne Schalttafel.
			@components.SessionDialog(sessionDialogAddVM(d))
		}
	</div>
}

// nodeTabTitleKey names the surface in the viewer's language.
func nodeTabTitleKey(tab string) string {
	switch tab {
	case "wissen":
		return "nodetab.wissen"
	case "worktime":
		return "nodetab.worktime"
	case "struktur":
		return "nodetab.struktur"
	case "kontext":
		return "nodetab.kontext"
	default:
		return "nodetab.wissen"
	}
}
